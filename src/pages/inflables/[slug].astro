---
/**
 * Página de producto — ruta dinámica (jul 2026)
 * ──────────────────────────────────────────────
 * Reemplaza 8 archivos .astro casi idénticos (~1,900 líneas de plantilla
 * copiada). Los datos duros vienen de data/inflables.ts (catálogo canónico)
 * y el contenido editorial de data/productos.ts. Las URLs no cambian:
 * /inflables/<slug>/ se genera igual que antes.
 */
import { INFLABLES, getSpecRows, REQ_POWER, REQ_SURFACE, REQ_ADULT, PRICE_NOTE_LONG } from "@/data/inflables";
import { PRODUCTOS_PAGINAS } from "@/data/productos";
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ProductCard from "@/components/ProductCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import Gallery4x4 from "@/components/Gallery4x4.astro";
import PricingCards from "@/components/PricingCards.astro";
import CtaBar from "@/components/CtaBar.astro";
import FacetasInflables from "@/components/FacetasInflables.astro";
import { categoriasDeInflable } from "@/data/categorias";

export function getStaticPaths() {
  return Object.keys(PRODUCTOS_PAGINAS).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = PRODUCTOS_PAGINAS[slug!];
const canon = INFLABLES.find((i) => i.slug === slug)!;

/* Enlace de regreso a las categorías donde vive este modelo. Sin él las
   11 categorías serían hojas muertas: reciben enlaces pero no devuelven
   autoridad al catálogo. */
const categorias = categoriasDeInflable(canon.slug);

const ctaBarItems = [
  { label: "Cotizar ahora", href: "/contacto/", icon: "cotizar" },
  { label: "Ver galería", href: "#galeria", icon: "galeria" },
  { label: "Ver precios", href: "#precios", icon: "precios" },
  { label: "WhatsApp", href: `https://wa.me/525531281706?text=${encodeURIComponent(`Hola BRINCOLINS, me interesa rentar el ${canon.name}.`)}`, icon: "whatsapp" },
];
---

<PageLayout
  title={page.title}
  description={page.description}
  pageType="product"
  breadcrumbs={[
    { name: "Inicio", href: "/" },
    { name: "Inflables", href: "/inflables/" },
    { name: canon.name },
  ]}
  faqItems={page.faqItems}
  product={{
    name: canon.name,
    slug: canon.slug,
    description: page.description,
    image: canon.image,
    price: canon.priceNumber,
  }}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Inflables",href:"/inflables/"},{label:canon.name}]} />
  </Fragment>

  <!-- HERO 2 columnas -->
  <section class="hero" style="padding:clamp(3rem,6vw,5rem) 0;">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="hero__badge">{page.badge}</span>
          <h1 class="hero__title">Renta <span class="highlight">{canon.name}</span> para tu Fiesta</h1>
          <div class="hero__specs">
            <span class="hero__spec">Tamaño: {canon.size}</span>
            <span class="hero__spec">Edad: {canon.ages}</span>
            <span class="hero__spec">Capacidad: {canon.capacity}</span>
            <span class="hero__spec">Desde {canon.price} MXN</span>
          </div>
          <div class="hero__ctas">
            <a href="/cotizar/" class="btn btn-primary btn-lg">{page.cta}</a>
            <a href="/inflables/" class="btn btn-outline btn-lg">Ver Catálogo de Inflables</a>
          </div>
        </div>
        <div class="hero__img-col">
          <div class="hero__img-wrap">
            <img src={canon.image} alt={`Inflable ${canon.name} — renta BRINCOLINS CDMX`} class="hero__img" width="600" height="450" loading="eager" />
            <div class="hero__img-pill hero__img-pill--top">Desde {canon.price} MXN</div>
            <div class="hero__img-pill hero__img-pill--bottom">⚡ Instalación en {canon.installTime}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <QuickNav />

  <CtaBar items={ctaBarItems} />

  <!-- Gallery -->
  <section class="section" id="galeria">
    <div class="container">
      <SectionHeader badge="Galería" title={`Galería del ${canon.name} en fiestas reales`} subtitle={`El ${canon.name} instalado y en uso`} copy1={page.galeria.copy1} copy2={page.galeria.copy2} />
      <Gallery4x4 images={page.galleryImages} />
    </div>
  </section>

  <!-- Especificaciones y requisitos -->
  <section class="section" id="especificaciones">
    <div class="container">
      <SectionHeader
        badge="Especificaciones"
        title={`¿Cabe el ${canon.name} en tu espacio?`}
        subtitle="Medidas exactas, área libre necesaria y qué hace falta en el domicilio."
        copy1={`El ${canon.name} mide ${canon.size} y necesita un área libre de ${canon.spaceRequired} con ${canon.heightClearance} de altura despejada. Ese margen no es capricho: incluye el espacio de anclaje y la zona de seguridad alrededor del inflable, donde no puede haber muros, ramas ni cables.`}
        copy2={canon.indoor
          ? `Con ${canon.heightClearance} de altura libre, es uno de los dos modelos que caben bajo techo: funciona en salones, terrazas cubiertas y departamentos con techo estándar.`
          : `Por su altura necesita instalarse al aire libre o en un salón con techo alto. Si tu evento es bajo techo, el Mini Castillo y los Gusanitos son los modelos que sí caben.`}
      />

      <div class="spec-layout">
        <table class="spec-table">
          <caption class="sr-only">Especificaciones del {canon.name}</caption>
          <tbody>
            {getSpecRows(canon).map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.value}</td>
              </tr>
            ))}
            <tr>
              <th scope="row">Precio</th>
              <td>Desde {canon.price} MXN por evento</td>
            </tr>
          </tbody>
        </table>

        <div class="spec-req">
          <h3 class="spec-req__title">Qué necesitas tener listo</h3>
          <ul class="spec-req__list">
            <li>{REQ_SURFACE}</li>
            <li>{REQ_POWER}</li>
            <li>{REQ_ADULT}</li>
            <li>Acceso para el vehículo de entrega. Si es condominio o salón, avísanos para gestionar el permiso.</li>
          </ul>
          <p class="spec-req__note">
            {PRICE_NOTE_LONG} ¿No estás seguro de que quepa? Mándanos una foto del
            espacio por <a href={ctaBarItems[3].href} target="_blank" rel="nofollow noopener noreferrer">WhatsApp</a>
            y te lo confirmamos antes de que apartes la fecha.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section section--alt" id="precios">
    <div class="container">
      <SectionHeader badge="Paquetes" title={`¿Cuánto cuesta rentar el ${canon.name} en CDMX?`} subtitle="Todos incluyen entrega e instalación en CDMX y Edomex" copy1={page.precios.copy1} copy2={page.precios.copy2} />
      <PricingCards packages={page.pricingPackages} />
    </div>
  </section>

  <!-- Related -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader badge="Más inflables" title="Otros inflables que te pueden interesar" subtitle="Todos con entrega, instalación y recolección incluidas" copy1={page.relacionados.copy1} copy2={page.relacionados.copy2} />
      <div class="grid-4">
        {page.cards.map((c) => (
          <ProductCard slug={c.slug} emoji="" name={c.name} description={c.description} price={c.price} size={c.size} ages={c.ages} category={c.category} categoryColor={c.categoryColor} gradient={c.gradient} image={c.image} />
        ))}
      </div>
    </div>
  </section>

  <!-- También en — enlaces de regreso a las categorías -->
  <section class="section">
    <div class="container">
      {categorias.length > 0 && (
        <p class="tambien-en">
          <strong>{canon.name} también aparece en:</strong>{" "}
          {categorias.map((c, i) => (
            <>
              {i > 0 && " · "}
              <a href={`/inflables/${c.slug}/`}>{c.anchor}</a>
            </>
          ))}
        </p>
      )}
      <FacetasInflables />
    </div>
  </section>

  <CtaBanner
    title={`¿Te interesa el ${canon.name}?`}
    subtitle="Reserva ahora y asegura tu fecha. Respondemos en minutos."
    btnText={page.cta}
    btnHref="/cotizar/"
    variant="vibrant"
  />

</PageLayout>

<style>
  .tambien-en {
    margin: 0 0 1.5rem;
    font-size: .95rem;
    line-height: 1.7;
    color: var(--text-muted, #5a5a66);
  }
  .tambien-en a { font-weight: 600; }
</style>
