---
/**
 * Página de producto — ruta dinámica (jul 2026)
 * ──────────────────────────────────────────────
 * Reemplaza 8 archivos .astro casi idénticos (~1,900 líneas de plantilla
 * copiada). Los datos duros vienen de data/inflables.ts (catálogo canónico)
 * y el contenido editorial de data/productos.ts. Las URLs no cambian:
 * /inflables/<slug>/ se genera igual que antes.
 */
import { INFLABLES, getSpecRows, REQ_POWER, REQ_SURFACE, REQ_ADULT, PRICE_NOTE_LONG } from "@/data/inflables";
import { PRODUCTOS_PAGINAS } from "@/data/productos";
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ProductCard from "@/components/ProductCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import GaleriaProducto from "@/components/GaleriaProducto.astro";
import PricingCards from "@/components/PricingCards.astro";
import CtaBar from "@/components/CtaBar.astro";
import FacetasInflables from "@/components/FacetasInflables.astro";
import SidebarEnlaces from "@/components/SidebarEnlaces.astro";
import { anchorInflable, A } from "@/data/anchors";
import { grupoServicios, grupoReservar } from "@/data/sidebar";
import { categoriasDeInflable } from "@/data/categorias";
import { getCoverageZone } from "@/data/coverage";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return Object.keys(PRODUCTOS_PAGINAS).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = PRODUCTOS_PAGINAS[slug!];
const canon = INFLABLES.find((i) => i.slug === slug)!;

/* Enlace de regreso a las categorías donde vive este modelo. Sin él las
   11 categorías serían hojas muertas: reciben enlaces pero no devuelven
   autoridad al catálogo. */
const categorias = categoriasDeInflable(canon.slug);

/* Guías del modelo (oct 2026): los artículos del blog cuya `category` es
   el nombre del modelo. Cierra el circuito ficha ↔ artículos — los
   artículos enlazan a la ficha y la ficha devuelve el enlace a cada uno. */
const detalle = page.detalle;

/* Artículo según el género del nombre: "la Jungla", "el Extremo". */
const FEMENINOS = new Set(["Jungla"]);
const elDe  = (n: string) => (FEMENINOS.has(n) ? `la ${n}` : `el ${n}`);
const delDe = (n: string) => (FEMENINOS.has(n) ? `de la ${n}` : `del ${n}`);
const elN = elDe(canon.name);
const delN = delDe(canon.name);

/* Guías elegidas a mano para la ficha (nov 2026). Van primero y con nota;
   las automáticas por categoría se listan después sin repetir destino. */
const blog = (await getCollection("blog")).filter((p) => !p.data.draft);
const guiasCuradas = (detalle?.guias ?? [])
  .map((g) => ({ ...g, post: blog.find((p) => p.id === g.slug) }))
  .filter((g) => g.post);
const curadasIds = new Set(guiasCuradas.map((g) => g.slug));

/* Zonas: el costo de envío se lee de coverage.ts, nunca se escribe aquí. */
const zonas = (detalle?.zonas ?? [])
  .map((z) => ({ ...z, zona: getCoverageZone(z.slug) }))
  .filter((z) => z.zona);

const guias = blog
  .filter((p) => p.data.category === canon.name && !curadasIds.has(p.id))
  .sort((a, b) => {
    const aEsPilar = a.id.endsWith("guia-completa") || a.id.endsWith("-guia");
    const bEsPilar = b.id.endsWith("guia-completa") || b.id.endsWith("-guia");

    if (aEsPilar !== bEsPilar) return aEsPilar ? -1 : 1;

    return a.data.title.localeCompare(b.data.title, "es");
  });

const ctaBarItems = [
  { label: "Cotizar ahora", href: "/contacto/", icon: "cotizar" },
  { label: "Ver galería", href: "#galeria", icon: "galeria" },
  { label: "Ver precios", href: "#precios", icon: "precios" },
  { label: "WhatsApp", href: `https://wa.me/525531281706?text=${encodeURIComponent(`Hola BRINCOLINS, me interesa rentar ${elN}.`)}`, icon: "whatsapp" },
];

/* Medidas sueltas para las cifras de "Medidas y espacio": "6×3.5×3.80m" → [6, 3.5, 3.80]. */
const [largo, ancho, alto] = canon.size.replace(/m$/, "").split("×");
const alturaConCifra = /^\d/.test(canon.heightClearance);
const medidas = [
  { valor: largo, label: "de largo" },
  { valor: ancho, label: "de ancho" },
  { valor: alto, label: "de alto" },
  /* La altura libre solo va como cifra si la ficha la publica; si dice "Se confirma al cotizar", se omite aquí. */
  ...(alturaConCifra ? [{ valor: canon.heightClearance.replace(/\s*m$/, ""), label: "altura libre" }] : []),
];
const IDEA_TONOS = ["durazno", "cielo", "menta", "lila", "mango"];

/* Cómo apartar: mismas condiciones que publica el resto del sitio. */
const pasosReserva = [
  { titulo: "Cotiza", texto: "Mándanos fecha, colonia y medidas del espacio por WhatsApp o el formulario." },
  { titulo: "Aparta con 50 %", texto: "El resto se paga el día del evento." },
  { titulo: "Instalamos", texto: `Llegamos antes de tu hora; el montaje toma ${canon.installTime}.` },
  { titulo: "Recogemos", texto: "Al terminar las 4 a 6 horas lo desinflamos y nos lo llevamos." },
];

/* Sidebar de enlaces (nov 2026): reparte autoridad de la ficha hacia el
   resto del catálogo, categorías, guías, zonas y servicios. */
const sidebarGrupos = [
  {
    titulo: "Otros inflables",
    enlaces: INFLABLES.filter((i) => i.active && i.slug !== canon.slug)
      .map((i) => ({ href: `/inflables/${i.slug}/`, label: anchorInflable(i.slug).short, meta: i.price })),
    todos: { href: "/inflables/", label: A.catalogo.short },
  },
  {
    titulo: `Categorías con ${elN}`,
    enlaces: categorias.map((c) => ({ href: `/inflables/${c.slug}/`, label: c.anchor })),
  },
  {
    titulo: "Guías para tu fiesta",
    enlaces: [
      ...guiasCuradas.map((g) => ({ href: `/blog/${g.slug}/`, label: g.anchor })),
      ...guias.map((g) => ({ href: `/blog/${g.id}/`, label: g.data.h1 || g.data.title })),
    ].slice(0, 6),
    todos: { href: "/blog/", label: A.blog.short },
  },
  {
    titulo: "Zonas de entrega",
    enlaces: zonas.map((z) => ({ href: `/cobertura/${z.slug}/`, label: z.anchor, meta: z.zona!.shippingFee })),
    todos: { href: "/cobertura/", label: A.zonas.short },
  },
  grupoServicios(),
  grupoReservar(),
];

const sidebarIndice = [
  { href: "#galeria", label: "Galería" },
  { href: "#especificaciones", label: "Medidas y requisitos" },
  ...(detalle ? [{ href: "#para-quien", label: "Para quién es" }] : []),
  { href: "#precios", label: "Precios" },
  ...(detalle ? [{ href: "#instalacion", label: "Qué incluye e instalación" }] : []),
  ...(guiasCuradas.length || guias.length ? [{ href: "#guias", label: "Guías" }] : []),
  { href: "#relacionados", label: "Otros inflables" },
];
---

<PageLayout
  title={page.title}
  description={page.description}
  pageType="product"
  breadcrumbs={[
    { name: "Inicio", href: "/" },
    { name: "Inflables", href: "/inflables/" },
    { name: canon.name },
  ]}
  faqItems={page.faqItems}
  product={{
    name: canon.name,
    slug: canon.slug,
    description: page.description,
    image: canon.image,
    price: canon.priceNumber,
  }}
  faqContext={{ tipo: "producto", slug: canon.slug }}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Inflables",href:"/inflables/"},{label:canon.name}]} />
  </Fragment>

  <!-- HERO 2 columnas -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="hero__badge">{page.badge}</span>
          <h1 class="hero__title">
            {detalle ? detalle.h1.antes : "Renta del"} <span class="highlight">{canon.name}</span> {detalle ? detalle.h1.despues : "para tu fiesta"}
          </h1>
          {detalle && <p class="hero__desc">{detalle.resumen}</p>}
          <div class="hero__specs">
            <span class="hero__spec">Medidas: {canon.size}</span>
            <span class="hero__spec">Edad: {canon.ages}</span>
            <span class="hero__spec">{canon.indoor ? "Apto bajo techo" : "Para exterior"}</span>
            <span class="hero__spec">{canon.price} MXN, 4 a 6 horas</span>
          </div>
          <div class="hero__ctas">
            <a href="/cotizar/" class="btn btn-primary btn-lg">{page.cta}</a>
            <a href={ctaBarItems[3].href} class="btn btn-outline btn-lg" target="_blank" rel="nofollow noopener noreferrer">Apartar por WhatsApp</a>
          </div>
          {/* Enlace contextual hacia arriba: catálogo, precios y cercanía. */}
          <p class="hero__uplink">
            Modelo del <a href="/inflables/">catálogo de renta de inflables</a> ·
            servicio de <a href="/">renta de inflables en CDMX</a> ·
            <a href="/precios/">precios de renta de inflables</a> ·
            <a href="/renta-de-inflables-cerca-de-mi/">entrega cerca de ti</a>
          </p>
        </div>
        <div class="hero__img-col">
          <div class="hero__img-wrap">
            <img src={canon.image} alt={`Inflable ${canon.name} en renta para fiestas en CDMX y Edomex`} class="hero__img" width="600" height="450" loading="eager" fetchpriority="high" />
            <div class="hero__img-pill hero__img-pill--top">Desde {canon.price} MXN</div>
            <div class="hero__img-pill hero__img-pill--bottom">⚡ Instalación en {canon.installTime}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <QuickNav />

  <CtaBar items={ctaBarItems} />

  <div class="container con-sidebar">
  <div class="con-sidebar__main">

  <!-- Gallery -->
  <section class="section" id="galeria">
    <div class="container">
      <SectionHeader badge="Galería" title={`Galería ${delN}`} subtitle={`Así luce ${elN} armado, desde todos los ángulos`} copy1={page.galeria.copy1} copy2={page.galeria.copy2} />
      <GaleriaProducto images={page.galleryImages} />
    </div>
  </section>

  <!-- Especificaciones y requisitos -->
  <section class="section" id="especificaciones">
    <div class="container">
      <SectionHeader
        badge="Especificaciones"
        title={`¿Cabe ${elN} en tu espacio?`}
        subtitle="Medidas exactas, área libre necesaria y qué hace falta en el domicilio."
        copy1={`${elN.charAt(0).toUpperCase() + elN.slice(1)} mide ${canon.size}${alturaConCifra ? ` y necesita ${canon.heightClearance} de altura despejada` : "; la altura despejada que pide se confirma al cotizar según el lugar"}. ${/cotizar/i.test(canon.spaceRequired) ? "El área libre exacta se confirma al cotizar" : `Pide un área libre de ${canon.spaceRequired}`}: incluye el espacio de anclaje y la zona de seguridad alrededor del inflable, donde no puede haber muros, ramas ni cables.`}
        copy2={canon.indoor
          ? (alturaConCifra
            ? `Con ${canon.heightClearance} de altura libre, es uno de los dos modelos aptos para bajo techo: funciona en salones, terrazas cubiertas y departamentos cuyo techo alcance esa altura.`
            : `Es uno de los dos modelos aptos para bajo techo. La instalación en interiores se confirma al cotizar según la altura y las condiciones del lugar: mándanos la altura del techo, medida al punto más bajo.`)
          : `Por su altura necesita instalarse al aire libre o en un salón con techo alto. Si tu evento es bajo techo, compara la altura del techo con la altura del modelo y confirma el espacio de instalación al cotizar.`}
      />

      <div class="spec-layout">
        <table class="spec-table">
          <caption class="sr-only">Especificaciones {delN}</caption>
          <tbody>
            {getSpecRows(canon).map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.value}</td>
              </tr>
            ))}
            <tr>
              <th scope="row">Precio</th>
              <td>Desde {canon.price} MXN por evento</td>
            </tr>
          </tbody>
        </table>

        <div class="spec-req">
          <h3 class="spec-req__title">Qué necesitas tener listo</h3>
          <ul class="spec-req__list">
            <li>{REQ_SURFACE}</li>
            <li>{REQ_POWER}</li>
            <li>{REQ_ADULT}</li>
            <li>Acceso para el vehículo de entrega. Si es condominio o salón, avísanos para gestionar el permiso.</li>
          </ul>
          <p class="spec-req__note">
            {PRICE_NOTE_LONG} ¿No estás seguro de que quepa? Mándanos una foto del
            espacio por <a href={ctaBarItems[3].href} target="_blank" rel="nofollow noopener noreferrer">WhatsApp</a>
            y te lo confirmamos antes de que apartes la fecha.
          </p>
        </div>
      </div>
    </div>
  </section>

  {detalle && (
    <section class="section" id="para-quien">
      <div class="container">
        <div class="pq">
          <article class="pq__card">
            <span class="pq__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6.5 6.5-6.5s6.5 2.9 6.5 6.5"/><circle cx="17.5" cy="8.5" r="2.5"/><path d="M16 13.7c3.1-.4 5.5 1.8 5.5 5"/></svg>
            </span>
            <h2 class="pq__title">¿Para quién es {elN}?</h2>
            <ul class="pq__chips" role="list">
              <li>{canon.ages}</li>
              <li>{canon.indoor ? "Apto bajo techo" : "Para exterior"}</li>
              <li>Montaje en {canon.installTime}</li>
            </ul>
            <p>{detalle.paraQuien}</p>
          </article>

          <article class="pq__card">
            <span class="pq__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17 17 3l4 4L7 21z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/></svg>
            </span>
            <h2 class="pq__title">Medidas y espacio necesario</h2>
            <dl class="pq__dims">
              {medidas.map((m) => (
                <div>
                  <dt>{m.label}</dt>
                  <dd>{m.valor}<span> m</span></dd>
                </div>
              ))}
            </dl>
            <p>{detalle.espacio}</p>
          </article>
        </div>

        <h3 class="ideas__title">Ideas de temática y uso con {elN}</h3>
        <ol class="ideas" role="list">
          {detalle.ideas.map((i, n) => (
            <li class={`ideas__item ideas__item--${IDEA_TONOS[n % IDEA_TONOS.length]}`}>
              <span class="ideas__num" aria-hidden="true">{String(n + 1).padStart(2, "0")}</span>
              <strong>{i.titulo}</strong>
              <p>{i.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- Pricing -->
  <section class="section section--alt" id="precios">
    <div class="container">
      <SectionHeader badge="Paquetes" title={`¿Cuánto cuesta rentar ${elN} en CDMX?`} subtitle="Instalación incluida; traslado según zona" copy1={page.precios.copy1} copy2={page.precios.copy2} />
      <div class="precio">
        <PricingCards packages={page.pricingPackages} />
        <div class="reserva">
          <h3 class="reserva__title">Cómo apartar tu fecha</h3>
          <ol class="reserva__pasos" role="list">
            {pasosReserva.map((r, n) => (
              <li>
                <span class="reserva__n" aria-hidden="true">{n + 1}</span>
                <div><strong>{r.titulo}</strong><p>{r.texto}</p></div>
              </li>
            ))}
          </ol>
          <a href={ctaBarItems[3].href} class="reserva__wa" target="_blank" rel="nofollow noopener noreferrer">Preguntar disponibilidad por WhatsApp →</a>
        </div>
      </div>
    </div>
  </section>

  {detalle && (
    <section class="section" id="instalacion">
      <div class="container">
        <div class="pq">
          <article class="pq__card">
            <span class="pq__icon pq__icon--menta" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <h2 class="pq__title">¿Qué incluye la renta {delN}?</h2>
            <p>{detalle.incluye}</p>
          </article>
          <article class="pq__card">
            <span class="pq__icon pq__icon--cielo" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            </span>
            <h2 class="pq__title">¿Cómo se instala?</h2>
            <p>{detalle.instalacion}</p>
          </article>
        </div>

        <aside class="vs">
          <div>
            <span class="vs__badge">Comparativa</span>
            <h3 class="vs__title">¿{canon.name} o {detalle.comparacion.nombre}?</h3>
            <p>{detalle.comparacion.texto}</p>
          </div>
          <a class="btn btn-outline vs__btn" href={`/inflables/${detalle.comparacion.slug}/`}>Ver la renta {delDe(detalle.comparacion.nombre)} →</a>
        </aside>

        {zonas.length > 0 && (
          <>
            <h3 class="ideas__title">Entrega {delN} por zona</h3>
            <ul class="zn" role="list">
              {zonas.map((z) => (
                <li>
                  <a href={`/cobertura/${z.slug}/`}>{z.anchor.charAt(0).toUpperCase() + z.anchor.slice(1)}</a>
                  <p>{z.nota}</p>
                  <span class="zn__fee">Envío: {z.zona!.shippingFee ?? "se confirma al cotizar"}</span>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )}

  <!-- Guías del modelo -->
  {(guiasCuradas.length > 0 || guias.length > 0) && (
    <section class="section" id="guias">
      <div class="container">
        <h2 class="guias__title">¿Cómo aprovechar {elN} en tu fiesta?</h2>
        <p class="guias__lead">Ideas, comparativas y logística escritas a partir de las medidas y edades reales {delN}.</p>
        <ul class="guias__list">
          {guiasCuradas.map((g) => (
            <li>
              <a href={`/blog/${g.slug}/`}>{g.anchor}</a>
              <span>{g.nota}</span>
            </li>
          ))}
          {guias.map((g) => (
            <li>
              <a href={`/blog/${g.id}/`}>{g.data.h1 || g.data.title}</a>
              {g.data.excerpt && <span>{g.data.excerpt}</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Related -->
  <section class="section section--alt" id="relacionados">
    <div class="container">
      <SectionHeader badge="Más inflables" title="Otros inflables que te pueden interesar" subtitle="Instalación y recolección incluidas; traslado según zona" copy1={page.relacionados.copy1} copy2={page.relacionados.copy2} />
      <div class="grid-4">
        {page.cards.map((c) => (
          <ProductCard slug={c.slug} name={c.name} description={c.description} price={c.price} size={c.size} ages={c.ages} category={c.category} categoryColor={c.categoryColor} image={c.image} />
        ))}
      </div>
    </div>
  </section>

  <!-- También en — enlaces de regreso a las categorías -->
  <section class="section">
    <div class="container">
      {categorias.length > 0 && (
        <p class="tambien-en">
          <strong>{canon.name} también aparece en:</strong>{" "}
          {categorias.map((c, i) => (
            <>
              {i > 0 && " · "}
              <a href={`/inflables/${c.slug}/`}>{c.anchor}</a>
            </>
          ))}
        </p>
      )}
      <FacetasInflables />
    </div>
  </section>

  </div>
  <SidebarEnlaces
    grupos={sidebarGrupos}
    indice={sidebarIndice}
    cta={{
      titulo: `${canon.name} desde ${canon.price}`,
      texto: "4 a 6 horas con instalación y recolección. Traslado según zona.",
      href: "/cotizar/",
      label: page.cta,
      waHref: ctaBarItems[3].href,
    }}
  />
  </div>

  <CtaBanner
    title={`¿Te interesa ${elN}?`}
    subtitle="Reserva ahora y asegura tu fecha. Respondemos en minutos."
    btnText={page.cta}
    btnHref="/cotizar/"
    variant="vibrant"
  />

</PageLayout>

<style>
  .hero__uplink {
    margin: 1rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--c-ink-60);
  }
  .hero__uplink a {
    color: var(--c-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .hero__uplink a:hover { color: var(--c-primary-text); }

  .tambien-en {
    margin: 0 0 1.5rem;
    font-size: .95rem;
    line-height: 1.7;
    color: var(--c-ink-60);
  }
  .tambien-en strong { color: var(--c-ink); }
  .tambien-en a { color: var(--c-primary-text); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

  /* ── Para quién / Medidas / Qué incluye: tarjetas (nov 2026) ── */
  .pq {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
  }
  .pq__card {
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    background: #fff;
    color: var(--c-ink);
  }
  .pq__card p { margin: 0; line-height: 1.7; color: var(--c-ink-60); }
  .pq__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 1rem;
    border-radius: 14px;
    background: var(--c-durazno);
    color: var(--c-primary-text);
  }
