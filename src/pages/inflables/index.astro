---
/**
 * /inflables/ — HUB del catálogo
 * ──────────────────────────────────────────────────────────────
 * Reescrito (ago 2026). Antes: 8 bloques ProductFeature en una sola
 * página, ~217 enlaces salientes y ningún eje de navegación. Google
 * la leía como una lista plana y la home canibalizaba todas las
 * keywords específicas.
 *
 * Ahora: hub de 11 categorías con 3 modelos destacados cada una.
 * El detalle de cada modelo vive en su ficha; el detalle de cada
 * segmento, en su categoría. Esta página sólo reparte autoridad.
 */
import PageLayout   from "@/layouts/PageLayout.astro";
import QuickNav     from "@/components/QuickNav.astro";
import Breadcrumbs  from "@/components/Breadcrumbs.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FacetasInflables from "@/components/FacetasInflables.astro";
import TablaComparativa from "@/components/TablaComparativa.astro";
import CtaBanner    from "@/components/CtaBanner.astro";
import { CATEGORIAS, inflablesDeCategoria } from "@/data/categorias";
import { INFLABLES_ACTIVOS, PRICE_RANGE, MODELOS_COUNT, PRICE_NOTE_LONG } from "@/data/inflables";
import { SITE_URL } from "@/data/site";

const title = `Catálogo de Inflables en Renta CDMX y Edomex | ${MODELOS_COUNT} Modelos`;
const description = `Explora nuestro catálogo de inflables en renta: por tamaño, por tipo y por edad. ${MODELOS_COUNT} modelos desde $800 con entrega e instalación incluidas.`;

/* Tarjeta de categoría: nombre, 3 modelos destacados y anchor con la
   keyword objetivo. 11 categorías × (1 anchor + 3 modelos) ≈ 44 enlaces,
   frente a los ~217 de la versión anterior. */
const tarjetas = CATEGORIAS.map((c) => {
  const items = inflablesDeCategoria(c);
  const desde = items.length
    ? items.reduce((m, i) => (i.priceNumber < m.priceNumber ? i : m)).price
    : "";
  return { cat: c, destacados: items.slice(0, 3), total: items.length, desde, image: c.image };
});

const faqs = [
  { question: "¿Cómo elijo el inflable correcto en el catálogo?", answer: "En tres pasos y en este orden: mide el espacio libre disponible, define la edad de la mayoría de los invitados y calcula cuántos niños brincarán al mismo tiempo. El espacio descarta modelos de inmediato, la edad reduce a dos o tres opciones y la capacidad decide entre ellas. Después ya puedes elegir por temática." },
  { question: "¿Cuántos modelos de inflables tienen disponibles?", answer: "Ocho modelos propios: Mini Castillo, Dragones Rojos, Castillo de Princesas, Mini Jungla, Gusanitos, Castillo Blanco, Barco Pirata y Circuito Extremo. Los organizamos en 11 categorías —por tamaño, por tipo y por público— porque cada modelo sirve para varios tipos de evento." },
  { question: "¿Cuál es el inflable más económico del catálogo?", answer: "El Mini Castillo, desde $800 MXN por evento. Está diseñado para niños de 1 a 4 años, mide 2×2×2.5 metros y es uno de los dos modelos aptos para interiores. Los medianos arrancan en $1,200." },
  { question: "¿Cuál es el inflable más rentado?", answer: "Dragones Rojos. Comparte base de 4×4 metros con el Castillo de Princesas y funciona con público mixto de 4 a 10 años, que es el rango de la mayoría de los cumpleaños infantiles en CDMX." },
  { question: "¿Qué inflables caben bajo techo?", answer: "Sólo dos: el Mini Castillo y Gusanitos, ambos con 3.2 metros de altura libre requerida. El resto del catálogo supera los 4 metros y es exclusivamente de exterior. En la categoría de inflables para interiores explicamos altura, acceso y anclaje." },
  { question: "¿Puedo rentar más de un inflable para el mismo evento?", answer: "Sí, y es lo habitual en kermeses escolares, eventos de empresa y ferias. A partir de tres inflables incluimos coordinador de logística sin costo adicional. Hay que verificar el área libre sumada y que existan tomas de corriente independientes." },
  { question: "¿Todos los inflables incluyen entrega e instalación?", answer: "Sí: entrega a domicilio, instalación profesional, motor inflador, sanitización certificada y recolección al finalizar, en los ocho modelos. El precio publicado es neto; si necesitas factura se agrega el 16% de IVA, y en municipios distantes del Estado de México aplica un cargo de envío que te indicamos al cotizar." },
  { question: "¿Cómo aparto una fecha del catálogo?", answer: "Escríbenos por WhatsApp con el modelo, la fecha y la zona de entrega. Confirmamos disponibilidad en minutos. Para apartar se requiere un anticipo del 50% y el saldo se liquida el día del evento, antes de la instalación." },
];

/* El hub declara una colección DE COLECCIONES: las 11 categorías.
   El detalle de productos vive en el ItemList de cada categoría. */
const hubSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/inflables/#catalogo`,
  name: "Catálogo de inflables y brincolines para renta en CDMX y Edomex",
  description: `Los ${MODELOS_COUNT} modelos de inflables disponibles para renta, de ${PRICE_RANGE} MXN por evento, organizados en ${CATEGORIAS.length} categorías.`,
  url: `${SITE_URL}/inflables/`,
  isPartOf: { "@id": `${SITE_URL}/#website` },
  about:    { "@id": `${SITE_URL}/#org` },
  mainEntity: {
    "@type": "ItemList",
    name: "Categorías de inflables en renta",
    numberOfItems: CATEGORIAS.length,
    itemListElement: CATEGORIAS.map((c, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      name: c.name,
      url: `${SITE_URL}/inflables/${c.slug}/`,
    })),
  },
};
---

<PageLayout
  title={title}
  description={description}
  pageType="category"
  faqItems={faqs}
  schemaMarkup={JSON.stringify(hubSchema)}
  breadcrumbs={[
    { name: "Inicio", href: "/" },
    { name: "Inflables" },
  ]}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Inflables" }]} />
  </Fragment>

  <section class="hero" style="padding:clamp(3rem,6vw,4.5rem) 0 clamp(2rem,4vw,3rem);">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="hero__badge">Catálogo completo</span>
          <h1 class="hero__title">
            Catálogo de <span class="highlight">Inflables</span> para Renta en CDMX y Estado de México
          </h1>
          <p class="hero__desc">{MODELOS_COUNT} modelos organizados en {CATEGORIAS.length} categorías: por tamaño, por tipo de inflable y por quién lo va a usar. De {PRICE_RANGE} MXN por evento.</p>
          <div class="hero__ctas">
            <a href="/cotizar/" class="btn btn-primary btn-lg">Cotizar renta de inflables</a>
            <a href="/precios/" class="btn btn-outline btn-lg">Ver precios de inflables</a>
          </div>
        </div>
        <div class="hero__copy">
          <p class="hero__copy-text">
            Entra por la categoría que corresponde a tu evento en lugar de recorrer el catálogo completo: <a href="/inflables/para-ninos/">inflables para niños</a> si buscas por edad, <a href="/inflables/grandes/">inflables grandes</a> o <a href="/inflables/chicos/">inflables pequeños</a> si el problema es el espacio, y <a href="/inflables/para-interiores/">inflables para interiores</a> si la fiesta es bajo techo.
          </p>
          <p class="hero__copy-text">
            Todos los modelos incluyen entrega, instalación profesional, motor inflador, sanitización certificada y recolección en CDMX y Estado de México. {PRICE_NOTE_LONG}
          </p>
        </div>
      </div>
    </div>
  </section>

  <QuickNav />

  <!-- ── 11 CATEGORÍAS ── -->
  <section class="section" style="padding-top:1.5rem;">
    <div class="container">
      <SectionHeader
        badge="Categorías"
        title="Elige por tamaño, por tipo o por público"
        subtitle="Cada categoría lista sólo los modelos que aplican, con su tabla comparativa y sus preguntas propias."
        copy1="Un mismo inflable sirve para varios tipos de evento, así que cada modelo aparece en tres o cuatro categorías: el Castillo Blanco es a la vez un castillo, un inflable grande y un modelo para adultos. Entrar por la categoría correcta te ahorra comparar ocho fichas para descubrir que sólo dos caben en tu espacio."
        copy2="Las categorías por tamaño resuelven el problema más frecuente, que es el espacio disponible. Las de tipo sirven cuando ya sabes qué formato buscas —castillo, tobogán, circuito de obstáculos—. Las de público y entorno son para cuando lo que manda es quién lo va a usar o dónde se va a instalar."
      />

      <div class="cat-grid">
        {tarjetas.map(({ cat, destacados, total, desde, image }) => (
          <article class={`cat-card cat-card--${cat.color}`}>
            <a class="cat-card__media" href={`/inflables/${cat.slug}/`} tabindex="-1" aria-hidden="true">
              <img src={image} alt="" loading="lazy" width="720" height="480" />
              <span class="cat-card__badge">{cat.badge}</span>
            </a>
            <div class="cat-card__body">
              <h3 class="cat-card__title">
                <a href={`/inflables/${cat.slug}/`}>{cat.name}</a>
              </h3>
              <p class="cat-card__meta">{total} {total === 1 ? "modelo" : "modelos"}{desde ? ` · desde ${desde}` : ""}</p>
              <p class="cat-card__desc">{cat.intro[0]}</p>
              <ul class="cat-card__list">
                {destacados.map((inf) => (
                  <li><a href={`/inflables/${inf.slug}/`}>{inf.name}</a> <span>{inf.price}</span></li>
                ))}
              </ul>
              <a class="cat-card__cta" href={`/inflables/${cat.slug}/`}>Ver {cat.anchor}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── COMPARATIVA GLOBAL ── -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Comparativa"
        title={`Los ${MODELOS_COUNT} modelos, lado a lado`}
        subtitle="Precio, medidas, espacio libre necesario, altura, edades y capacidad."
        copy1="Esta tabla resuelve de una sola pasada la pregunta que más nos hacen por WhatsApp: cuál cabe en mi espacio. La columna de espacio libre ya incluye el metro de margen por lado que exigimos para anclar con seguridad, así que es la medida real que necesitas tener despejada, no las dimensiones del inflable."
        copy2="La columna de altura libre es la que decide si un modelo entra bajo techo. Se mide del piso al punto más bajo del techo, descontando lámparas, ventiladores y trabes. Sólo dos modelos del catálogo trabajan con 3.2 metros; el resto necesita más de 4."
      />
      <TablaComparativa inflables={INFLABLES_ACTIVOS} caption={`Catálogo completo de inflables en renta — ${MODELOS_COUNT} modelos`} />
    </div>
  </section>

  <!-- ── FACETAS (silo) ── -->
  <section class="section">
    <div class="container">
      <FacetasInflables
        titulo="Todas las categorías de inflables"
        subtitulo="Los tres ejes por los que puedes recorrer el catálogo."
      />
    </div>
  </section>

  <CtaBanner
    title="¿No sabes cuál elegir?"
    subtitle="Mándanos las medidas de tu espacio y la edad de los invitados. Te decimos cuál cabe y cuál conviene, sin compromiso."
    btnText="Cotizar renta de inflables"
    btnHref="/cotizar/"
    btnSecondaryText="Ver zonas de entrega"
    btnSecondaryHref="/cobertura/"
    variant="warm"
  />
</PageLayout>

<style>
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .cat-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border, #e2e2e6);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface, #fff);
    transition: box-shadow .18s ease, transform .18s ease;
  }

  .cat-card:hover {
    box-shadow: 0 10px 30px rgba(20, 20, 30, .10);
    transform: translateY(-2px);
  }

  .cat-card__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .cat-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cat-card__badge {
    position: absolute;
    left: .85rem;
    top: .85rem;
    padding: .3rem .7rem;
    border-radius: 999px;
    background: rgba(20, 20, 30, .78);
    color: #fff;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .02em;
  }

  .cat-card__body {
    display: flex;
    flex-direction: column;
    gap: .6rem;
    padding: 1.25rem;
    flex: 1;
  }

  .cat-card__title { margin: 0; font-size: 1.15rem; line-height: 1.3; }
  .cat-card__title a { text-decoration: none; color: inherit; }
  .cat-card__title a:hover { text-decoration: underline; }

  .cat-card__meta {
    margin: 0;
    font-size: .85rem;
    font-weight: 700;
    color: var(--text-muted, #5a5a66);
  }

  .cat-card__desc {
    margin: 0;
    font-size: .93rem;
    line-height: 1.55;
    color: var(--text-muted, #5a5a66);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cat-card__list {
    list-style: none;
    margin: .2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: .3rem;
    font-size: .9rem;
  }

  .cat-card__list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed var(--border, #e2e2e6);
    padding-bottom: .3rem;
  }

  .cat-card__list a { text-decoration: none; }
  .cat-card__list a:hover { text-decoration: underline; }
  .cat-card__list span { color: var(--text-muted, #5a5a66); font-weight: 700; }

  .cat-card__cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: .6rem 1rem;
    border-radius: 10px;
    border: 2px solid var(--brand, #FF3D00);
    color: var(--brand, #FF3D00);
    font-weight: 700;
    text-decoration: none;
    font-size: .95rem;
  }

  .cat-card__cta:hover,
  .cat-card__cta:focus-visible {
    background: var(--brand, #FF3D00);
    color: #fff;
  }

  @media (max-width: 1024px) {
    .cat-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }

  @media (max-width: 640px) {
    .cat-grid { grid-template-columns: 1fr; }
  }
</style>
