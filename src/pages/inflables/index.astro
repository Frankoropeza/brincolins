---
/**
 * /inflables/ — HUB del catálogo
 * ──────────────────────────────────────────────────────────────
 * Reescrito (ago 2026). Antes: 8 bloques ProductFeature en una sola
 * página, ~217 enlaces salientes y ningún eje de navegación. Google
 * la leía como una lista plana y la home canibalizaba todas las
 * keywords específicas.
 *
 * Ahora: hub de 11 categorías con 3 modelos destacados cada una.
 * El detalle de cada modelo vive en su ficha; el detalle de cada
 * segmento, en su categoría. Esta página sólo reparte autoridad.
 */
import PageLayout   from "@/layouts/PageLayout.astro";
import QuickNav     from "@/components/QuickNav.astro";
import Breadcrumbs  from "@/components/Breadcrumbs.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FacetasInflables from "@/components/FacetasInflables.astro";
import TablaComparativa from "@/components/TablaComparativa.astro";
import CtaBanner    from "@/components/CtaBanner.astro";
import ResponsiveInflatableImage from "@/components/ResponsiveInflatableImage.astro";
import { CATEGORIAS, inflablesDeCategoria } from "@/data/categorias";
import { INFLABLES_ACTIVOS, PRICE_RANGE, MODELOS_COUNT, PRICE_NOTE_LONG } from "@/data/inflables";
import { SITE_URL } from "@/data/site";

const title = `Inflables para fiestas en renta: ${MODELOS_COUNT} modelos desde $1,400`;
const description = `Catálogo de ${MODELOS_COUNT} inflables para fiestas de $1,400 a $2,600: medidas, edades y cuáles caben bajo techo. Elige por edad, espacio o presupuesto y cotiza.`;

/* Tarjeta de categoría: nombre, 3 modelos destacados y anchor con la
   keyword objetivo. 11 categorías × (1 anchor + 3 modelos) ≈ 44 enlaces,
   frente a los ~217 de la versión anterior. */
const tarjetas = CATEGORIAS.map((c) => {
  const items = inflablesDeCategoria(c);
  const desde = items.length
    ? items.reduce((m, i) => (i.priceNumber < m.priceNumber ? i : m)).price
    : "";
  return { cat: c, destacados: items.slice(0, 3), total: items.length, desde, image: c.image };
});

const faqs = [
  { question: "¿Cómo elijo el inflable correcto en el catálogo?", answer: "En tres pasos y en este orden: mide el espacio libre disponible, define la edad de la mayoría de los invitados y confirma la capacidad al cotizar. El espacio descarta modelos de inmediato, la edad reduce a dos o tres opciones y la capacidad ayuda a decidir entre ellas. Después ya puedes elegir por temática." },
  { question: "¿Cuántos modelos de inflables tienen disponibles?", answer: "Ocho modelos propios: Castillo Baby, Dragones Rojos, Castillo de Princesas, Jungla, Gusanitos, Castillo Blanco, Barco Pirata y Extremo. Los organizamos en 11 categorías —por tamaño, por tipo y por público— porque cada modelo sirve para varios tipos de evento." },
  { question: "¿Cuál es el inflable más económico del catálogo?", answer: "Castillo Baby, desde $1,400 MXN por evento. Está diseñado para niños de 1 a 3 años y mide 2.5 × 2 × 2 m. Para conocer el espacio de instalación, confirma los detalles al cotizar." },
  { question: "¿Cuál es el inflable más rentado?", answer: "Dragones Rojos. Mide 5 × 3 × 2.80 m y está indicado para niños de 3 a 8 años, un rango frecuente en cumpleaños infantiles en CDMX." },
  { question: "¿Qué inflables caben bajo techo?", answer: "Solo dos: el Castillo Baby, que pide 3.2 m de altura libre del piso al punto más bajo del techo, y los Gusanitos, cuya instalación en interiores se confirma según la altura del lugar al cotizar. El resto del catálogo necesita de 4.2 a 5.2 m, así que va al aire libre. Mide descontando lámparas, ventiladores y trabes, y confírmalo al cotizar." },
  { question: "¿Puedo rentar más de un inflable para el mismo evento?", answer: "Sí, y es lo habitual en kermeses escolares, eventos de empresa y ferias. A partir de tres inflables incluimos coordinador de logística sin costo adicional. Hay que verificar el área libre sumada y que existan tomas de corriente independientes." },
  { question: "¿Todos los inflables incluyen entrega e instalación?", answer: "Sí: entrega a domicilio, instalación profesional, motor inflador, sanitización y recolección al finalizar, en los ocho modelos. La entrega sin costo adicional aplica solo en Roma, Polanco, Narvarte, Doctores, Santa María la Ribera, Reforma, algunas zonas de Iztapalapa y algunas zonas de Xochimilco; en el resto de CDMX y Estado de México se cotiza el traslado según zona. El precio publicado es neto; si necesitas factura se agrega el 16% de IVA." },
  { question: "¿Cómo aparto una fecha del catálogo?", answer: "Escríbenos por WhatsApp con el modelo, la fecha y la zona de entrega. Confirmamos disponibilidad en minutos. Para apartar se requiere un anticipo del 50% y el saldo se liquida el día del evento, antes de la instalación." },
];

/* El hub declara una colección DE COLECCIONES: las 11 categorías.
   El detalle de productos vive en el ItemList de cada categoría. */
const hubSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/inflables/#catalogo`,
  name: "Catálogo de inflables y brincolines para renta en CDMX y Edomex",
  description: `Los ${MODELOS_COUNT} modelos de inflables disponibles para renta, de ${PRICE_RANGE} MXN por evento, organizados en ${CATEGORIAS.length} categorías.`,
  url: `${SITE_URL}/inflables/`,
  isPartOf: { "@id": `${SITE_URL}/#website` },
  about:    { "@id": `${SITE_URL}/#org` },
  mainEntity: {
    "@type": "ItemList",
    name: "Categorías de inflables en renta",
    numberOfItems: CATEGORIAS.length,
    itemListElement: CATEGORIAS.map((c, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      name: c.name,
      url: `${SITE_URL}/inflables/${c.slug}/`,
    })),
  },
};
---

<PageLayout
  faqContext={{ tipo: "categoria", nombre: "Inflables del Catálogo", modelos: 8, desde: "$1,400" }}
  title={title}
  description={description}
  pageType="category"
  faqItems={faqs}
  schemaMarkup={JSON.stringify(hubSchema)}
  breadcrumbs={[
    { name: "Inicio", href: "/" },
    { name: "Inflables" },
  ]}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Inflables" }]} />
  </Fragment>

  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="hero__badge">Catálogo completo</span>
          <h1 class="hero__title">
            <span class="highlight">Inflables para fiestas</span> en renta en CDMX y Estado de México
          </h1>
          <p class="hero__desc">Rentamos {MODELOS_COUNT} inflables para fiestas, de $1,400 a $2,600 MXN por evento de 4 a 6 horas, con entrega, instalación y recolección. Hay modelos para niños de 1 a 3 años, medianos para 2 a 10 años y grandes para 3 a 12 años; solo dos caben bajo techo. Elige por edad, espacio o presupuesto.</p>
          <div class="hero__ctas">
            <a href="/cotizar/" class="btn btn-primary btn-lg">Cotizar renta de inflables</a>
            <a href="/precios/" class="btn btn-outline btn-lg">Precios de inflables en CDMX</a>
          </div>
        </div>
        <div class="hero__copy">
          <p class="hero__copy-text">
            Entra por la categoría que corresponde a tu evento en lugar de recorrer el catálogo completo: <a href="/inflables/para-ninos/">inflables para niños</a> si buscas por edad, <a href="/inflables/grandes/">inflables grandes</a> o <a href="/inflables/chicos/">inflables pequeños</a> si el problema es el espacio, y <a href="/inflables/para-interiores/">inflables para interiores</a> si la fiesta es bajo techo.
          </p>
          <p class="hero__copy-text">
            Todos los modelos incluyen instalación profesional, motor inflador, sanitización y recolección. La entrega sin costo adicional aplica solo en zonas seleccionadas; en el resto de CDMX y Estado de México el traslado se cotiza según zona. {PRICE_NOTE_LONG}
          </p>
        </div>
      </div>
    </div>
  </section>

  <QuickNav />

  <!-- ── CÓMO ELEGIR: edad, espacio, presupuesto ── -->
  <section class="section elegir" id="como-elegir">
    <div class="container">
      <h2 class="elegir__title">¿Cómo elegir inflable por edad, espacio y presupuesto?</h2>
      <p class="elegir__intro">Decide en este orden: primero el espacio descarta los modelos que no caben, luego la edad deja dos o tres opciones y al final el presupuesto o la temática deciden.</p>
      <div class="elegir__grid">
        <div class="elegir__box">
          <h3>Por edad</h3>
          <ul>
            <li><strong>1 a 3 años:</strong> Castillo Baby ($1,400).</li>
            <li><strong>2 a 10 años:</strong> Castillo de Princesas ($1,800) y Gusanitos, de 2 a 8 años ($1,600).</li>
            <li><strong>3 a 8 años:</strong> Dragones Rojos y Jungla ($1,600).</li>
            <li><strong>3 a 12 años:</strong> Barco Pirata ($2,300), Extremo ($2,500) y Castillo Blanco ($2,600).</li>
          </ul>
          <p>Ideas de juegos y temática para cada cumpleaños en <a href="/blog/ideas-de-fiesta-por-edad-1-a-12-anos/">ideas de fiesta por edad de 1 a 12 años</a>.</p>
        </div>
        <div class="elegir__box">
          <h3>Por espacio</h3>
          <ul>
            <li><strong>Bajo techo:</strong> solo Castillo Baby (3.2 m de altura libre) y Gusanitos (la altura se confirma al cotizar).</li>
            <li><strong>Patio o jardín mediano:</strong> los modelos de unos 5 × 3 m, como Dragones Rojos, Jungla o Castillo de Princesas.</li>
            <li><strong>Jardín o terreno amplio:</strong> Barco Pirata (6 × 3.5 m), Castillo Blanco (5 × 7 m) o Extremo (8 × 4.5 m).</li>
          </ul>
          <p>Cómo medir largo, ancho y altura en la <a href="/blog/medidas-de-inflables-para-fiestas-tabla/">tabla de medidas de inflables para fiestas</a>.</p>
        </div>
        <div class="elegir__box">
          <h3>Por presupuesto</h3>
          <ul>
            <li><strong>$1,400:</strong> Castillo Baby, el más accesible.</li>
            <li><strong>$1,600 a $1,800:</strong> los cuatro medianos.</li>
            <li><strong>$2,300 a $2,600:</strong> los tres grandes, para grupos y turnos de juego.</li>
          </ul>
          <p>Qué conviene cuando el dinero manda en <a href="/renta-de-inflables-economicos/">renta de inflables económicos</a>, y el total de la fiesta en <a href="/blog/cuanto-cuesta-una-fiesta-infantil-cdmx-presupuesto/">presupuesto de una fiesta infantil</a>.</p>
        </div>
      </div>
      <p class="elegir__foot">¿Sigues con dudas? Los criterios completos están en <a href="/blog/como-elegir-inflable-fiesta-infantil/">cómo elegir inflable para fiesta infantil</a>, o mándanos las medidas de tu espacio y la edad de los niños al cotizar.</p>
    </div>
  </section>

  <!-- ── 11 CATEGORÍAS ── -->
  <section class="section section--snug">
    <div class="container">
      <SectionHeader
        badge="Categorías"
        title="¿Qué inflables para fiestas elegir según tu evento?"
        subtitle="Cada categoría lista sólo los modelos que aplican, con su tabla comparativa y sus preguntas propias."
        copy1="Un mismo inflable sirve para varios tipos de evento, así que cada modelo aparece en tres o cuatro categorías: el Castillo Blanco es a la vez un castillo y un inflable grande para niños de 3 a 12 años. Entrar por la categoría correcta te ahorra comparar ocho fichas para descubrir cuál se adapta a tu espacio."
        copy2="Las categorías por tamaño resuelven el problema más frecuente, que es el espacio disponible. Las de tipo sirven cuando ya sabes qué formato buscas —castillo, tobogán, circuito de obstáculos—. Las de público y entorno son para cuando lo que manda es quién lo va a usar o dónde se va a instalar."
      />

      <div class="cat-grid">
        {tarjetas.map(({ cat, destacados, total, desde, image }) => (
          <article class={`cat-card cat-card--${cat.color}`}>
            <a class="cat-card__media" href={`/inflables/${cat.slug}/`} tabindex="-1" aria-hidden="true">
              <ResponsiveInflatableImage src={image} alt="" loading="lazy" width={720} height={405} sizes="(max-width: 430px) calc(100vw - 2rem), (max-width: 1024px) calc((100vw - 6rem) / 2), 378px" />
              <span class="cat-card__badge">{cat.badge}</span>
            </a>
            <div class="cat-card__body">
              <h3 class="cat-card__title">
                <a href={`/inflables/${cat.slug}/`}>{cat.name}</a>
              </h3>
              <p class="cat-card__meta">{total} {total === 1 ? "modelo" : "modelos"}{desde ? ` · desde ${desde}` : ""}</p>
              <p class="cat-card__desc">{cat.intro[0]}</p>
              <ul class="cat-card__list">
                {destacados.map((inf) => (
                  <li><a href={`/inflables/${inf.slug}/`}>{inf.name}</a> <span>{inf.price}</span></li>
                ))}
              </ul>
              <a class="cat-card__cta" href={`/inflables/${cat.slug}/`}>{cat.anchor.charAt(0).toUpperCase() + cat.anchor.slice(1)} en renta</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── COMPARATIVA GLOBAL ── -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Comparativa"
        title={`Los ${MODELOS_COUNT} modelos, lado a lado`}
        subtitle="Precio, medidas, espacio libre necesario, altura, edades y capacidad."
        copy1="Esta tabla resuelve de una sola pasada la pregunta que más nos hacen por WhatsApp: qué medidas tiene cada inflable. El espacio mínimo de instalación se confirma al cotizar según el modelo y el lugar, así que compártenos las dimensiones disponibles antes de apartar la fecha."
        copy2="La columna de altura libre es la que decide si un modelo entra bajo techo. Se mide del piso al punto más bajo del techo, descontando lámparas, ventiladores y trabes. Sólo dos modelos del catálogo van bajo techo: el Castillo Baby, con 3.2 metros, y el Gusanitos, cuya altura se confirma al cotizar; el resto necesita más de 4."
      />
      <TablaComparativa inflables={INFLABLES_ACTIVOS} caption={`Catálogo completo de inflables en renta — ${MODELOS_COUNT} modelos`} />
    </div>
  </section>

  <!-- ── FACETAS (silo) ── -->
  <section class="section">
    <div class="container">
      <FacetasInflables
        titulo="Todas las categorías de inflables"
        subtitulo="Los tres ejes por los que puedes recorrer el catálogo."
      />
    </div>
  </section>

  <CtaBanner
    title="¿No sabes cuál elegir?"
    subtitle="Mándanos las medidas de tu espacio y la edad de los invitados. Te decimos cuál cabe y cuál conviene, sin compromiso."
    btnText="Cotizar renta de inflables"
    btnHref="/cotizar/"
    btnSecondaryText="Zonas de entrega de inflables"
    btnSecondaryHref="/cobertura/"
    variant="warm"
  />
</PageLayout>

<style>
  .elegir__title { font-family: var(--font-head); font-weight: 800; letter-spacing: -0.03em; color: var(--c-ink); font-size: clamp(1.4rem, 3vw, 1.9rem); margin: 0 0 .5rem; }
  .elegir__intro, .elegir__foot { color: var(--c-ink-60); line-height: 1.65; margin: 0 0 1.25rem; }
  .elegir__foot { margin: 1.25rem 0 0; }
  .elegir__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .elegir__box { padding: 1.5rem 1.6rem; border: 1px solid var(--c-line); border-radius: var(--r-card); background: #fff; color: var(--c-ink); }
  .elegir__box h3 { font-family: var(--font-head); font-weight: 800; letter-spacing: -0.02em; font-size: 1.1rem; margin: 0 0 .6rem; }
  .elegir__box ul { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: .4rem; line-height: 1.55; font-size: .95rem; }
  .elegir__box li { list-style: disc; }
  .elegir__box li::marker { color: var(--c-primary); }
  .elegir__box p { margin: .8rem 0 0; font-size: .93rem; line-height: 1.55; color: var(--c-ink-60); }
  .elegir a { color: var(--c-primary-text); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 900px) { .elegir__grid { grid-template-columns: 1fr; } }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  /* Tarjetas de categoría: paneles pastel en ciclo de 6, texto tinta */
  .cat-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-card);
    overflow: hidden;
    color: var(--c-ink);
  }
  .cat-grid .cat-card:nth-child(6n+1) { background: var(--c-chicle); }
  .cat-grid .cat-card:nth-child(6n+2) { background: var(--c-mango); }
  .cat-grid .cat-card:nth-child(6n+3) { background: var(--c-cielo); }
  .cat-grid .cat-card:nth-child(6n+4) { background: var(--c-menta); }
  .cat-grid .cat-card:nth-child(6n+5) { background: var(--c-lila); }
  .cat-grid .cat-card:nth-child(6n+6) { background: var(--c-durazno); }
  .cat-card__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    margin: 10px 10px 0;
    border-radius: calc(var(--r-card) - 10px);
    overflow: hidden;
  }
  .cat-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cat-card__badge {
    position: absolute;
    left: .85rem;
    top: .85rem;
    padding: .3rem .75rem;
    font-size: .75rem;
  }
  .cat-card__body {
    display: flex;
    flex-direction: column;
    gap: .6rem;
    padding: 1.25rem 1.4rem 1.5rem;
    flex: 1;
  }
  .cat-card__title { margin: 0; font-family: var(--font-head); font-weight: 800; letter-spacing: -0.02em; font-size: 1.2rem; line-height: 1.25; }
  .cat-card__title a { text-decoration: none; color: inherit; }
  .cat-card__title a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .cat-card__meta {
    margin: 0;
    font-size: .85rem;
    font-weight: 700;
    color: var(--c-ink);
  }
  .cat-card__desc {
    margin: 0;
    font-size: .93rem;
    line-height: 1.55;
    color: var(--c-ink);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cat-card__list {
    list-style: none;
    margin: .2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: .3rem;
    font-size: .9rem;
  }
  .cat-card__list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--c-line-strong);
    padding-bottom: .3rem;
  }
  .cat-card__list a { color: var(--c-ink); font-weight: 600; text-decoration: none; }
  .cat-card__list a:hover { text-decoration: underline; text-underline-offset: 2px; }
  .cat-card__list span { color: var(--c-ink); font-weight: 700; }
  /* CTA: pill en contorno tinta (naranja sobre pastel no da contraste) */
  .cat-card__cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: .6rem 1.1rem;
    border-radius: var(--r-btn);
    border: 2px solid var(--c-ink);
    background: transparent;
    color: var(--c-ink);
    font-weight: 700;
    text-decoration: none !important;
    font-size: .95rem;
    transition: background-color .18s ease, color .18s ease, transform .18s ease;
  }
  .cat-card__cta:hover,
  .cat-card__cta:focus-visible {
    background: var(--c-ink);
    color: #fff !important;
    transform: translateY(-2px);
  }
  .cat-card__cta:focus-visible { outline: 3px solid var(--c-ink); outline-offset: 3px; }

  @media (max-width: 1024px) { .cat-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; } }
  @media (max-width: 640px) { .cat-grid { grid-template-columns: 1fr; } }
</style>
