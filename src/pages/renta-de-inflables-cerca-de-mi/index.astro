---
/**
 * /renta-de-inflables-cerca-de-mi/
 * ─────────────────────────────────────────────────────────────
 * Página creada tras la auditoría de agosto 2026.
 *
 * "renta de inflables cerca de mi" — 250 búsquedas/mes en México,
 * KD 0, CPC $20 (el más alto del nicho). Es la keyword #1 tanto de
 * cocoy.com como de pelotinas.com, los dos sitios que dominan el
 * orgánico, y brincolins.com no tenía ninguna página para ella.
 *
 * La intención de esa búsqueda es geográfica e inmediata: "¿llegan
 * a donde vivo y qué tan rápido?". Por eso la página responde eso
 * primero —cobertura, tiempos, cargo de envío real— y deja el
 * catálogo en segundo plano.
 */
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import ProductCard from "@/components/ProductCard.astro";
import { COVERAGE_ZONES } from "@/data/coverage";
import { INFLABLES_ACTIVOS, PRICE_RANGE, MODELOS_COUNT, BADGE } from "@/data/inflables";
import { SITE_URL, WHATSAPP } from "@/data/site";

const title = "Renta de inflables cerca de mí: zonas y costo de envío";
const description = "¿Llegamos a tu colonia? Revisa las 32 zonas de CDMX y Edomex con su cargo de envío, inflables desde $1,400 con instalación, y cotiza con tu ubicación.";

/* Zonas reales desde coverage.ts: nunca listas escritas a mano.
   El resumen de envío de cada zona sale de la nota que la página hub
   (/cobertura/cdmx/ o /cobertura/edomex/) publica para esa zona, así la
   tabla de esta página y la del hub no pueden contradecirse. */
const hubCdmx   = COVERAGE_ZONES.find(z => z.slug === "cdmx");
const hubEdomex = COVERAGE_ZONES.find(z => z.slug === "edomex");
const notaHub = new Map(
  [...(hubCdmx?.childZones ?? []), ...(hubEdomex?.childZones ?? [])].map((c): [string, string] => [c.href, c.note])
);
const zonas = COVERAGE_ZONES.filter(z => !["cdmx", "edomex"].includes(z.slug));
const filaZona = (z: (typeof zonas)[number]) => {
  const href = `/cobertura/${z.slug}/`;
  const nota = notaHub.get(href) ?? "";
  const [envio, ...resto] = nota.split(" · ");
  const fee = (z.shippingFee ?? "").trim();
  return {
    href,
    name: z.zone,
    envio: envio || (fee === "Según zona" ? "Según colonia" : fee || "Incluido"),
    detalle: resto.join(" · "),
  };
};
const filasCdmx   = zonas.filter(z => z.areaParent === "Ciudad de México").map(filaZona);
const filasEdomex = zonas.filter(z => z.areaParent === "Estado de México").map(filaZona);
const N_MUNICIPIOS = filasEdomex.length;

const waHref = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(
  "Hola BRINCOLINS, quiero saber si llegan a mi zona. Mi colonia y municipio o alcaldía son: "
)}`;

const faqs = [
  {
    question: "¿Cómo sé si BRINCOLINS llega hasta mi colonia?",
    answer: `Cubrimos las 16 alcaldías de la Ciudad de México y ${N_MUNICIPIOS} municipios del Estado de México. Busca tu alcaldía o municipio en la tabla de esta página y entra a su página para ver las colonias. Si no aparece, mándanos tu colonia o tu ubicación por WhatsApp: en zonas limítrofes casi siempre podemos llegar.`,
  },
  {
    question: "¿Cuánto cuesta el envío a mi zona?",
    answer: "En Roma, Polanco, Narvarte, Doctores, Santa María la Ribera, Reforma y algunas zonas de Iztapalapa y Xochimilco el traslado no tiene costo. En el resto de la CDMX va de $100 a $300 donde hay monto publicado, y en el Estado de México de $150 a $600 según el municipio. La tabla muestra el cargo de cada zona y te lo confirmamos por escrito antes de que apartes.",
  },
  {
    question: "¿Puedo mandar mi ubicación por WhatsApp para cotizar?",
    answer: "Sí, es la forma más rápida. Comparte tu ubicación o escribe calle, colonia y alcaldía o municipio, junto con la fecha y la edad de los niños. Con eso confirmamos cobertura, cargo de envío y disponibilidad del modelo. Atendemos de lunes a domingo, de 8:00 a 20:00.",
  },
  {
    question: "¿Con cuánta anticipación debo reservar?",
    answer: "Para fines de semana normales, de una a dos semanas. Para mayo, junio y diciembre, y para cualquier sábado de temporada alta, recomendamos tres o cuatro semanas: son las fechas que primero se agotan. Si tu evento es mañana, escríbenos igual: a veces hay disponibilidad de último momento.",
  },
  {
    question: "¿Qué necesito tener listo en mi domicilio?",
    answer: "Un área plana y despejada para el modelo que elijas, una toma de corriente de 110 V a menos de 20 metros y una persona adulta que reciba al equipo. Si el evento es bajo techo, solo caben el Castillo Baby y los Gusanitos, que piden 3.2 m de altura libre. Si es en condominio o salón, avísanos para gestionar el acceso del vehículo.",
  },
  {
    question: "¿Cuánto cuesta rentar un inflable cerca de mí?",
    answer: `De ${PRICE_RANGE} MXN por evento de 4 a 6 horas, según el modelo, más el envío de tu zona si aplica. El precio incluye entrega, instalación, motor, sanitización y recolección. Son precios netos: si necesitas factura se agrega el 16% de IVA.`,
  },
];

/* Service con areaServed amplio: esta página cubre toda la ZMVM,
   a diferencia de las 34 páginas de zona que declaran una sola. */
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${SITE_URL}/renta-de-inflables-cerca-de-mi/#servicio`,
  name: "Renta de inflables a domicilio en CDMX y Estado de México",
  serviceType: "Renta de inflables y brincolines para fiestas",
  description:
    "Servicio de renta de inflables con entrega, instalación y recolección a domicilio en las 16 alcaldías de la Ciudad de México y los principales municipios del Estado de México.",
  provider: { "@id": `${SITE_URL}/#org` },
  areaServed: [
    { "@type": "State", name: "Ciudad de México" },
    { "@type": "State", name: "Estado de México" },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Modelos disponibles",
    itemListElement: INFLABLES_ACTIVOS.map(inf => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: `Renta de ${inf.name}`, url: `${SITE_URL}/inflables/${inf.slug}/` },
      priceCurrency: "MXN",
      price: inf.priceNumber,
    })),
  },
};
---

<PageLayout
  faqContext={{ tipo: "cerca" }}
  title={title}
  description={description}
  pageType="category"
  faqItems={faqs}
  schemaMarkup={JSON.stringify(serviceSchema)}
  breadcrumbs={[
    { name: "Inicio", href: "/" },
    { name: "Renta de inflables cerca de mí" },
  ]}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Renta de inflables cerca de mí" }]} />
  </Fragment>

  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="hero__badge">Entrega a domicilio</span>
          <h1 class="hero__title">
            Renta de inflables <span class="highlight">cerca de ti</span>
          </h1>
          <p class="hero__desc">
            Si tu fiesta es en la CDMX o en {N_MUNICIPIOS} municipios del Estado de México, llegamos a tu domicilio:
            no hay sucursal a la que ir. Busca tu zona en la tabla, revisa el cargo de envío y mándanos tu
            ubicación por WhatsApp para confirmar fecha y precio cerrado.
          </p>
          <p class="hero__trust-line">
            <span>{zonas.length} zonas cubiertas · {MODELOS_COUNT} modelos · de {PRICE_RANGE} MXN</span>
          </p>
          <div class="hero__ctas">
            <a href="#mi-zona" class="btn btn-primary btn-lg">Buscar mi zona</a>
            <a href={waHref} target="_blank" rel="nofollow noopener noreferrer" class="btn btn-wa btn-lg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#i-wa"/></svg>
              Preguntar por WhatsApp
            </a>
          </div>
        </div>
        <div class="hero__copy">
          <p class="hero__copy-text">
            No tenemos una tienda a la que tengas que ir: <strong>nosotros llegamos a tu domicilio</strong>.
            Cubrimos las 16 alcaldías de la Ciudad de México y {N_MUNICIPIOS} municipios del
            Estado de México, con entrega, instalación y recolección incluidas en el servicio.
          </p>
          <p class="hero__copy-text">
            Lo que la mayoría quiere saber primero es si llegamos a su colonia y cuánto cuesta
            el traslado. Abajo está la tabla de zonas con el cargo de envío real de cada una:
            <strong>en Roma, Polanco, Narvarte, Doctores, Santa María la Ribera, Reforma y algunas zonas de Iztapalapa y Xochimilco no tiene costo</strong>.
          </p>
          <p class="hero__copy-text hero__copy-text--links">
            Antes de escribirnos, revisa los <a href="/precios/">precios de renta de inflables por modelo</a>
            y la <a href="/blog/medidas-de-inflables-para-fiestas-tabla/">tabla de medidas de inflables</a>
            para saber cuál cabe en tu espacio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <QuickNav />

  {/* ── Cómo funciona ── */}
  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Cómo funciona"
        title="¿Cómo saber si llegamos a tu domicilio y cotizar?"
        subtitle="Cuatro pasos por WhatsApp, sin visitas a sucursal ni papeleo."
        copy1="Busca tu alcaldía o municipio en la tabla de abajo. Si aparece, ya sabes el cargo de envío; si no, mándanos tu ubicación y revisamos la ruta. Con la dirección, la fecha y la edad de los niños te confirmamos disponibilidad y el precio cerrado, y el día del evento llegamos a montar."
        copy2="No hay contrato que firmar en persona ni depósito en garantía por el equipo. Sólo el anticipo del 50% para apartar la fecha, y el resto el día de la fiesta."
      />
      <div class="cerca-pasos">
        <div class="cerca-paso">
          <span class="cerca-paso__num">1</span>
          <h3 class="cerca-paso__title">Comparte tu ubicación y fecha</h3>
          <p class="cerca-paso__desc">Por WhatsApp (ubicación o calle, colonia y alcaldía o municipio) o con el formulario. Con eso verificamos cobertura y disponibilidad.</p>
        </div>
        <div class="cerca-paso">
          <span class="cerca-paso__num">2</span>
          <h3 class="cerca-paso__title">Recibes el precio cerrado</h3>
          <p class="cerca-paso__desc">Con el cargo de envío de tu zona ya sumado, si aplica. Nada de "eso lo vemos el día del evento".</p>
        </div>
        <div class="cerca-paso">
          <span class="cerca-paso__num">3</span>
          <h3 class="cerca-paso__title">Apartas con el 50%</h3>
          <p class="cerca-paso__desc">Transferencia, efectivo o tarjeta. Si cancelas con más de 48 horas te devolvemos el anticipo completo.</p>
        </div>
        <div class="cerca-paso">
          <span class="cerca-paso__num">4</span>
          <h3 class="cerca-paso__title">Llegamos y montamos</h3>
          <p class="cerca-paso__desc">Entre 15 y 30 minutos de instalación, antes de la hora de inicio. Al terminar volvemos por el equipo.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Zonas ── */}
  <section class="section section--alt" id="mi-zona">
    <div class="container">
      <SectionHeader
        badge="Tu zona"
        title="¿Qué alcaldías y municipios cubrimos?"
        subtitle="Tabla de zonas con su cargo de envío real y enlace a cada página."
        copy1="Cada zona tiene su propia página con las colonias que cubrimos, los tiempos de llegada y los modelos que mejor funcionan ahí según el tipo de espacio más común. Si tu colonia no aparece por nombre, entra a la página de tu alcaldía o municipio: ahí está el listado completo."
        copy2="Los cargos de envío reflejan la distancia desde nuestro almacén en la Ciudad de México. No son un margen extra: son el traslado real del equipo y del personal de montaje. Instalación y retiro van siempre dentro del precio del inflable."
      />

      <h3 class="cerca-zonas__title">Ciudad de México: 16 alcaldías</h3>
      <p class="cerca-zonas__note">Sin costo de traslado en Roma, Polanco, Narvarte, Doctores, Santa María la Ribera, Reforma y algunas zonas de Iztapalapa y Xochimilco. Resumen completo en la <a href="/cobertura/cdmx/">guía de cobertura de la CDMX</a>.</p>
      <div class="cerca-tabla-wrap">
        <table class="cerca-tabla">
          <caption class="sr-only">Cargo de envío de inflables por alcaldía de la Ciudad de México</caption>
          <thead><tr><th scope="col">Alcaldía o zona</th><th scope="col">Cargo de envío</th><th scope="col">Colonias y espacios</th></tr></thead>
          <tbody>
            {filasCdmx.map(f => (
              <tr>
                <th scope="row"><a href={f.href}>{f.name}</a></th>
                <td>{f.envio}</td>
                <td>{f.detalle}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="cerca-zonas__title">Estado de México: {N_MUNICIPIOS} municipios</h3>
      <p class="cerca-zonas__note">El envío depende de la distancia desde nuestro almacén y es el mismo para cualquier modelo. Detalle por región en la <a href="/cobertura/edomex/">guía de cobertura del Estado de México</a>.</p>
      <div class="cerca-tabla-wrap">
        <table class="cerca-tabla">
          <caption class="sr-only">Cargo de envío de inflables por municipio del Estado de México</caption>
          <thead><tr><th scope="col">Municipio</th><th scope="col">Cargo de envío</th><th scope="col">Colonias y espacios</th></tr></thead>
          <tbody>
            {filasEdomex.map(f => (
              <tr>
                <th scope="row"><a href={f.href}>{f.name}</a></th>
                <td>{f.envio}</td>
                <td>{f.detalle}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="cerca-zonas__foot">
        ¿No ves tu zona? Mándanos tu ubicación por
        <a href={waHref} target="_blank" rel="nofollow noopener noreferrer">WhatsApp</a>:
        en zonas limítrofes casi siempre podemos llegar. También puedes ver
        el <a href="/cobertura/">mapa completo de cobertura</a>.
      </p>
    </div>
  </section>

  {/* ── Catálogo resumido ── */}
  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Catálogo"
        title={`¿Qué ${MODELOS_COUNT} modelos de inflables llegan a tu domicilio?`}
        subtitle={`De ${PRICE_RANGE} MXN por evento de 4 a 6 horas.`}
        copy1="Todos se entregan e instalan igual, sin importar la zona. La diferencia entre modelos es el espacio que necesitas, la edad de los niños y si caben bajo techo."
        copy2="Si no sabes cuál elegir, dinos cuántos niños esperas y cuánto espacio tienes: con eso te decimos cuál cabe y cuál no. Es más útil que elegir por foto."
      />
      <div class="grid-4">
        {INFLABLES_ACTIVOS.map(inf => (
          <ProductCard
            slug={inf.slug}
            name={inf.name}
            description={inf.description}
            price={inf.price}
            size={inf.size}
            ages={inf.ages}
            category={BADGE[inf.slug]?.label ?? inf.category}
            categoryColor={BADGE[inf.slug]?.color}
            image={inf.image}
          />
        ))}
      </div>
      <p class="cerca-zonas__foot">
        Compara medidas, edades y altura libre en el <a href="/inflables/">catálogo de inflables</a>.
      </p>
    </div>
  </section>

  <CtaBanner
    title="Dinos tu colonia y te decimos si llegamos"
    subtitle="Respuesta por WhatsApp en minutos, con precio y traslado de tu zona confirmados."
  />
</PageLayout>

<style>
  .hero__copy-text--links a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  /* ── Pasos ── */
  .cerca-pasos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .cerca-paso {
    padding: 1.5rem 1.25rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    background: #fff;
  }
  .cerca-paso__num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: .85rem;
    border-radius: 50%;
    background: var(--c-ink);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 800;
  }
  .cerca-paso__title {
    font-family: var(--font-head);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1rem;
    margin: 0 0 .4rem;
    color: var(--c-ink);
  }
  .cerca-paso__desc {
    margin: 0;
    font-size: .9rem;
    line-height: 1.6;
    color: var(--c-ink-60);
  }

  /* ── Tabla de zonas ── */
  .cerca-tabla-wrap { overflow-x: auto; margin: 0 0 1.75rem; border: 1px solid var(--c-line); border-radius: var(--r-tile); background: #fff; }
  .cerca-tabla { width: 100%; border-collapse: collapse; font-size: .92rem; }
  .cerca-tabla th, .cerca-tabla td { text-align: left; padding: .7rem .9rem; border-bottom: 1px solid var(--c-line); vertical-align: top; line-height: 1.5; color: var(--c-ink); }
  .cerca-tabla thead th { background: var(--c-canvas); font-family: var(--font-head); font-weight: 700; font-size: .85rem; }
  .cerca-tabla tbody tr:last-child th, .cerca-tabla tbody tr:last-child td { border-bottom: 0; }
  .cerca-tabla tbody th { font-weight: 700; white-space: nowrap; }
  .cerca-tabla a { color: var(--c-primary-text); font-weight: 700; }
  .cerca-tabla td:nth-child(2) { font-weight: 600; }
  .cerca-tabla td:last-child { color: var(--c-ink-60); }

  /* ── Zonas ── */
  .cerca-zonas__title {
    font-family: var(--font-head);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1.15rem;
    margin: 2rem 0 .3rem;
    color: var(--c-ink);
  }
  .cerca-zonas__title:first-of-type { margin-top: 0; }
  .cerca-zonas__note {
    margin: 0 0 1rem;
    font-size: .9rem;
    color: var(--c-ink-60);
    max-width: 75ch;
  }
  .cerca-zonas__note a { color: var(--c-primary-text); font-weight: 600; }
  .cerca-zonas__foot {
    margin: 1.25rem 0 0;
    font-size: .95rem;
    line-height: 1.7;
    color: var(--c-ink-60);
  }
  .cerca-zonas__foot a { color: var(--c-primary-text); font-weight: 600; }

  @media (max-width: 900px) {
    .cerca-pasos { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .cerca-pasos { grid-template-columns: 1fr; }
  }
</style>
