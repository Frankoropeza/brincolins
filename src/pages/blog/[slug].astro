---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import CtaBanner  from "@/components/CtaBanner.astro";
import EnlacesCategoria from "@/components/EnlacesCategoria.astro";
import InflableDestacado from "@/components/InflableDestacado.astro";
import { BLOG_CATEGORIA } from "@/data/blogCategorias";
import { getCategoria, inflablesDeCategoria } from "@/data/categorias";
import { PAGINAS, BASE_URL, fmt } from "@/data/mesasDeDulces";
import BlogSidebar from "@/components/BlogSidebar.astro";

type BlogPost = CollectionEntry<"blog">;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
.filter((p) => !p.data.draft)
.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
/* Índice: solo H2, y solo si el artículo es lo bastante largo para necesitarlo. */
const toc = headings.filter((h) => h.depth === 2);
const fechaAct = d.updatedDate && d.updatedDate !== d.publishDate
  ? new Date(d.updatedDate).toLocaleDateString("es-MX", { year: "numeric", month: "long", day: "numeric" })
  : null;

// ── Artículos relacionados (mismo servicio, misma categoría, luego recientes) ──
const all = (await getCollection("blog")).filter((p) => !p.data.draft);
const byDate = (a: BlogPost, b: BlogPost) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
const mismoServicio = d.servicio ? all.filter((p) => p.id !== post.id && p.data.servicio === d.servicio) : [];
let related = mismoServicio
.concat(all.filter((p) => p.id !== post.id && p.data.category === d.category && !mismoServicio.includes(p)).sort(byDate))
.slice(0, 3);
if (related.length < 3) {
  const ids = new Set([post.id, ...related.map((r) => r.id)]);
  related = related.concat(all.filter((p) => !ids.has(p.id)).sort(byDate).slice(0, 3 - related.length));
}

/* ── Categoría del catálogo a la que apunta este post ──
   Los 59 posts enlazaban al catálogo plano con anchors genéricos
   ("Ver inflables"). Ahora cada uno manda una señal de keyword a UNA
   categoría, arriba del artículo y con el anchor exacto de destino. */
const catPost    = getCategoria(BLOG_CATEGORIA[post.id] ?? "");
const catModelos = catPost ? inflablesDeCategoria(catPost) : [];
const catItems   = catPost
  ? [
      { href: `/inflables/${catPost.slug}/`, anchor: catPost.anchor, nota: `${catModelos.length} ${catModelos.length === 1 ? "modelo" : "modelos"} con medidas, capacidad y precio` },
...catModelos.slice(0, 2).map((i) => ({ href: `/inflables/${i.slug}/`, anchor: i.name, nota: `desde ${i.price}` })),
    ]
  : [];

/* ── Servicio de mesas de dulces que apoya el post (frontmatter `servicio`) ──
   Anchor = keyword principal de la página de servicio. */
const serv = d.servicio ? PAGINAS.find((p) => p.slug === d.servicio) : undefined;
const servItems = serv
  ? [
      { href: `${BASE_URL}${serv.slug}/`, anchor: serv.h1, nota: `desde ${fmt(serv.niveles[0].precio)} más IVA` },
      { href: BASE_URL, anchor: "Mesas de dulces para eventos en CDMX", nota: "eventos, tipos de mesa y estaciones" },
    ]
  : [];

// ── Sidebar de enlaces (nov 2026) ──
/* Más artículos: los 3 relacionados de arriba + recientes hasta 6. */
const masArticulos = [...related, ...all.filter((p) => p.id !== post.id && !related.includes(p)).sort(byDate)].slice(0, 6);

// ── Helpers ──
const esc = (s: unknown) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;");
const mdInline = (s: unknown) => esc(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
const fechaFmt = new Date(d.publishDate).toLocaleDateString("es-MX", { year: "numeric", month: "long", day: "numeric" });

const heading = d.h1 || d.title;
const SITE = "https://brincolins.com";
const canonical = `${SITE}/blog/${post.id}/`;

// ── WordCount desde el cuerpo Markdown crudo ──
const wordCount = post.body ? post.body.trim().split(/\s+/).length : undefined;

// ── BlogPosting JSON-LD ──
const blogSchema = {
  "@context": "https://schema.org",
  "@type": ["Article", "BlogPosting"],
  "headline": d.title,
  "description": d.description,
  "image": d.heroImage ? `${SITE}${d.heroImage}` : `${SITE}/img/og-brincolins.jpg`,
  "datePublished": d.publishDate,
  "dateModified": d.updatedDate || d.publishDate,
  "author": { "@type": "Organization", "@id": `${SITE}/#org`, "name": d.author || "BRINCOLINS", "url": SITE },
  "publisher": { "@id": `${SITE}/#org` },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
  "articleSection": d.category,
  "inLanguage": "es-MX",
...(d.tags?.length ? { "keywords": d.tags.join(", ") } : {}),
...(wordCount ? { "wordCount": wordCount } : {}),
};

// ── HowTo JSON-LD (solo posts instructivos con frontmatter `howto`) ──
const howToSchema = d.howto
  ? {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": d.howto.name,
      "description": d.description,
      "image": d.heroImage ? `${SITE}${d.heroImage}` : `${SITE}/img/og-brincolins.jpg`,
...(d.howto.totalTime ? { "totalTime": d.howto.totalTime } : {}),
      "step": d.howto.steps.map((s, i) => ({
        "@type": "HowToStep",
        "position": i + 1,
        "name": s.name,
        "text": s.text,
      })),
    }
  : null;
---

<PageLayout
  faqContext={{ tipo: "blog" }}
  title={d.title}
  description={d.description}
  canonical={canonical}
  ogImage={d.heroImage || "/img/og-brincolins.jpg"}
  pageType="page"
  faqItems={d.faqs ?? []}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  {howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}

  <!-- HERO 2 COLUMNAS -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <div class="art-hero__top">
            <a href="/blog/" class="art-hero__back">← Volver al blog</a>
            <span class="hero__badge">{d.category}</span>
          </div>
          <h1 class="hero__title" set:html={mdInline(heading)} />
          <div class="art-hero__meta">
            {d.readTime && (<><span>{d.readTime} lectura</span><span class="art-hero__sep">·</span></>)}
            <a href="/nosotros/" class="art-hero__author">{d.author}</a>
            <span class="art-hero__sep">·</span>
            <time datetime={d.publishDate}>{fechaFmt}</time>
            {fechaAct && (<><span class="art-hero__sep">·</span><span>Actualizado: <time datetime={d.updatedDate}>{fechaAct}</time></span></>)}
          </div>
          {d.excerpt && <p class="hero__desc">{d.excerpt}</p>}
          <div class="hero__ctas">
            <a href="/cotizar/" class="btn btn-primary btn-lg">Pedir cotización gratis</a>
            <a href="/inflables/" class="btn btn-outline btn-lg">Inflables para fiestas en renta</a>
          </div>
        </div>
        {d.intro?.length ? (
          <div class="hero__copy">
            {d.intro.map((p) => <p class="hero__copy-text" set:html={mdInline(p)} />)}
          </div>
        ) : null}
      </div>
    </div>
  </section>

  <QuickNav />

  <!-- PORTADA -->
  {d.heroImage && (
    <section class="art-cover-wrap">
      <div class="container art-shell">
        <img src={d.heroImage} alt={d.heroImageAlt || heading} width="1200" height="675" loading="eager" fetchpriority="high"
             class="art-cover" />
      </div>
    </section>
  )}

  <!-- CONTENIDO + SIDEBAR -->
  <section class="section section--snug">
    <div class="container art-shell">
      <div class="art-layout">
        <article class="art-body">
          {serv && (
            <EnlacesCategoria
              variante="inline"
              titulo={`Servicio: ${serv.nombre.toLowerCase()}`}
              intro="La opera nuestro aliado MEDEDUL y la coordinamos con la entrega de tu inflable, en una sola cotización."
              items={servItems}
            />
          )}
          {catPost && (
            <EnlacesCategoria
              variante="inline"
              titulo={`Lo que buscas: ${catPost.name.toLowerCase()}`}
              intro={catPost.guiaSub}
              items={catItems}
            />
          )}

          {toc.length >= 4 && (
            <nav class="art-toc" aria-label="Contenido del artículo">
              <details open>
                <summary>En este artículo</summary>
                <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
              </details>
            </nav>
          )}

          <Content />

          <InflableDestacado postId={post.id} body={post.body ?? ""} />

          {d.galleryImages?.length ? (
            <div class="art-gallery">
              {d.galleryImages.map((src, i) => (
                <img src={src} alt={`${heading} — foto ${i + 1}`} width="600" height="450" loading="lazy" class="art-gallery__img" />
              ))}
            </div>
          ) : null}
        </article>

        <BlogSidebar
          postId={post.id}
          body={post.body ?? ""}
          titulo={heading}
          categoria={catPost?.slug}
          articulos={masArticulos.slice(0, 4).map((r) => ({ href: `/blog/${r.id}/`, titulo: r.data.title, imagen: r.data.heroImage, alt: r.data.heroImageAlt }))}
          indice={toc.map((h) => ({ href: `#${h.slug}`, label: h.text }))}
        />
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <CtaBanner
    title="Reserva tu inflable y haz la fiesta inolvidable"
    subtitle="Respondemos en minutos. Entrega puntual, instalación y recolección; traslado según zona."
    btnText="Solicitar cotización"
    btnHref="/cotizar/"
    btnSecondaryText="Catálogo de renta de inflables en CDMX"
    btnSecondaryHref="/inflables/"
    variant="vibrant"
  />
</PageLayout>

<style>
  /* ── Hero del artículo ── */
  .art-hero__top {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: .5rem 1rem; margin-bottom: 1.2rem;
  }
  .art-hero__top .hero__badge { margin-bottom: 0; }
  .art-hero__back {
    font-size: .875rem; color: var(--c-primary-text); font-weight: 700;
    text-decoration: none; display: inline-flex; align-items: center;
    gap: .3rem; min-height: 44px;
    transition: gap .15s ease;
  }
  .art-hero__back:hover { gap: .6rem; text-decoration: underline; text-underline-offset: 3px; }
  .art-hero__meta {
    display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
    font-size: .875rem; color: var(--c-ink-60); font-weight: 600; margin-bottom: .75rem;
  }
  .art-hero__sep { opacity: .7; }
  .art-hero__author { color: var(--c-ink); text-decoration: underline; text-underline-offset: 3px; }

  /* ── Portada ── */
  .art-cover-wrap { padding-bottom: 1rem; }
  .art-cover {
    width: 100%; max-height: 480px; object-fit: cover; display: block;
    border-radius: var(--r-card);
  }

  /* ── Layout artículo + sidebar ──
     Al 100 % del navegador (decisión de Frank, 2026-11-06): la prosa llena
     todo el ancho que deja el sidebar. La portada usa el mismo contenedor. */
  .art-layout {
    display: grid; grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  .art-body { min-width: 0; }

  /* ── Prosa (Markdown renderizado) ── */
  .art-body :global(h2) {
    font-family: var(--font-head); font-weight: 800; letter-spacing: -0.03em;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem); line-height: 1.2; color: var(--c-ink);
    margin: 2.75rem 0 1rem;
  }
  .art-body :global(h2:first-child) { margin-top: 0; }
  .art-body :global(h3) {
    font-family: var(--font-head); font-weight: 800; letter-spacing: -0.02em;
    font-size: clamp(1.15rem, 2vw, 1.35rem); line-height: 1.3; color: var(--c-ink);
    margin: 2rem 0 .75rem;
  }
  .art-body :global(h4) {
    font-family: var(--font-head); font-weight: 700;
    font-size: 1.0625rem; color: var(--c-ink); margin: 1.5rem 0 .5rem;
  }
  .art-body :global(p) {
    font-size: clamp(1.0625rem, 1rem + .25vw, 1.125rem); line-height: 1.75;
    color: var(--c-ink); margin: 0 0 1.25rem;
  }
  .art-body :global(strong) { color: var(--c-ink); font-weight: 700; }
  .art-body :global(a) {
    color: var(--c-primary-text); font-weight: 600;
    text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px;
  }
  .art-body :global(a:hover) { text-decoration-thickness: 2px; }
  .art-body :global(ul), .art-body :global(ol) {
    padding-left: 1.4rem; margin: 0 0 1.5rem;
    display: flex; flex-direction: column; gap: .5rem;
  }
  .art-body :global(ul li) { list-style: disc; }
  .art-body :global(ol li) { list-style: decimal; }
  .art-body :global(li) {
    font-size: clamp(1.0625rem, 1rem + .25vw, 1.125rem); line-height: 1.7;
    color: var(--c-ink); padding-left: .25rem;
  }
  .art-body :global(li::marker) { color: var(--c-ink-60); font-weight: 700; }
  .art-body :global(li p) { margin: 0; }
  .art-body :global(hr) { border: 0; border-top: 1px solid var(--c-line-strong); margin: 2.5rem 0; }

  /* Callouts ── blockquote */
  .art-body :global(blockquote) {
    background: var(--c-mango); border-radius: var(--r-tile);
    padding: 1.2rem 1.5rem; margin: 1.75rem 0; color: var(--c-ink);
  }
  .art-body :global(blockquote p) { margin: 0 0 .5rem; }
  .art-body :global(blockquote p:last-child) { margin-bottom: 0; }

  /* Tablas */
  .art-body :global(table) {
    width: 100%; border-collapse: separate; border-spacing: 0; margin: 1.75rem 0;
    font-size: 1rem; background: #fff;
    border: 1px solid var(--c-line); border-radius: var(--r-tile); overflow: hidden;
  }
  .art-body :global(th) {
    text-align: left; padding: .8rem 1rem; background: var(--c-canvas);
    font-family: var(--font-head); font-weight: 700; color: var(--c-ink);
    border-bottom: 1px solid var(--c-line-strong);
  }
  .art-body :global(td) { padding: .8rem 1rem; border-bottom: 1px solid var(--c-line); color: var(--c-ink); line-height: 1.55; }
  .art-body :global(tr:last-child td) { border-bottom: none; }

  /* Imágenes y figuras */
  .art-body :global(img) { border-radius: var(--r-card); margin: 1.5rem 0; max-width: 100%; height: auto; }
  .art-body :global(.art-figure) { margin: 2rem 0; }
  .art-body :global(.art-figure img) { width: 100%; height: auto; margin: 0; display: block; }
  .art-body :global(.art-figure figcaption) { margin-top: .6rem; font-size: .9rem; color: var(--c-ink-60); text-align: center; }
  .art-body :global(.art-figuras) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 2rem 0; }
  .art-body :global(.art-figuras .art-figure) { margin: 0; }
  .art-body :global(.art-figuras img) { aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 560px) {
    .art-body :global(.art-figuras) { gap: .6rem; }
    .art-body :global(.art-figuras figcaption) { font-size: .78rem; line-height: 1.35; }
  }

  /* Puntos clave (rehype bodyFigures en astro.config.mjs) */
  .art-body :global(.puntos-clave) {
    margin: 1.5rem 0 2rem; padding: 1.2rem 1.5rem;
    background: var(--c-menta); border-radius: var(--r-tile);
  }
  .art-body :global(.puntos-clave p) { margin: 0 0 .5rem; font-family: var(--font-head); }
  .art-body :global(.puntos-clave ul) { margin: 0; }

  /* ── Índice (va después de la prosa para ganarle a .art-body a/li) ── */
  /* Blanco con borde: va justo debajo del bloque «Lo que buscas» (cielo)
     y dos cajas del mismo pastel seguidas se leían como una sola. */
  .art-toc {
    margin: 0 0 2rem; padding: 1.1rem 1.4rem;
    background: #fff; border: 1px solid var(--c-line); border-radius: var(--r-tile);
  }
  .art-toc summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    font-family: var(--font-head); font-weight: 800; color: var(--c-ink);
    cursor: pointer; padding: .2rem 0; list-style: none;
  }
  .art-toc summary::-webkit-details-marker { display: none; }
  .art-toc summary::after {
    content: ""; width: .55rem; height: .55rem; flex-shrink: 0;
    border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px); transition: transform .2s ease;
  }
  .art-toc details[open] summary::after { transform: rotate(-135deg) translateY(-2px); }
  .art-toc ol { margin: .75rem 0 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: .4rem; font-size: 1rem; }
  .art-toc li { list-style: decimal; color: var(--c-ink); font-size: 1rem; line-height: 1.5; padding-left: 0; }
  .art-toc a { color: var(--c-ink); font-weight: 500; text-decoration: none; }
  .art-toc a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ── Galería ── */
  .art-gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2.5rem; }
  .art-gallery__img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--r-tile); }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .art-layout { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .art-gallery { grid-template-columns: 1fr; }
  }
  /* Tablas anchas (5-6 columnas) en pantallas chicas: se deslizan de lado
     en vez de recortarse. */
  @media (max-width: 760px) {
    .art-body :global(table) { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .art-body :global(th), .art-body :global(td) { min-width: 5.5rem; }
  }
</style>
