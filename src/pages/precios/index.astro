---
import { anchorInflable } from "@/data/anchors";
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import FaqItem from "@/components/FaqItem.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { INFLABLES_ACTIVOS } from "@/data/inflables";

const title = "¿Cuánto cuesta rentar un inflable? De $1,400 a $2,600";
const description = "Tabla de precios de los 8 inflables: de $1,400 a $2,600 por evento de 4 a 6 h con instalación y retiro. Envío por zona e IVA explicados. Cotiza hoy.";

const inflables = [
  {
    slug:        "mini-castillo",
    name:        "Castillo Baby",
    category:    "Chico",
    price:       1400,
    size:        "2.5×2×2 m",
    ages:        "1–3 años",
    capacity:    "Se confirma al cotizar",
    highlight:   false,
    tag:         "El más accesible",
    tagColor:    "green",
    ideal:       "Bebés, primer año, interiores, departamentos",
    image:       "/img/inflables/mini-castillo.avif",
  },
  {
    slug:        "dragones-rojos",
    name:        "Dragones Rojos",
    category:    "Mediano",
    price:       1600,
    size:        "5×3×2.80 m",
    ages:        "3–8 años",
    capacity:    "Se confirma al cotizar",
    highlight:   true,
    tag:         "El más rentado",
    tagColor:    "primary",
    ideal:       "Cumpleaños infantiles, jardines, eventos escolares",
    image:       "/img/inflables/dragones-rojos.avif",
  },
  {
    slug:        "castillo-princesas",
    name:        "Castillo de Princesas",
    category:    "Mediano",
    price:       1800,
    size:        "5×3.30×3 m",
    ages:        "2–10 años",
    capacity:    "Se confirma al cotizar",
    highlight:   false,
    tag:         "Favorito para niñas",
    tagColor:    "pink",
    ideal:       "Fiestas de niñas, temáticas de princesas",
    image:       "/img/inflables/castillo-princesas.avif",
  },
  {
    slug:        "mini-jungla",
    name:        "Jungla",
    category:    "Mediano",
    price:       1600,
    size:        "5×3×2.50 m",
    ages:        "3–8 años",
    capacity:    "Se confirma al cotizar",
    highlight:   false,
    tag:         "Temático aventura",
    tagColor:    "green",
    ideal:       "Fiestas de safari, aventura y naturaleza",
    image:       "/img/inflables/mini-jungla.avif",
  },
  {
    slug:        "gusanitos",
    name:        "Gusanitos",
    category:    "Mediano",
    price:       1600,
    size:        "5×3×2.80 m",
    ages:        "2–8 años",
    capacity:    "Se confirma al cotizar",
    highlight:   false,
    tag:         "Colores vibrantes",
    tagColor:    "blue",
    ideal:       "Fiestas tropical, colores vivos, exteriores",
    image:       "/img/inflables/gusanitos.avif",
  },
  {
    slug:        "barco-pirata",
    name:        "Barco Pirata",
    category:    "Grande",
    price:       2300,
    size:        "6×3.5×3.80 m",
    ages:        "3–12 años",
    capacity:    "Se confirma al cotizar",
    highlight:   false,
    tag:         "Alto impacto",
    tagColor:    "blue",
    ideal:       "Kermeses, cumpleaños grandes, eventos escolares",
    image:       "/img/inflables/barco-pirata.avif",
  },
  {
    slug:        "castillo-blanco",
    name:        "Castillo Blanco",
    category:    "Grande",
    price:       2600,
    size:        "5×7×4 m",
    ages:        "3–12 años",
    capacity:    "Se confirma al cotizar",
    highlight:   false,
    tag:         "Elegante y formal",
    tagColor:    "purple",
    ideal:       "Bodas, XV años, eventos formales, garden parties",
    image:       "/img/inflables/castillo-blanco.avif",
  },
  {
    slug:        "extremo",
    name:        "Extremo",
    category:    "Extremo",
    price:       2500,
    size:        "8×4.5×3.50 m",
    ages:        "3–12 años",
    capacity:    "Se confirma al cotizar",
    highlight:   false,
    tag:         "Para teens y adultos",
    tagColor:    "orange",
    ideal:       "Team building, kermeses, eventos corporativos",
    image:       "/img/inflables/extremo.avif",
  },
];

const tagColors: Record<string, { bg: string; text: string }> = {
  primary: { bg: "#FEF2F2", text: "#C81E1E" },   // #DC2626 daba 4.41:1
  green:   { bg: "#F0FDF4", text: "#15803D" },
  pink:    { bg: "#FDF2F8", text: "#9D174D" },
  blue:    { bg: "#EFF6FF", text: "#1D4ED8" },
  purple:  { bg: "#F5F3FF", text: "#6D28D9" },
  orange:  { bg: "#FFF7ED", text: "#C2410C" },
};

const includes = [
  { icon: "🚚", label: "Entrega a domicilio",     desc: "Llevamos el inflable a tu domicilio; el envío depende de tu zona y te lo decimos al cotizar." },
  { icon: "🔧", label: "Instalación profesional", desc: "Nuestro equipo monta el inflable en 15 a 30 minutos, según el modelo." },
  { icon: "⚡", label: "Motor inflador",           desc: "Motor silencioso de inflado continuo e instalación eléctrica incluidos." },
  { icon: "🧼", label: "Limpieza documentada",     desc: "Cada inflable se desinfecta con protocolo propio antes de entregarse." },
  { icon: "📦", label: "Recolección",              desc: "Al finalizar el evento recogemos todo. Tú no tienes que hacer nada." },
];

const factores = [
  {
    titulo:  "Zona de entrega",
    desc:    "El traslado no tiene costo en Roma, Polanco, Narvarte, Doctores, Santa María la Ribera, Reforma y algunas zonas de Iztapalapa y Xochimilco. En el resto de la CDMX va de $100 a $300 donde hay monto publicado, y en el Estado de México de $150 a $600 según el municipio.",
    icono:   "📍",
  },
  {
    titulo:  "Duración del evento",
    desc:    "El precio estándar cubre un evento completo de 4 a 6 horas. Si necesitas el inflable por más tiempo, escríbenos por WhatsApp y te cotizamos la extensión.",
    icono:   "⏱️",
  },
  {
    titulo:  "Temporada y disponibilidad",
    desc:    "En temporada alta (Semana Santa, vacaciones de verano, noviembre–diciembre) la demanda es mayor. Te recomendamos reservar con 2 a 3 semanas de anticipación para garantizar disponibilidad.",
    icono:   "📅",
  },
  {
    titulo:  "Número de inflables",
    desc:    "Al rentar 2 o más inflables para el mismo evento aplican descuentos por volumen. Consulta nuestros paquetes para eventos o escríbenos para una cotización personalizada.",
    icono:   "🎪",
  },
];

const faqs = [
  {
    question: "¿Cuánto cuesta rentar un inflable?",
    answer:   "De $1,400 a $2,600 MXN por evento de 4 a 6 horas. El Castillo Baby cuesta $1,400; Dragones Rojos, Jungla y Gusanitos, $1,600; Castillo de Princesas, $1,800; Barco Pirata, $2,300; Extremo, $2,500, y Castillo Blanco, $2,600. Todos incluyen instalación, motor, sanitización y recolección; el envío se suma según la zona.",
  },
  {
    question: "¿Cuánto cuesta rentar un brincolín grande?",
    answer:   "Los tres modelos grandes cuestan entre $2,300 y $2,600 MXN por evento: Barco Pirata $2,300 (6×3.5×3.80 m, tobogán), Extremo $2,500 (8×4.5×3.50 m, obstáculos) y Castillo Blanco $2,600 (5×7×4 m, bodas y XV años). El precio es por evento completo de 4 a 6 horas e incluye instalación, motor y recolección; el traslado se confirma según zona.",
  },
  {
    question: "¿Cuánto se cobra por la renta de un inflable para fiesta infantil?",
    answer:   "Para una fiesta infantil, el modelo se elige según la edad, el espacio y la fecha: Dragones Rojos cuesta $1,600, Castillo de Princesas $1,800 y Castillo Baby $1,400. No cobramos el motor ni la instalación por separado.",
  },
  {
    question: "¿Los precios publicados incluyen todo o hay costos adicionales?",
    answer:   "Incluyen instalación, motor inflador, extensión eléctrica, sanitización y recolección al finalizar. Pueden sumarse dos cosas: el envío de tu zona y el 16% de IVA si necesitas factura. Ambas te las decimos por escrito antes de que apartes la fecha, nunca el día del evento.",
  },
  {
    question: "¿Cuánto cuesta el envío según la zona?",
    answer:   "Es sin costo en Roma, Polanco, Narvarte, Doctores, Santa María la Ribera, Reforma y algunas zonas de Iztapalapa y Xochimilco. En la CDMX, Iztapalapa y Xochimilco van de $100 a $150, Tláhuac de $100 a $200 y Milpa Alta de $200 a $300; en el Estado de México el envío va de $150 a $600 según el municipio. El precio del inflable no cambia con la zona.",
  },
  {
    question: "¿Hay descuento si rento más de un inflable?",
    answer:   "Sí. Al rentar 2 o más inflables para el mismo evento aplicamos precios preferenciales. El total depende de los modelos que elijas y del tamaño del evento, así que lo cotizamos caso por caso. Escríbenos por WhatsApp con los detalles y te enviamos una propuesta con el precio cerrado del paquete.",
  },
  {
    question: "¿Cómo puedo reservar y cuánto anticipo necesito?",
    answer:   "Para reservar tu inflable pedimos un anticipo del 50% del precio total. El saldo restante se paga el día del evento antes de la instalación. Aceptamos transferencia bancaria, efectivo y pago con tarjeta. Una vez realizado el anticipo, tu fecha queda apartada y recibes confirmación por WhatsApp.",
  },
  {
    question: "¿Los precios cambian en temporada alta?",
    answer:   "Nuestros precios por modelo son fijos durante todo el año. Lo que puede verse afectado en temporada alta (Semana Santa, verano, noviembre y diciembre) es la disponibilidad: los fines de semana se agotan rápido. Recomendamos reservar con al menos 2 semanas de anticipación en esas fechas.",
  },
];
---

<PageLayout
  faqContext={{ tipo: "precio" }}
  title={title}
  description={description}
  pageType="page"
  breadcrumbs={[
    { name: "Inicio",   href: "/" },
    { name: "Precios de Inflables" },
  ]}
  faqItems={faqs}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[
      { label: "Inicio", href: "/" },
      { label: "Precios de Inflables" },
    ]} />
  </Fragment>


  <!-- ═══════════════════════════════════════════════════════════
       HERO — KW "precios renta inflables CDMX" · precios visibles de inmediato
  ═══════════════════════════════════════════════════════════ -->
  <section class="hero pr-hero">
    <div class="container">
      <div class="hero__grid">

        <div>
          <span class="hero__badge">Precios transparentes · Sin costos ocultos</span>
          <h1 class="hero__title">
            Precios de <span class="highlight">renta de inflables</span> en CDMX 2026
          </h1>
          <p class="hero__desc">
            Rentar un inflable cuesta de <strong>$1,400 a $2,600 MXN por evento de 4 a 6 horas</strong>, según el modelo.
            El precio incluye entrega, instalación, motor, sanitización y recolección. Aparte se suman el envío de
            tu zona, cuando aplica, y el 16% de IVA solo si necesitas factura.
          </p>
          <div class="hero__ctas">
            <a href="/cotizar/" class="btn btn-primary btn-lg">Cotizar mi inflable</a>
            <a href="/inflables/" class="btn btn-outline btn-lg">Catálogo de inflables</a>
          </div>
        </div>

        <!-- Resumen de precios en hero — ancla cognitiva inmediata -->
        <div class="pr-hero-summary">
          <p class="pr-hero-summary__label">Rango de precios 2026</p>
          <div class="pr-hero-summary__range">
            <div class="pr-hero-summary__item">
              <span class="pr-hero-summary__amount">$1,400</span>
              <span class="pr-hero-summary__note">Castillo Baby (bebés)</span>
            </div>
            <div class="pr-hero-summary__arrow">→</div>
            <div class="pr-hero-summary__item">
              <span class="pr-hero-summary__amount">$2,600</span>
              <span class="pr-hero-summary__note">Castillo Blanco</span>
            </div>
          </div>
          <ul class="pr-hero-summary__includes">
            <li>✓ Instalación de 15 a 30 minutos</li>
            <li>✓ Motor inflador y extensión eléctrica</li>
            <li>✓ Limpieza y sanitización</li>
            <li>✓ Recolección al finalizar</li>
          </ul>
          <a href="/cotizar/" class="btn btn-primary" style="width:100%;text-align:center;">
            Obtener cotización gratis
          </a>
        </div>

      </div>
    </div>
  </section>

  <QuickNav />

  <!-- ═══════════════════════════════════════════════════════════
       TABLA RÁPIDA: respuesta directa a "cuánto cuesta rentar un inflable"
  ═══════════════════════════════════════════════════════════ -->
  <section class="section pr-rapida" id="tabla-de-precios">
    <div class="container">
      <h2 class="pr-rapida__title">Tabla de precios de renta de inflables 2026</h2>
      <p class="pr-rapida__intro">
        Precio por evento de 4 a 6 horas, ordenado de menor a mayor. Las medidas son largo × ancho × alto del inflable;
        la altura libre es la que necesitas sobre el piso para instalarlo.
      </p>
      <div class="pr-rapida__wrap">
        <table class="pr-rapida__tabla">
          <caption class="sr-only">Precio, medidas, edades y altura libre de los {INFLABLES_ACTIVOS.length} inflables en renta</caption>
          <thead>
            <tr>
              <th scope="col">Modelo</th>
              <th scope="col">Precio por evento</th>
              <th scope="col">Medidas</th>
              <th scope="col">Edades</th>
              <th scope="col">Altura libre</th>
              <th scope="col">Bajo techo</th>
            </tr>
          </thead>
          <tbody>
            {INFLABLES_ACTIVOS.map(i => (
              <tr>
                <th scope="row">{i.name}</th>
                <td class="pr-rapida__precio">{i.price} MXN</td>
                <td>{i.size.replace(/×/g, " × ")}</td>
                <td>{i.ages}</td>
                <td>{i.heightClearance}</td>
                <td>{i.indoor ? "Sí" : "No"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="pr-rapida__grid">
        <div class="pr-rapida__box">
          <h3>¿Qué incluye el precio?</h3>
          <ul>
            <li>Entrega a domicilio e instalación de 15 a 30 minutos.</li>
            <li>Motor inflador y extensión eléctrica.</li>
            <li>Sanitización antes de cada evento.</li>
            <li>Recolección al terminar.</li>
          </ul>
        </div>
        <div class="pr-rapida__box">
          <h3>¿Qué se cobra aparte?</h3>
          <ul>
            <li><strong>Envío por zona:</strong> sin costo en Roma, Polanco, Narvarte, Doctores, Santa María la Ribera, Reforma y algunas zonas de Iztapalapa y Xochimilco; de $100 a $300 en otras <a href="/cobertura/cdmx/">alcaldías de la CDMX</a> y de $150 a $600 en los <a href="/cobertura/edomex/">municipios del Estado de México</a>.</li>
            <li><strong>IVA:</strong> 16% solo si necesitas factura.</li>
            <li>Para apartar la fecha se deja un anticipo del 50%; el resto se paga el día del evento.</li>
          </ul>
          <p>¿No sabes si llegamos a tu colonia? Revisa la <a href="/renta-de-inflables-cerca-de-mi/">tabla de envío por zona</a>.</p>
        </div>
      </div>
      <p class="pr-rapida__foot">
        Si estás armando la fiesta completa, la guía de <a href="/blog/cuanto-cuesta-una-fiesta-infantil-cdmx-presupuesto/">cuánto cuesta una fiesta infantil en CDMX</a>
        suma comida, pastel y decoración al precio del inflable. Para confirmar que el modelo cabe en tu espacio, usa la
        <a href="/blog/medidas-de-inflables-para-fiestas-tabla/">tabla de medidas de inflables</a>.
      </p>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════
       TABLA DE PRECIOS POR MODELO — El contenido central de la página
  ═══════════════════════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Precios por modelo"
        title="¿Para qué sirve cada inflable y cuánto cuesta?"
        subtitle="Ficha rápida por modelo: precio, medidas, edades y para qué tipo de fiesta conviene."
        copy1="Si buscas la opción más accesible, la guía de <a href='/renta-de-inflables-economicos/'>inflables económicos</a> explica qué incluye el precio y cuándo no conviene el modelo más barato. Cada precio que ves aquí es el precio neto de la renta: sin cargos por el motor ni cuotas de instalación. Las dos únicas cosas que pueden sumarse son el IVA, si necesitas factura, y el envío de tu zona; ambas te las decimos por escrito antes de que apartes la fecha."
        copy2="Si tienes dudas sobre qué inflable elegir según el espacio disponible, el número de niños o el tipo de evento, escríbenos por WhatsApp y te asesoramos sin compromiso."
      />

      <!-- Cards de precio por modelo -->
      <div class="pr-grid">
        {inflables.map(inf => {
          const tc = tagColors[inf.tagColor] ?? { bg: "#F3F4F6", text: "#374151" };
          return (
            <div class:list={["pr-card", { "pr-card--highlight": inf.highlight }]}>

              {inf.highlight && <div class="pr-card__ribbon">Más rentado</div>}

              <div class="pr-card__img-wrap">
                <img
                  src={inf.image}
                  alt={`Precio renta ${inf.name} CDMX`}
                  width="400" height="225"
                  loading="lazy"
                  class="pr-card__img"
                />
              </div>

              <div class="pr-card__body">
                <div class="pr-card__meta">
                  <span class="pr-card__tag" style={`background:${tc.bg}; color:${tc.text};`}>{inf.tag}</span>
                  <span class="pr-card__category">{inf.category}</span>
                </div>

                <h2 class="pr-card__name">{inf.name}</h2>

                <div class="pr-card__price">
                  <span class="pr-card__amount">${inf.price.toLocaleString('es-MX')}</span>
                  <span class="pr-card__currency">MXN</span>
                  <span class="pr-card__period">/ evento</span>
                </div>

                <div class="pr-card__specs">
                  <div class="pr-card__spec">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1a.75.75 0 01.75.75V6h3.5a.75.75 0 010 1.5h-3.5v3.5a.75.75 0 01-1.5 0V7.5H3.75a.75.75 0 010-1.5h3.5V1.75A.75.75 0 018 1z"/></svg>
                    <span>{inf.size}</span>
                  </div>
                  <div class="pr-card__spec">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 8a3 3 0 100-6 3 3 0 000 6zM12.735 14c.618 0 1.093-.561.872-1.139a6.002 6.002 0 00-11.215 0c-.22.578.254 1.139.872 1.139h9.47z"/></svg>
                    <span>{inf.ages}</span>
                  </div>
                  <div class="pr-card__spec">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/></svg>
                    <span>{inf.capacity}</span>
                  </div>
                </div>

                <p class="pr-card__ideal"><strong>Ideal para:</strong> {inf.ideal}</p>

                <a href={`/inflables/${inf.slug}/`} class="btn btn-outline btn-sm pr-card__btn">
                  {anchorInflable(inf.slug).full} →
                </a>
              </div>

            </div>
          );
        })}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════
       ¿QUÉ INCLUYE EL PRECIO? — Desglose completo
  ═══════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Todo incluido"
        title="¿Qué incluye el precio de renta de un inflable?"
        subtitle="Cada peso que pagas cubre un servicio completo. Sin extras sorpresa al final."
        copy1="Una de las preguntas más frecuentes que recibimos es si el precio incluye el motor y la instalación. La respuesta es sí: el precio del inflable cubre el servicio completo, del montaje a la recolección."
        copy2="Lo que puede sumarse es el envío de tu zona, que en varias colonias céntricas no tiene costo, y el IVA si pides factura. Ambos te los informamos antes de confirmar la reserva, nunca el día del evento."
      />

      <div class="pr-includes">
        {includes.map(item => (
          <div class="pr-include">
            <div class="pr-include__icon" aria-hidden="true">{item.icon}</div>
            <div class="pr-include__body">
              <h3 class="pr-include__label">{item.label}</h3>
              <p class="pr-include__desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════
       FACTORES QUE AFECTAN EL PRECIO
  ═══════════════════════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Transparencia"
        title="¿Qué factores pueden afectar el precio final?"
        subtitle="Zona, duración, temporada y número de inflables."
        copy1="El precio del inflable es el mismo en cualquier zona. Estos son los factores que pueden cambiar el total de tu cotización, y preferimos que los conozcas antes de apartar."
        copy2=""
      />

      <div class="pr-factores">
        {factores.map(f => (
          <div class="pr-factor">
            <div class="pr-factor__icon" aria-hidden="true">{f.icono}</div>
            <div>
              <h3 class="pr-factor__title">{f.titulo}</h3>
              <p class="pr-factor__desc">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════
       PRECIOS PARA EVENTOS CON MÚLTIPLES INFLABLES
  ═══════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Paquetes para eventos"
        title="¿Cuánto cuesta rentar más de un inflable para un evento?"
        subtitle="Kermeses, team building y ferias: precios especiales al rentar 2 o más inflables."
        copy1="Cuando el evento necesita varios inflables simultáneos, el precio por inflable disminuye gracias a nuestros paquetes. A partir de 2 inflables en el mismo evento aplicamos precios preferenciales que incluyen coordinación logística sin costo adicional para eventos de 3 o más equipos."
        copy2=""
      />

      <div class="pr-paquetes">

        <div class="pr-paquete">
          <div class="pr-paquete__header">
            <h3 class="pr-paquete__name">Paquete fiesta bebés</h3>
            <div class="pr-paquete__price">
              <span class="pr-paquete__amount">$2,100</span>
