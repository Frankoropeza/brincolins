---
/**
 * src/pages/cobertura/[slug]/index.astro
 * Plantilla dinámica para las 34 páginas de zona de cobertura.
 * Reemplaza los 34 directorios estáticos — Fase 5.1.
 *
 * AGENTS.md:
 *  ✅ Hero siempre 2 columnas
 *  ✅ H2 como preguntas en páginas GEO
 *  ✅ CTAs → /cotizar/
 *  ✅ CSS scoped
 *  ✅ Cero animaciones de entrada
 */
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import FaqItem from "@/components/FaqItem.astro";
import { COVERAGE_ZONES } from "@/data/coverage";
import {
  INFLABLES_ACTIVOS,
  getInflableBySlug,
  MODELOS_COUNT,
  PRICE_RANGE,
} from "@/data/inflables";
import { SITE_URL } from "@/data/site";
import EnlacesCategoria from "@/components/EnlacesCategoria.astro";
import { categoriasParaZona, anchorEnZona } from "@/data/categorias";

export async function getStaticPaths() {
  return COVERAGE_ZONES.map(zone => ({
    params: { slug: zone.slug },
    props:  { zone },
  }));
}

const { zone } = Astro.props;

/* Nombre para usar dentro de una frase: "en el Estado de México", no
   "en Estado de México". Las zonas normales no declaran zonePhrase. */
const zonePhrase = zone.zonePhrase ?? zone.zone;

/* ── Envío ────────────────────────────────────────────────────────────
   La tarjeta decía "GRATIS · Envío incluido" en las 34 zonas mientras el
   FAQ de 18 de ellas cobraba de $100 a $600. Ahora el importe sale de
   coverage.ts (shippingFee), que es la misma fuente que citan el hero y
   el FAQ: si hay cargo, la tarjeta lo dice. */
const fee     = (zone.shippingFee ?? "").trim();
const hasFee  = fee.length > 0;
const feeLabel = hasFee ? fee : "GRATIS";
const feeTitle = hasFee ? "Costo de envío" : "Costo de envío";
const feeText  = zone.shippingNote ?? (hasFee
  ? `Cargo de envío de ${fee} según la colonia, por la distancia desde nuestro almacén. Instalación y retiro van incluidos en el precio del inflable.`
  : `Envío incluido en el precio para toda la zona ${zonePhrase}. Sin cargos adicionales de flete.`);
const feeGradient = hasFee
  ? "linear-gradient(135deg,#FF6F00,#E65100)"
  : "linear-gradient(135deg,#00C853,#2E7D32)";
const coloniasCopy2 = hasFee
  ? `Si tu colonia está en ${zonePhrase} o en zonas limítrofes, contáctanos. Te confirmamos disponibilidad y el cargo de envío exacto (${fee}) antes de que apartes la fecha.`
  : `Si tu colonia está en ${zonePhrase} o en zonas limítrofes, contáctanos. Es muy probable que podamos atenderte sin costo adicional de envío.`;

/* ── Schema Service con areaServed de la zona ─────────────────────────
   Las páginas de zona heredaban Organization/LocalBusiness/WebSite de
   BaseLayout, pero ninguna declaraba el servicio local que ofrece en su
   alcaldía o municipio. provider referencia el #org global: NO se crea
   un LocalBusiness por zona. */
const canonical = `${SITE_URL}/cobertura/${zone.slug}/`;

/* Enlaces a categorías con anchor localizado. Las 35 páginas de zona eran
   el mayor bloque de páginas del sitio y sólo enlazaban al catálogo plano
   con "Ver inflables": cero señal de keyword hacia ninguna categoría. */
const catsZona = categoriasParaZona(zone.slug).map((c) => ({
  href:   `/inflables/${c.slug}/`,
  anchor: anchorEnZona(c, zonePhrase),
  nota:   c.guiaSub,
}));
catsZona.push({
  href:   "/precios/",
  anchor: `precios de renta de inflables en ${zonePhrase}`,
  nota:   "Tarifas por modelo, cargo de envío y qué incluye cada renta.",
});
const areaName  = zone.areaName ?? zone.zone;
const areaType  = zone.areaType ?? "AdministrativeArea";

const areaServed = {
  "@type": areaType,
  "name":  areaName,...(areaType === "State"
    ? { "containedInPlace": { "@type": "Country", "name": "México" } }
    : zone.areaParent
      ? { "containedInPlace": { "@type": "State", "name": zone.areaParent } }
      : {}),
};

/* Los modelos recomendados de la zona, resueltos contra el catálogo
   canónico para que el precio del schema sea el real de inflables.ts. */
const recModels = zone.inflablesRec.map(r => getInflableBySlug(r.href.replace("/inflables/", "").replace(/\/$/, ""))).filter((i): i is NonNullable<typeof i> => Boolean(i));
const catalog = recModels.length > 0 ? recModels : INFLABLES_ACTIVOS;

const serviceSchema = {
  "@context":    "https://schema.org",
  "@type":       "Service",
  "@id":         `${canonical}#service`,
  "name":        `Renta de inflables en ${areaName}`,
  "serviceType": "Renta de inflables para fiestas infantiles a domicilio",
  "url":         canonical,
  "description": hasFee
    ? `Renta de inflables a domicilio en ${zonePhrase}: entrega, instalación y retiro. Cargo de envío de ${fee} según la colonia. ${MODELOS_COUNT} modelos de ${PRICE_RANGE} MXN.`
    : `Renta de inflables a domicilio en ${zonePhrase}: entrega, instalación y retiro incluidos, sin cargo de envío. ${MODELOS_COUNT} modelos de ${PRICE_RANGE} MXN.`,
  "provider":    { "@id": `${SITE_URL}/#org` },
  "areaServed":  areaServed,
  "availableChannel": {
    "@type":     "ServiceChannel",
    "name":      "Cotización en línea",
    "serviceUrl": `${SITE_URL}/cotizar/`,
    "availableLanguage": { "@type": "Language", "name": "Spanish", "alternateName": "es-MX" },
  },
  "hoursAvailable": {
    "@type":     "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    "opens":     "08:00",
    "closes":    "20:00",
  },
  "offers": {
    "@type":         "AggregateOffer",
    "priceCurrency": "MXN",
    "lowPrice":      String(catalog.reduce((m, i) => Math.min(m, i.priceNumber), Infinity)),
    "highPrice":     String(catalog.reduce((m, i) => Math.max(m, i.priceNumber), 0)),
    "offerCount":    catalog.length,
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name":  `Inflables disponibles en ${areaName}`,
    "itemListElement": catalog.map(i => ({
      "@type":         "Offer",
      "url":           `${SITE_URL}/inflables/${i.slug}/`,
      "price":         String(i.priceNumber),
      "priceCurrency": "MXN",
      "availability":  "https://schema.org/InStock",
      "seller":        { "@id": `${SITE_URL}/#org` },
      /* Sin Product anidado: Google exigía offers/review/aggregateRating
         al Product y marcaba 35 páginas con error de rich results. */
      "name":          `Renta de ${i.name}`,
      "image":         `${SITE_URL}${i.image}`,
      "category":      "Renta de Inflables",
    })),
  },
};
---

<PageLayout
  title={zone.title}
  description={zone.description}
  pageType="page"
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Cobertura", href: "/cobertura/" },
    { name: zone.zone },
  ]}
  faqItems={zone.faqs}
  faqContext={{ tipo: "zona", zona: zonePhrase, envio: zone.shippingFee }}
  schemaMarkup={JSON.stringify(serviceSchema)}
>
  <!-- Breadcrumbs inline -->
  <div class="container">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a><span class="breadcrumbs__sep">/</span>
      <a href="/cobertura/">Cobertura</a><span class="breadcrumbs__sep">/</span>
      <span>{zone.zone}</span>
    </nav>
  </div>

  <!-- ── Hero 2 columnas ──────────────────────────────────────────── -->
  <section class="hero" style="padding:clamp(2rem,4vw,3rem) 0;">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="hero__badge">{zone.badge}</span>
          <h1 class="hero__title">
            Renta de Inflables en <span class="highlight">{zonePhrase}</span>
          </h1>
          <p class="hero__desc">{zone.heroDesc}</p>
          <p class="hero__desc hero__desc--links">Mismo servicio de <a href="/">renta de inflables en CDMX</a> y <a href="/inflables/brincolines/">renta de brincolines</a> de todo el catálogo BRINCOLINS, con entrega en {zonePhrase}.</p>
          <div class="hero__ctas">
            <a href="/cotizar/" class="btn btn-primary btn-lg">Solicitar cotización</a>
            <a href="/inflables/" class="btn btn-outline btn-lg">Ver inflables</a>
          </div>
        </div>
        <div class="hero__copy">
          <p class="hero__copy-text">{zone.heroCopy1}</p>
          <p class="hero__copy-text">{zone.heroCopy2}</p>
        </div>
      </div>
    </div>
  </section>

  <QuickNav />

  <!-- ── Categorías del catálogo con anchor de zona ── -->
  <section class="section">
    <div class="container">
      <EnlacesCategoria
        titulo={`¿Qué inflables rentamos en ${zonePhrase}?`}
        intro={`Entra por la categoría que corresponde a tu evento: cada una lista sólo los modelos que aplican, con medidas, espacio libre necesario y capacidad. Todos con entrega en ${zonePhrase}.`}
        items={catsZona}
      />
    </div>
  </section>

  <!-- ── Zonas hijas (páginas hub: /cobertura/cdmx/ y /cobertura/edomex/) ── -->
  {zone.childZones && zone.childZones.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeader
          badge="Zonas"
          title={zone.childZonesTitle ?? `¿Qué zonas de ${zonePhrase} cubrimos?`}
          subtitle="Cada zona tiene su propia página con colonias, cargo de envío y modelos recomendados."
          copy1={`Estas son todas las zonas de ${zonePhrase} a las que llevamos inflables. En la página de cada una encontrarás las colonias con entrega directa, el cargo de envío exacto y los modelos que mejor funcionan en los espacios de esa zona.`}
          copy2="¿No ves tu zona en la lista? Escríbenos por WhatsApp con tu dirección: cubrimos también colonias limítrofes y te confirmamos disponibilidad y costo en minutos."
        />
        <div class="zone-hub-grid">
          {zone.childZones.map(c => (
            <a href={c.href} class="zone-hub-card">
              <span class="zone-hub-card__name">{c.name}</span>
              <span class="zone-hub-card__note">{c.note}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Colonias ─────────────────────────────────────────────────── -->
  {zone.colonias.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeader
          badge="Colonias"
          title={`¿Qué colonias de ${zonePhrase} cubrimos?`}
          subtitle="Entrega directa en estas colonias y zonas."
          copy1={`Cubrimos toda la zona de ${zonePhrase}, incluyendo colonias residenciales, populares e históricas. Conocemos bien los accesos y particularidades de cada área.`}
          copy2={coloniasCopy2}
        />
        <div class="coverage__badges">
          {zone.colonias.map(c => <span class="coverage__badge">{c}</span>)}
        </div>
      </div>
    </section>
  )}

  <!-- ── Entrega ───────────────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Entrega"
        title={`¿Cómo entregamos en ${zonePhrase}?`}
        subtitle="Puntualidad y trato profesional."
        copy1={`Conocemos la vialidad y los accesos en ${zonePhrase}. Nuestros equipos planifican la ruta con anticipación para llegar a tiempo, sin importar el tipo de colonia o fraccionamiento.`}
        copy2="Para zonas con calles angostas o accesos controlados, coordinamos de antemano. Tu comodidad y la puntualidad de entrega son nuestra prioridad."
      />
      <div class="grid-3" style="max-width:900px;margin:0 auto;">
        <div class="why-card">
          <div class="why-card__img" style={`background:${feeGradient};`}>
            <span class="why-card__img-label" style={hasFee ? "font-size:1.35rem;" : undefined}>{feeLabel}</span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">{feeTitle}</h3>
            <p class="why-card__desc">{feeText}</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background:linear-gradient(135deg,#1565C0,#0288D1);">
            <span class="why-card__img-label">30min</span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Instalación rápida</h3>
            <p class="why-card__desc">El montaje toma de 15 a 30 minutos según el modelo, y llegamos con antelación para que esté listo antes de tu hora.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background:linear-gradient(135deg,#FF3D00,#FF6D00);">
            <span class="why-card__img-label">8-20</span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Atención los 7 días</h3>
            <p class="why-card__desc">WhatsApp de lunes a domingo, de 8:00 a 20:00, para confirmar tu reserva y resolver dudas.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Inflables recomendados ────────────────────────────────────── -->
  {zone.inflablesRec.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeader
          badge="Recomendados"
          title={`¿Qué inflables son ideales para ${zonePhrase}?`}
          subtitle="Selección perfecta para los espacios de esta zona."
          copy1={`En ${zonePhrase} los espacios varían mucho: desde jardines amplios hasta patios más compactos. Tenemos el modelo correcto para cada situación.`}
          copy2="¿No sabes cuál elegir? Mándanos una foto de tu espacio por WhatsApp y te recomendamos el inflable ideal para tu evento."
        />
        <div class="grid-3" style="max-width:900px;margin:0 auto;">
          {zone.inflablesRec.map(rec => (
            <a href={rec.href} class="inflable-rec-card">
              <div class="inflable-rec-card__head" style={`background:${rec.gradient};`}>
                <span class="inflable-rec-card__tag">{rec.tag}</span>
              </div>
              <div class="inflable-rec-card__body">
                <h3 class="inflable-rec-card__name">{rec.name}</h3>
                <p class="inflable-rec-card__desc">{rec.desc}</p>
                <span class="inflable-rec-card__cta">Ver inflable →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── FAQ ──────────────────────────────────────────────────────── -->
  {zone.faqs.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <SectionHeader
          badge="FAQ"
          title={`¿Tienes dudas sobre entrega en ${zonePhrase}?`}
          subtitle="Preguntas frecuentes de clientes en esta zona."
          copy1={`Hemos atendido decenas de eventos en ${zonePhrase} y conocemos las particularidades de cada colonia. Aquí respondemos las dudas más comunes de la zona.`}
          copy2="¿Tienes otra pregunta? Escríbenos por WhatsApp y te respondemos en minutos con todo lo que necesitas para tu evento."
        />
        <div style="max-width:800px;margin:0 auto;">
          {zone.faqs.map(f => <FaqItem question={f.question} answer={f.answer} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ── CTA Banner ────────────────────────────────────────────────── -->
  <CtaBanner
    title={zone.ctaBannerTitle}
    subtitle={zone.ctaBannerSubtitle}
    btnText="Solicitar cotización"
    btnHref="/cotizar/"
    btnSecondaryText="Ver inflables"
    btnSecondaryHref="/inflables/"
    variant={zone.ctaBannerVariant}
  />

  <style>.hero__desc--links { font-size: 0.95rem; margin-top: -0.5rem; }
  .hero__desc--links a { color: inherit; text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
  .inflable-rec-card {
      display: block;
      text-decoration: none;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid rgba(0,0,0,0.08);
      background: var(--color-bg-card, #fff);
      color: inherit;
      transition: box-shadow 0.2s ease;
    }.inflable-rec-card:hover {
      box-shadow: 0 12px 32px rgba(0,0,0,0.12);
    }.inflable-rec-card__head {
      height: 88px;
      display: flex;
      align-items: flex-end;
      padding: 10px 14px;
    }.inflable-rec-card__tag {
      background: rgba(0,0,0,0.3);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 3px 8px;
      border-radius: 20px;
    }.inflable-rec-card__body { padding: 16px; }.inflable-rec-card__name {
      font-size: 1rem;
      font-weight: 700;
      margin: 0 0 6px;
    }.inflable-rec-card__desc {
      font-size: 0.875rem;
      color: var(--color-text-muted, #666);
      line-height: 1.5;
      margin-bottom: 12px;
    }.inflable-rec-card__cta {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-primary, #FF3D00);
    }

    /* ── Zonas hijas de las páginas hub ── */.zone-hub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 12px;
    }.zone-hub-card {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid rgba(0,0,0,0.08);
      background: var(--color-bg-card, #fff);
      text-decoration: none;
      color: inherit;
      transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }.zone-hub-card:hover {
      border-color: var(--color-primary, #FF3D00);
      box-shadow: 0 10px 24px rgba(0,0,0,0.10);
    }.zone-hub-card__name {
      font-family: var(--font-head);
      font-size: 1rem;
      font-weight: 800;
    }.zone-hub-card__note {
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--c-text-muted, #666);
    }
  </style>
</PageLayout>
