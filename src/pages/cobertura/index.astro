---
import { WHATSAPP, SITE_URL } from '../../data/site';
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import ZonaCard from "@/components/ZonaCard.astro";
import { COVERAGE_ZONES } from "@/data/coverage";
import type { CoverageZone } from "@/data/coverage";

const title = "Inflables a domicilio: cobertura en CDMX y Estado de México";
const description = "Renta de inflables en CDMX y Edomex con instalación incluida. Consulta el traslado por colonia y cotiza tu fiesta por WhatsApp.";

const WA = WHATSAPP;
const waBase = `https://wa.me/${WA}?text=`;

/* ── Importe de envío: una sola fuente ────────────────────────────────
   El cargo de cada zona sale de coverage.ts, que es lo que pintan la
   tarjeta de envío y el FAQ de la página de zona. Esta página tenía su
   propia lista escrita a mano y ya había derivado: Naucalpan aparecía
   aquí con "$150–$250" mientras su página de zona prometía entrega
   incluida. Derivarlo hace imposible que vuelvan a separarse. */
const FEE = new Map(COVERAGE_ZONES.map(z => [z.slug, (z.shippingFee ?? "").trim()]));
const envioDe = (slug: string): string => {
  const f = FEE.get(slug);
  if (f === undefined) throw new Error(`Zona sin ficha en coverage.ts: ${slug}`);
  return f === "" ? "Incluido" : f;
};

const alcaldias = [
  { slug: "alvaro-obregon", name: "Álvaro Obregón",       description: "Entregamos en Santa Fe, San Ángel, Pedregal y todo Álvaro Obregón con instalación incluida.",       colonias: ["Santa Fe", "San Ángel", "Pedregal", "Lomas Altas"] },
  { slug: "azcapotzalco", name: "Azcapotzalco",          description: "Cobertura total en Del Gas, Clavería, Pasteros y colonias industriales de Azcapotzalco.",           colonias: ["Del Gas", "Clavería", "Pasteros", "Santa Bárbara"] },
  { slug: "benito-juarez", name: "Benito Juárez",          description: "Zona más solicitada. Del Valle, Narvarte, Nápoles y Portales con entrega sin costo adicional.",    colonias: ["Del Valle", "Narvarte", "Nápoles", "Portales"] },
  { slug: "coyoacan", name: "Coyoacán",               description: "Renta de inflables en Coyoacán Centro, Pedregal, Villa Coapa, Copilco y colonias aledañas.",        colonias: ["Coyoacán Centro", "Pedregal", "Villa Coapa", "Copilco"] },
  { slug: "cuajimalpa", name: "Cuajimalpa",             description: "Cubrimos Santa Fe, Cuajimalpa Centro, Contadero y El Molinito con entrega a la hora acordada.",        colonias: ["Santa Fe", "Cuajimalpa Centro", "Contadero", "El Molinito"] },
  { slug: "cuauhtemoc", name: "Cuauhtémoc",            description: "Centro Histórico, Roma, Condesa y Juárez: entrega rápida en el corazón de la Ciudad de México.",   colonias: ["Centro Histórico", "Roma Norte", "Condesa", "Juárez"] },
  { slug: "gustavo-a-madero", name: "Gustavo A. Madero",      description: "Inflables en Lindavista, Vallejo, Tepeyac, La Villa y toda la alcaldía de GAM.",                   colonias: ["Lindavista", "Vallejo", "Tepeyac", "Aragón"] },
  { slug: "iztacalco", name: "Iztacalco",              description: "Entrega en Pantitlán, Agrícola Oriental, Granjas México y colonias de Iztacalco.",                  colonias: ["Pantitlán", "Agrícola Oriental", "Granjas México", "Viaducto"] },
  { slug: "iztapalapa", name: "Iztapalapa",             description: "Renta de inflables en Ermita, UAM, Santa Martha y todas las colonias de Iztapalapa.",               colonias: ["Ermita Iztapalapa", "UAM", "Santa Martha", "Peñón"] },
  { slug: "magdalena-contreras", name: "Magdalena Contreras",    description: "Llegamos a La Magdalena, San Jerónimo, Barranca del Muerto y colonias de la delegación.",         colonias: ["La Magdalena", "San Jerónimo", "Barranca del Muerto", "El Rosal"] },
  { slug: "miguel-hidalgo", name: "Miguel Hidalgo",         description: "Polanco, Lomas de Chapultepec, Anzures y las colonias más exclusivas de la ciudad.",               colonias: ["Polanco", "Lomas de Chapultepec", "Tacuba", "Anzures"] },
  { slug: "milpa-alta", name: "Milpa Alta",             description: "Cobertura en Milpa Alta Centro, San Pedro Atocpan y San Pablo Oztotepec con programación.",        colonias: ["Milpa Alta Centro", "San Pedro Atocpan", "San Pablo Oztotepec", "Villa Milpa Alta"] },
  { slug: "tlahuac", name: "Tláhuac",                description: "Inflables en Tláhuac Centro, La Nopalera, Zapotitla y Los Olivos con entrega programada.",         colonias: ["Tláhuac Centro", "La Nopalera", "Zapotitla", "Los Olivos"] },
  { slug: "tlalpan", name: "Tlalpan",               description: "Villa Coapa, Pedregal de San Nicolás, Ajusco y toda la alcaldía de Tlalpan.",                      colonias: ["Villa Coapa", "Pedregal de San Nicolás", "Topilejo", "Ajusco"] },
  { slug: "venustiano-carranza", name: "Venustiano Carranza",    description: "Jardín Balbuena, Moctezuma, Merced y colonias cercanas al aeropuerto con entrega puntual.",       colonias: ["Jardín Balbuena", "Moctezuma", "Aeropuerto", "Merced"] },
  { slug: "xochimilco", name: "Xochimilco",             description: "Renta de inflables en Xochimilco Centro, San Gregorio, Tulyehualco y Tepepan.",                   colonias: ["Xochimilco Centro", "San Gregorio", "Tulyehualco", "Tepepan"] },
  /* Zona transversal: agrupa el poniente (Polanco y Lomas están en Miguel
     Hidalgo, Santa Fe entre Cuajimalpa y Álvaro Obregón). Sólo se llegaba
     a ella desde el footer. */
  { slug: "polanco", name: "Polanco, Lomas y Santa Fe", description: "Página de la zona poniente: Polanco, Lomas de Chapultepec, Bosques de las Lomas y Santa Fe.",   colonias: ["Polanco", "Lomas de Chapultepec", "Santa Fe", "Bosques de las Lomas"] },
].map(z => ({ ...z, envio: envioDe(z.slug) }));

const municipios = [
  { slug: "naucalpan", name: "Naucalpan",              description: "Satélite, Lomas Verdes, Interlomas y San Rafael: renta de inflables en el municipio más grande del poniente.",  colonias: ["Satélite", "Lomas Verdes", "Interlomas", "San Rafael"] },
  { slug: "tlalnepantla", name: "Tlalnepantla",          description: "Entrega en Tlalnepantla Centro, Las Américas, Vallejo y zona industrial del municipio.",                        colonias: ["Centro", "Las Américas", "Vallejo", "Industrial"] },
  { slug: "ecatepec", name: "Ecatepec",               description: "Ciudad Azteca, San Cristóbal, Las Américas y todo Ecatepec con inflables entregados a domicilio.",              colonias: ["Ciudad Azteca", "Las Américas", "San Cristóbal", "Ecatepec Centro"] },
  { slug: "nezahualcoyotl", name: "Nezahualcóyotl",        description: "Ciudad Neza, Jardines de Morelos, Los Reyes y colonias de Nezahualcóyotl con entrega puntual.",                colonias: ["Ciudad Neza", "Jardines de Morelos", "Los Reyes", "Benito Juárez"] },
  { slug: "huixquilucan", name: "Huixquilucan",           description: "La Herradura, Interlomas, Jesús del Monte: inflables para las zonas residenciales más exclusivas del Edomex.",  colonias: ["Interlomas", "La Herradura", "El Molinito", "Jesús del Monte"] },
  { slug: "atizapan", name: "Atizapán de Zaragoza",   description: "Renta de inflables en Ciudad López Mateos, Rancho Contento y colonias de Atizapán.",                           colonias: ["Cd. López Mateos", "Rancho Contento", "Satélite", "Las Fuentes"] },
  { slug: "cuautitlan-izcalli", name: "Cuautitlán Izcalli",   description: "Izcalli Centro, Hacienda del Parque y Ojo de Agua con entrega programada de inflables.",                        colonias: ["Izcalli Centro", "Hacienda del Parque", "Ojo de Agua", "Cumbria"] },
  { slug: "coacalco", name: "Coacalco",               description: "Coacalco Centro, Bosques de Morelos y La Quebrada con inflables entregados a domicilio.",                       colonias: ["Coacalco Centro", "Bosques de Morelos", "La Quebrada", "San Crisanto"] },
  { slug: "toluca", name: "Toluca",                 description: "Llegamos a Toluca Centro, San Mateo Atenco, Zinacantepec y zonas del Valle de Toluca.",                         colonias: ["Toluca Centro", "San Mateo Atenco", "Zinacantepec", "Almoloya"] },
  { slug: "metepec", name: "Metepec",                description: "Metepec Centro, San Salvador la Gavia y Pilares: inflables para los eventos más elegantes del Valle.",          colonias: ["Metepec Centro", "San Salvador la Gavia", "Pilares", "Coaxustenco"] },
  { slug: "texcoco", name: "Texcoco",               description: "Renta de inflables en Texcoco Centro, San Miguel Coatlinchán y municipios del Oriente.",                        colonias: ["Texcoco Centro", "San Miguel Coatlinchán", "Atenco", "Chiconcuac"] },
  { slug: "chalco", name: "Chalco",                 description: "Chalco Centro, Valle de Chalco y San Gregorio con entrega de inflables a domicilio en el Oriente.",             colonias: ["Chalco Centro", "Valle de Chalco", "San Gregorio", "Tlapala"] },
  { slug: "nicolas-romero", name: "Nicolás Romero",         description: "Ciudad Cuauhtémoc, El Progreso y colonias de Nicolás Romero con servicio de entrega a domicilio.",              colonias: ["Nicolás Romero Centro", "Ciudad Cuauhtémoc", "El Progreso", "La Aurora"] },
  { slug: "tecamac", name: "Tecámac",                description: "Ciudad Real, Real del Sol y Tecámac Centro: inflables con entrega en el norte del Estado de México.",           colonias: ["Ciudad Real", "Real del Sol", "Tecámac Centro", "Ozumbilla"] },
  { slug: "tultitlan", name: "Tultitlán",              description: "San Pablo de las Salinas, Lechería y Tultitlán Centro con inflables entregados en tiempo y forma.",             colonias: ["Tultitlán Centro", "San Pablo de las Salinas", "Lechería", "Buenavista"] },
].map(z => ({ ...z, envio: envioDe(z.slug) }));

/* ── Grupos de envío, calculados desde coverage.ts ───────────────────
   Las tres tarjetas "Zona A / B / C" estaban escritas a mano y listaban
   mal a media docena de municipios (Neza y Atizapán aparecían en el
   grupo de $300–$600 cuando cobran $200–$300). */
const nombreDe = (z: CoverageZone) => z.areaName ?? z.zone;
const pisoDe   = (z: CoverageZone) => Number((z.shippingFee ?? "").split("–")[0].replace(/\D/g, "") || 0);
const topeDe   = (z: CoverageZone) => Number(((z.shippingFee ?? "").split("–")[1] ?? "").replace(/\D/g, "") || 0);

const zonasReales = COVERAGE_ZONES.filter(z => z.slug !== "cdmx" && z.slug !== "edomex");
const sinCargo    = zonasReales.filter(z => !(z.shippingFee ?? "").trim());
const conCargo    = zonasReales.filter(z =>  (z.shippingFee ?? "").trim());
const conMonto    = conCargo.filter(z => /\d/.test(z.shippingFee ?? ""));
const segunZona   = conCargo.filter(z => !/\d/.test(z.shippingFee ?? ""));
const cargoBajo   = conMonto.filter(z => topeDe(z) <= 250);
const cargoAlto   = conMonto.filter(z => topeDe(z) >  250);
/* SSoT v2: zonas sin costo adicional (texto fijo del Excel de Frank, 2026-09-27). */
const ZONAS_SIN_COSTO = "Roma, Polanco, Narvarte, Doctores, Santa María la Ribera, Reforma y algunas zonas de Iztapalapa y Xochimilco";
const rangoDe = (zs: CoverageZone[]) =>
  `$${Math.min(...zs.map(pisoDe))}–$${Math.max(...zs.map(topeDe))} MXN`;
const listaDe = (zs: CoverageZone[]) => zs.map(nombreDe).join(", ");

const faqs = [
  {
    question: "¿El costo de entrega está incluido en el precio del inflable?",
    answer: `La entrega no tiene costo adicional en ${ZONAS_SIN_COSTO}. En el resto de la CDMX y del Estado de México hay un cargo de traslado según la colonia: donde ya está publicado va de $100 (Iztapalapa y Xochimilco fuera de las zonas sin costo) a $600 (Toluca y Metepec), y en las demás alcaldías te lo confirmamos al cotizar, antes de que apartes la fecha.`,
  },
  {
    question: "¿Cuánto tiempo tardan en llegar a mi evento?",
    answer: "Nuestro equipo llega siempre a la hora acordada en la cotización. Para zonas céntricas de CDMX, la instalación toma entre 30 y 60 minutos desde la salida del almacén. Para zonas del Estado de México o alcaldías más alejadas, coordinamos la salida con anticipación para garantizar puntualidad absoluta.",
  },
  {
    question: "¿Puedo reservar si no aparece mi colonia en la lista?",
    answer: "Sí. Las colonias que mostramos son sólo una muestra de nuestra cobertura. Si tu colonia no aparece, escríbenos por WhatsApp con tu dirección completa y verificamos disponibilidad. Normalmente aplica el mismo cargo de envío que la zona a la que pertenece tu colonia.",
  },
  {
    question: "¿Hacen entregas los fines de semana y días festivos?",
    answer: "Sí. Operamos los 7 días de la semana, incluyendo sábados, domingos y días festivos, de 8:00 a 20:00. De hecho, los fines de semana son nuestros días con más eventos. Sólo asegúrate de reservar con anticipación ya que la disponibilidad se llena rápido, especialmente en temporada alta.",
  },
  {
    question: "¿Qué pasa si vivo en una zona sin acceso vehicular o interior de condominio?",
    answer: "No hay problema. Nuestro equipo está preparado para acceder a condominios, unidades habitacionales, jardines privados e incluso lugares con acceso restringido. Sólo indícanos el tipo de acceso al momento de cotizar para coordinar el ingreso correctamente.",
  },
];

/* Un único Service para el hub. El provider referencia el #org global:
   no se declara un LocalBusiness por zona ni un teléfono suelto aquí. */
const schemaLD = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${SITE_URL}/cobertura/#service`,
  "name": "Renta de inflables a domicilio en CDMX y Estado de México",
  "url": `${SITE_URL}/cobertura/`,
  "provider": { "@id": `${SITE_URL}/#org` },
  "areaServed": zonasReales.map(z => ({
    "@type": z.areaType ?? "AdministrativeArea",
    "name":  nombreDe(z),...(z.areaParent ? { "containedInPlace": { "@type": "State", "name": z.areaParent } } : {}),
  })),
  "serviceType": "Renta de inflables para fiestas a domicilio",
  "description": "Entregamos e instalamos inflables en las 16 alcaldías de CDMX y 15 municipios del Estado de México. Traslado sin costo en Roma, Polanco, Narvarte, Doctores, Santa María la Ribera, Reforma y algunas zonas de Iztapalapa y Xochimilco; en el resto de CDMX y del Estado de México el costo de traslado depende de la zona y se confirma al cotizar.",
};
---

<PageLayout
  faqContext={{ tipo: "cerca" }}
  title={title}
  description={description}
  pageType="page"
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Cobertura" }]}
  faqItems={faqs}
  schemaMarkup={JSON.stringify(schemaLD)}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Cobertura"}]} />
  </Fragment>

  <!--═══════════════ HERO ═══════════════ -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <!-- Col izquierda -->
        <div>
          <span class="hero__badge">Cobertura total ZMVM</span>
          <h1 class="hero__title">
            Renta de inflables con <span class="highlight">entrega a domicilio</span> en CDMX y Estado de México
          </h1>
          <p class="hero__desc">
            Cubrimos las <strong>16 alcaldías</strong> de la Ciudad de México y los <strong>15 principales municipios</strong> del Estado de México. Llegamos a tu evento con el inflable instalado y listo.
          </p>

          <div class="hero__ctas">
            <a href="/cotizar/" class="btn btn-primary btn-lg">Consultar mi zona</a>
            <a href="/cotizar/" class="btn btn-outline btn-lg">Solicitar cotización</a>
          </div>
        </div>

        <!-- Col derecha — copy SEO -->
        <div class="hero__copy">
          <p class="hero__copy-text">
            <strong>BRINCOLINS</strong> es la empresa de renta de inflables con mayor cobertura en la <strong>Zona Metropolitana del Valle de México</strong>. Contamos con una flota de transporte especializada y rutas logísticas optimizadas para garantizar entrega puntual en las <strong>16 alcaldías de la Ciudad de México</strong>: desde <strong>Polanco y Condesa</strong> hasta <strong>Xochimilco y Tláhuac</strong>. Incluye instalación profesional, motor inflador, supervisión de seguridad y recolección al finalizar el evento.
          </p>
          <p class="hero__copy-text">
            Para el <strong>Estado de México</strong>, llegamos a <strong>Naucalpan, Tlalnepantla, Ecatepec, Huixquilucan, Nezahualcóyotl, Atizapán, Cuautitlán Izcalli, Metepec y Toluca</strong>, entre otros municipios. Entrega de lunes a domingo, incluyendo días festivos. Reserva con mínimo 24 horas de anticipación y recibe confirmación inmediata vía WhatsApp.
          </p>
        </div>
      </div>
    </div>
  </section>

  <QuickNav />

  <!-- ═══════════════ HUBS CDMX / EDOMEX ═══════════════ -->
  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Empieza aquí"
        title="¿Tu evento es en CDMX o en el Estado de México?"
        subtitle="Dos páginas guía con el mapa completo de cobertura y los cargos de envío."
        copy1="Si no sabes qué zona te toca o quieres comparar cargos de envío antes de elegir modelo, empieza por una de estas dos páginas: agrupan todas las alcaldías y municipios que cubrimos, cada uno con su importe de envío y las colonias con entrega directa."
        copy2="Desde ahí puedes entrar a la página de tu zona, donde están las preguntas frecuentes de esa alcaldía o municipio y los modelos que mejor funcionan en sus espacios."
      />
      <div class="hubs-grid">
        <a href="/cobertura/cdmx/" class="hub-card">
          <span class="hub-card__badge">16 alcaldías</span>
          <h3 class="hub-card__title">Ciudad de México</h3>
          <p class="hub-card__desc">Traslado sin costo en Roma, Polanco, Narvarte, Doctores, Santa María la Ribera, Reforma y algunas zonas de Iztapalapa y Xochimilco. En el resto de las alcaldías el cargo depende de la colonia: de $100 a $300 en Iztapalapa, Xochimilco, Tláhuac y Milpa Alta; en las demás se confirma al cotizar.</p>
          <span class="hub-card__cta">Renta de inflables en CDMX por alcaldía →</span>
        </a>
        <a href="/cobertura/edomex/" class="hub-card">
          <span class="hub-card__badge">15 municipios</span>
          <h3 class="hub-card__title">Estado de México</h3>
          <p class="hub-card__desc">Traslado con costo según zona en los 15 municipios: Naucalpan se cotiza según la colonia; el resto va de $150 en Tlalnepantla y Huixquilucan a $600 en Toluca y Metepec.</p>
          <span class="hub-card__cta">Renta de inflables en Estado de México por municipio →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════ ALCALDÍAS CDMX ═══════════════ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Ciudad de México"
        title="Cobertura en las 16 alcaldías de CDMX"
        subtitle="Las 16 alcaldías, más la página de la zona poniente (Polanco, Lomas y Santa Fe)."
        copy1="Cubrimos las 16 alcaldías de la Ciudad de México sin excepción. En 12 de ellas —Benito Juárez, Cuauhtémoc, Miguel Hidalgo, Coyoacán, Álvaro Obregón, Azcapotzalco, Venustiano Carranza, Cuajimalpa, Gustavo A. Madero, Iztacalco, Tlalpan y La Magdalena Contreras— el costo de entrega está incluido en el precio del inflable. Iztapalapa, Xochimilco, Tláhuac y Milpa Alta tienen un cargo por distancia."
        copy2="Cada alcaldía tiene sus propias colonias y particularidades logísticas. Haz clic en tu alcaldía para ver las colonias con cobertura, el cargo de envío exacto, los tiempos estimados de entrega y los inflables más solicitados en esa zona."
      />

      <div class="grid-4 zonas-grid">
        {alcaldias.map(a => (
          <ZonaCard
            slug={a.slug}
            name={a.name}
            description={a.description}
            colonias={a.colonias}
            envio={a.envio}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ MUNICIPIOS EDOMEX ═══════════════ -->
  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Estado de México"
        title="15 municipios del Estado de México"
        subtitle="También llegamos a los principales municipios del Edomex con entrega programada."
        copy1="Nuestra cobertura en el Estado de México abarca los 15 municipios con mayor densidad de población y actividad económica de la entidad. Desde la zona poniente (Naucalpan, Huixquilucan, Atizapán) hasta la zona oriente (Ecatepec, Nezahualcóyotl, Chalco, Texcoco), llegamos a tu evento con el mismo nivel de servicio."
        copy2="Salvo Naucalpan, que tiene la entrega incluida, los municipios del Edomex llevan un cargo de envío que depende de la distancia desde nuestro almacén en la CDMX: de $150 en Tlalnepantla y Huixquilucan a $600 en Toluca y Metepec. El tiempo de traslado también es mayor, así que coordinamos la salida con 2 o 3 horas de anticipación al inicio del evento."
      />

      <div class="grid-4 zonas-grid">
        {municipios.map(m => (
          <ZonaCard
            slug={m.slug}
            name={m.name}
            description={m.description}
            colonias={m.colonias}
            envio={m.envio}
            tipo="edomex"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ COSTOS DE ENVÍO ═══════════════ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Costos de envío"
        title="¿Cuánto cuesta la entrega?"
        subtitle="Sin costo adicional en zonas seleccionadas de la CDMX. En el resto, cargo de traslado según la colonia."
        copy1={`La entrega no tiene costo adicional en ${ZONAS_SIN_COSTO}. En las demás zonas hay un cargo por distancia: cubre el traslado de ida y vuelta del vehículo con el inflable y el equipo de instalación.`}
        copy2="El importe está publicado en la página de cada zona y te lo confirmamos al cotizar por WhatsApp, antes de que apartes la fecha. Es el único concepto que se suma al precio del inflable: instalación, motor inflador y retiro van incluidos."
      />

      <div class="grid-3 narrow--wide">
        <div class="envio-card">
          <div class="envio-card__icon" aria-hidden="true"></div>
          <h3 class="envio-card__title">Zona A — sin cargo</h3>
          <p class="envio-card__precio">$0 MXN</p>
          <p class="envio-card__desc">{ZONAS_SIN_COSTO}.</p>
        </div>
        <div class="envio-card">
          <div class="envio-card__icon" aria-hidden="true"></div>
          <h3 class="envio-card__title">Zona B — cargo bajo</h3>
          <p class="envio-card__precio">{rangoDe(cargoBajo)}</p>
          <p class="envio-card__desc">{listaDe(cargoBajo)}.</p>
        </div>
        <div class="envio-card">
          <div class="envio-card__icon" aria-hidden="true"></div>
          <h3 class="envio-card__title">Zona C — distancia larga</h3>
          <p class="envio-card__precio">{rangoDe(cargoAlto)}</p>
          <p class="envio-card__desc">{listaDe(cargoAlto)}.</p>
        </div>
      </div>

