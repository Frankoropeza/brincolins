---
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import { INFLABLES_ACTIVOS } from "@/data/inflables";

const title = "Sobre Nosotros — Renta de Inflables en CDMX | BRINCOLINS";
const description = "Conoce BRINCOLINS: +20 años de experiencia en renta de inflables para fiestas infantiles en CDMX y Edomex. Seguridad, puntualidad y flota propia.";

/* Antes cada tarjeta mostraba un bloque de color con las siglas "+20",
   "SEG", "E&I" y "100%". Las dos de en medio son abreviaturas internas que
   nadie fuera del equipo entiende. Ahora la cifra dice algo verificable y
   el dato clave va como pie. */
const diferenciales = [
  { num: "2005",  unit: "año de fundación", gradient: "linear-gradient(135deg, #FF3D00, #FF6D00)", title: "Más de 20 años en el oficio", desc: "Desde 2005 montando fiestas infantiles en la Ciudad de México y el Estado de México. Empezamos con un inflable." },
  { num: "8",     unit: "modelos en flota",  gradient: "linear-gradient(135deg, #7C3AED, #9C27B0)", title: "Flota propia y revisada", desc: "No subcontratamos. Cada inflable se revisa, limpia y sanitiza antes de salir a un evento." },
  { num: "32",    unit: "zonas de entrega",  gradient: "linear-gradient(135deg, #1565C0, #0288D1)", title: "Entrega, montaje y recolección", desc: "Las 16 alcaldías de la CDMX y 16 municipios del Estado de México, con el cargo de envío publicado por zona." },
  { num: "15-30", unit: "min de montaje",    gradient: "linear-gradient(135deg, #00695C, #00897B)", title: "Llegamos antes de tu hora", desc: "El montaje toma de 15 a 30 minutos según el modelo, y llegamos con antelación para que esté listo a tiempo." },
];

const timeline = [
  { year: "2005", text: "Fundamos BRINCOLINS con un solo inflable y la visión de llevar diversión segura a las fiestas infantiles de la Ciudad de México." },
  { year: "2010", text: "Ampliamos la flota y comenzamos a cubrir municipios del Estado de México." },
  { year: "2020", text: "Implementamos protocolos de desinfección reforzados y sistema de reservas en línea." },
  { year: "2026", text: "Operamos 8 modelos y cubrimos las 16 alcaldías de la CDMX y los principales municipios del Estado de México." },
];
---

<PageLayout
  faqContext={{ tipo: "generico" }}
  title={title}
  description={description}
  pageType="page"
  breadcrumbs={[
    { name: "Inicio", href: "/" },
    { name: "Nosotros" },
  ]}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Nosotros"}]} />
  </Fragment>

  <section class="hero" style="padding:clamp(3rem,6vw,5rem) 0;">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="hero__badge">Nuestra historia</span>
          <h1 class="hero__title">Sobre <span class="highlight">BRINCOLINS</span></h1>
          <div class="hero__ctas">
            <a href="/cotizar/" class="btn btn-primary btn-lg">Solicitar cotización</a>
            <a href="/cotizar/" class="btn btn-outline btn-lg">Cotizar ahora</a>
          </div>
        </div>
        <div class="hero__copy">
          <p class="hero__copy-text">
            <strong>BRINCOLINS</strong> nació en 2005 con una misión clara: llevar diversión segura y de calidad a las fiestas infantiles de la Ciudad de México. Lo que comenzó con un solo inflable y mucha pasión, hoy se ha convertido en una de las empresas de renta de inflables más confiables de la zona metropolitana.
          </p>
          <p class="hero__copy-text">
            A lo largo de más de dos décadas, hemos sido parte de miles de cumpleaños, bautizos, días del niño y eventos escolares. Cada fiesta nos motiva a seguir mejorando nuestro servicio y ampliar nuestra oferta de inflables.
          </p>
        </div>
      </div>
    </div>
  </section>

  <QuickNav />

  <section class="section">
    <div class="container">
      <SectionHeader
        badge="La flota"
        title="Los 8 inflables que operamos"
        subtitle="Equipo propio, no subcontratado."
        copy1="Estos son los modelos que salen de nuestra bodega. Los ves aquí tal como llegan a tu evento: cada uno se revisa, se limpia y se sanitiza antes de cargarse a la camioneta."
        copy2="Trabajar con flota propia es lo que nos permite responder por el estado del equipo y por el horario de entrega. Cuando un proveedor subcontrata, ninguna de las dos cosas depende de él."
      />
      <div class="nos-flota">
        {INFLABLES_ACTIVOS.map((inf) => (
          <a href={`/inflables/${inf.slug}/`} class="nos-flota__item">
            <img src={inf.image} alt={`Inflable ${inf.name} de la flota de BRINCOLINS`} width="720" height="480" loading="lazy" decoding="async" />
            <span class="nos-flota__name">{inf.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="grid-3" style="max-width:900px; margin:0 auto;">
        <div style="text-align:center; padding:2rem; background:#fff; border-radius:var(--r-card); border:1px solid var(--c-border);">
          <h3 style="color:var(--c-primary); margin-bottom:.75rem;">Misión</h3>
          <p style="color:var(--c-text-muted); line-height:1.7; font-size:0.9rem;">Brindar momentos de diversión seguros e inolvidables a las familias de CDMX y Edomex, con inflables de calidad y un servicio integral de excelencia.</p>
        </div>
        <div style="text-align:center; padding:2rem; background:#fff; border-radius:var(--r-card); border:1px solid var(--c-border);">
          <h3 style="color:var(--c-secondary); margin-bottom:.75rem;">Visión</h3>
          <p style="color:var(--c-text-muted); line-height:1.7; font-size:0.9rem;">Ser la empresa líder en renta de inflables en la zona metropolitana, reconocida por nuestra seguridad, innovación y atención al cliente.</p>
        </div>
        <div style="text-align:center; padding:2rem; background:#fff; border-radius:var(--r-card); border:1px solid var(--c-border);">
          <h3 style="color:var(--c-green); margin-bottom:.75rem;">Valores</h3>
          <p style="color:var(--c-text-muted); line-height:1.7; font-size:0.9rem;">Seguridad, puntualidad, limpieza, honestidad y compromiso con la diversión de los niños y la tranquilidad de los padres.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Confianza"
        title="¿Por qué elegirnos?"
        subtitle="Lo que nos hace diferentes después de más de 20 años en el mercado."
        copy1="Somos la empresa de renta de inflables con más trayectoria en la Zona Metropolitana del Valle de México. Con más de 20 años en el mercado, hemos perfeccionado cada detalle del servicio."
        copy2="Nuestro compromiso va más allá de entregar un inflable. Cada renta incluye supervisión de seguridad, motor/soplador profesional y un equipo capacitado."
      />
      <div class="grid-4">
        {diferenciales.map(d => (
          <div class="why-card">
            <div class="why-card__img" style={`background: ${d.gradient};`}>
              <span class="why-card__img-label">{d.num}</span>
              <span class="why-card__img-unit">{d.unit}</span>
            </div>
            <div class="why-card__body">
              <h3 class="why-card__title">{d.title}</h3>
              <p class="why-card__desc">{d.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Trayectoria"
        title="Nuestra trayectoria"
        subtitle="Más de dos décadas creciendo junto a las familias de CDMX y Edomex."
        copy1="Desde nuestros inicios con un solo inflable hasta convertirnos en referencia del sector, cada año ha sido un paso más hacia la excelencia en servicio y seguridad para fiestas infantiles."
        copy2="Hoy contamos con 8 modelos de inflables, cobertura en toda la ZMVM y un equipo profesional dedicado a hacer de cada evento una experiencia inolvidable."
      />
      <div style="max-width:600px; margin:0 auto;">
        <div class="timeline">
          {timeline.map(t => (
            <div class="timeline__item">
              <div class="timeline__year">{t.year}</div>
              <p class="timeline__text">{t.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBanner
    title="¿Listo para vivir la experiencia BRINCOLINS?"
    subtitle="Contáctanos y hagamos de tu próxima fiesta un evento inolvidable."
    btnText="Solicitar cotización"
    btnHref="/cotizar/"
    btnSecondaryText="Cotizar ahora"
    btnSecondaryHref="/contacto/"
    variant="vibrant"
  />

</PageLayout>

<style>
  /* Rejilla de flota — /nosotros/ no tenía ni una imagen, siendo la página
     donde se construye la confianza. */.nos-flota {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }.nos-flota__item {
    display: block;
    border: 1px solid var(--c-border);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    text-decoration: none;
    transition: transform .15s ease, border-color .15s ease;
  }.nos-flota__item:hover { transform: translateY(-2px); border-color: var(--c-primary); }.nos-flota__item img {
    display: block;
    width: 100%;
    height: 150px;
    object-fit: cover;
  }.nos-flota__name {
    display: block;
    padding: .7rem .85rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: .9rem;
    color: var(--c-text);
  }.why-card__img-unit {
    display: block;
    margin-top: .2rem;
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .03em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .88);
  }

  @media (max-width: 900px) { .nos-flota { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .nos-flota { grid-template-columns: 1fr; } }
</style>
