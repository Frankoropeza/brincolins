---
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import PricingCards from "@/components/PricingCards.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import DulcesComplementos from "@/components/DulcesComplementos.astro";
import { WHATSAPP } from "@/data/site";
import { EVENTOS, FAQS_GENERALES, BASE_URL, IMG, fmt, enFrase, serviceSchema, type Evento } from "@/data/mesasDeDulces";

export function getStaticPaths() {
  return EVENTOS.map((e) => ({ params: { evento: e.slug }, props: { e } }));
}

const { e } = Astro.props as { e: Evento };
const url = `${BASE_URL}${e.slug}/`;
const desde = e.niveles[0];
const wa = (txt: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(txt)}`;

const packages = e.niveles.map((n, i) => ({
  name: n.nombre,
  badge: i === 1 ? "Más solicitado" : undefined,
  highlight: i === 1,
  price: fmt(n.precio),
  priceNote: `desde · ${n.invitados} ${e.unidad}`,
  description: n.lema,
  features: n.incluye.map((text) => ({ text, included: true })),
  ctaLabel: `Cotizar ${n.nombre}`,
  ctaHref: wa(`Hola, quiero cotizar una mesa de dulces para ${enFrase(e)} (${n.nombre}, ${n.invitados} ${e.unidad}).`),
}));

const faqs = [...e.faqs, ...FAQS_GENERALES.slice(1, 5)];
const otros = EVENTOS.filter((o) => o.slug !== e.slug);
const schema = serviceSchema(`https://brincolins.com${url}`, e.h1, [e]);
---

<PageLayout
  title={e.title}
  description={e.description}
  pageType="page"
  ogImage={`${IMG}/og/${e.img.hero}.jpg`}
  faqItems={faqs}
  faqContext={{ tipo: "servicio", servicio: "dulces" }}
  faqTitle={`Resolvemos tus dudas sobre la mesa de dulces para ${enFrase(e)}`}
  faqSubtitle="Precios, qué incluye, cómo apartar la fecha y quién monta la mesa."
  schemaMarkup={JSON.stringify(schema)}
  breadcrumbs={[
    { name: "Inicio", href: "/" },
    { name: "Servicios", href: "/servicios/" },
    { name: "Mesas de dulces", href: BASE_URL },
    { name: e.nombre },
  ]}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[
      { label: "Inicio", href: "/" },
      { label: "Servicios", href: "/servicios/" },
      { label: "Mesas de dulces", href: BASE_URL },
      { label: e.nombre },
    ]} />
  </Fragment>

  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="hero__badge">Mesa de dulces · {e.nombre}</span>
          <h1 class="hero__title">{e.h1} <span class="highlight">en CDMX</span></h1>
          <p class="hero__desc">{e.intro[0]}</p>
          <p class="hero__desc">{e.intro[1]}</p>
          <div class="hero__ctas">
            <a href={wa(`Hola, quiero cotizar una mesa de dulces para ${enFrase(e)}.`)} class="btn btn-wa btn-lg" target="_blank" rel="noopener">Cotizar por WhatsApp</a>
            <a href="#precios" class="btn btn-outline btn-lg">Ver precios</a>
          </div>
        </div>
        <div class="hero__img-col">
          <div class="hero__img-wrap">
            <img src={`${IMG}/${e.img.hero}.avif`} alt={e.img.alt} class="hero__img" width="1600" height="900" loading="eager" fetchpriority="high" />
            <div class="hero__img-pill hero__img-pill--top">Desde {fmt(desde.precio)} MXN</div>
            <div class="hero__img-pill hero__img-pill--bottom">{desde.invitados} {e.unidad}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <QuickNav />

  <section class="section" id="precios">
    <div class="container">
      <SectionHeader
        badge="Precios"
        title={`¿Cuánto cuesta una mesa de dulces para ${enFrase(e)}?`}
        subtitle={`Tres niveles, de ${fmt(e.niveles[0].precio)} a ${fmt(e.niveles[2].precio)} MXN.`}
        copy1={`El precio depende del número de ${e.unidad} y del nivel de diseño. Esencial resuelve una celebración íntima; Premium agrega backdrop, más variedades y personal durante el evento; Luxury es una mesa de autor con estaciones incluidas.`}
        copy2="Los precios son «desde» y salen del catálogo de nuestro aliado MEDEDUL. La cotización final por WhatsApp confirma variedades, horario, traslado según zona y, si la necesitas, la factura."
      />
      <PricingCards packages={packages} />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="estilo">
        <img src={`${IMG}/${e.img.detalle}.avif`} alt={e.img.altDetalle} width="1600" height="900" loading="lazy" decoding="async" class="estilo__img" />
        <div>
          <span class="section-badge">Diseño</span>
          <h2 class="section-title">¿Qué estilos se pueden pedir para {enFrase(e)}?</h2>
          <p class="estilo__txt">Estos son los estilos más pedidos. Al cotizar puedes mandar una foto de referencia o los colores de tu decoración y la mesa se diseña con esa paleta.</p>
          <ul class="chips">
            {e.estilo.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <DulcesComplementos evento={`la mesa de ${enFrase(e)}`} />

  <section class="section section--alt">
    <div class="container">
      <h2 class="section-title otros__title">¿Buscas una mesa de dulces para otro evento?</h2>
      <ul class="otros">
        <li><a href={BASE_URL}>Todas las mesas de dulces y precios</a></li>
        {otros.map((o) => (
          <li><a href={`${BASE_URL}${o.slug}/`}>Mesa de dulces para {enFrase(o)} · desde {fmt(o.niveles[0].precio)}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBanner
    title={`Cotiza tu mesa de dulces para ${enFrase(e)}`}
    subtitle="Mesa de dulces e inflable en una sola cotización."
    btnText="Cotizar mi evento"
    btnHref="/cotizar/"
    btnSecondaryText="Ver inflables"
    btnSecondaryHref="/inflables/"
    variant="warm"
  />
</PageLayout>

<style>
  .estilo { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: center; }
  .estilo__img { display: block; width: 100%; height: auto; border-radius: var(--r-card); }
  .estilo__txt { margin: 1rem 0 1.25rem; line-height: 1.7; color: var(--c-ink); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li {
    padding: 0.4rem 0.9rem;
    border-radius: var(--r-badge);
    background: var(--c-durazno);
    color: var(--c-ink);
    font-size: 14px;
    font-weight: 600;
  }
  .chips li:nth-child(3n+2) { background: var(--c-menta); }
  .chips li:nth-child(3n+3) { background: var(--c-lila); }
  .otros__title { margin-bottom: 1.5rem; }
  .otros { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem 2rem; }
  .otros a { color: var(--c-primary-text); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 860px) {
    .estilo, .otros { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
