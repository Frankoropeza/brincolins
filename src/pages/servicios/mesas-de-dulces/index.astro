---
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import DulcesComplementos from "@/components/DulcesComplementos.astro";
import DulcesConfianza from "@/components/DulcesConfianza.astro";
import DulcesCotizador from "@/components/DulcesCotizador.astro";
import DulcesCombo from "@/components/DulcesCombo.astro";
import { WHATSAPP } from "@/data/site";
import { EVENTOS, TIPOS, ESTACIONES_PAG, FAQS_GENERALES, BASE_URL, IMG, fmt, enFrase, serviceSchema } from "@/data/mesasDeDulces";

const title = "Mesa de dulces y candy bar en CDMX: precios desde $3,500";
const description = "Mesa de dulces y candy bar en CDMX para cumpleaños, bautizo, baby shower, comunión, XV y boda. Precios desde $3,500 + IVA, montaje incluido.";

/* «mesa de dulces sencilla» es la búsqueda más grande del tema (7.7K, Ahrefs MX nov 2026). */
const FAQ_SENCILLA = {
  question: "¿Hay mesa de dulces sencilla y económica?",
  answer: "Sí: el nivel Esencial. Para un cumpleaños infantil de 15 a 30 niños cuesta desde $3,500 + IVA e incluye de 8 a 10 variedades, temática, cristalería, montaje y empaque de sobrantes. Está pensada para fiestas íntimas en casa.",
};

const minimo = Math.min(...EVENTOS.map((e) => e.niveles[0].precio));
const maximo = Math.max(...EVENTOS.map((e) => e.niveles[2].precio));
const wa = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent("Hola, quiero cotizar una mesa de dulces.")}`;
const schema = serviceSchema(`https://brincolins.com${BASE_URL}`, "Mesa de dulces en CDMX", [...EVENTOS, ...TIPOS, ...ESTACIONES_PAG]);
const grupos = [
  { id: "tipos", badge: "Tipos de mesa", titulo: "¿Qué otros tipos de mesa hay?", sub: "Frutas, postres, quesos, botanas, dulces mexicanos y donas.", items: TIPOS },
  { id: "estaciones", badge: "Estaciones", titulo: "¿Qué estaciones se pueden rentar?", sub: "Fuentes, pared de dulces y stand para pastel, con o sin mesa.", items: ESTACIONES_PAG },
];

const incluye = [
  { t: "Diseño en tu paleta", d: "Colores, temática y etiquetas con el nombre del festejado." },
  { t: "Mesa y montaje", d: "Mesa, mantelería, bases y cristalería; el equipo monta antes de que lleguen los invitados." },
  { t: "Dulces seleccionados", d: "De 8 a más de 20 variedades según el nivel, con opciones para alergias." },
  { t: "Desmontaje y sobrantes", d: "Al terminar se desmonta todo y los dulces que sobran son tuyos." },
];

const porque = [
  { t: "Sabes el precio desde hoy", d: "Cada evento y cada nivel tiene su precio publicado. No hay que pedir cotización para saber si te alcanza." },
  { t: "Se adapta a tu evento", d: "Paleta, temática y etiquetas con el nombre del festejado. Desde Premium recibes backdrop y una propuesta visual." },
  { t: "Nadie de tu familia trabaja", d: "Montaje antes de la fiesta, reposición durante el evento desde Premium y desmontaje al cierre." },
];

const pasos = [
  { t: "Cuéntanos tu evento", d: "Tipo de fiesta, fecha, número de invitados, colonia y temática." },
  { t: "Recibe la cotización", d: "Nivel recomendado, precio y, si lo quieres, el inflable en la misma propuesta." },
  { t: "Aparta con 50%", d: "El anticipo confirma la fecha; las condiciones quedan por escrito." },
  { t: "Montaje el día del evento", d: "El equipo llega antes de la celebración, monta y desmonta al cierre." },
];
---

<PageLayout
  title={title}
  description={description}
  pageType="page"
  ogImage={`${IMG}/og/hub-hero.jpg`}
  faqItems={[...FAQS_GENERALES.slice(0, 1), FAQ_SENCILLA, ...FAQS_GENERALES.slice(1)]}
  faqContext={{ tipo: "servicio", servicio: "dulces" }}
  faqTitle="Resolvemos tus dudas sobre mesas de dulces"
  faqSubtitle="Precios, qué incluye, cómo apartar la fecha y quién monta la mesa."
  schemaMarkup={JSON.stringify(schema)}
  breadcrumbs={[
    { name: "Inicio", href: "/" },
    { name: "Servicios", href: "/servicios/" },
    { name: "Mesas de dulces" },
  ]}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Servicios", href: "/servicios/" }, { label: "Mesas de dulces" }]} />
  </Fragment>

  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="hero__badge">Mesas de dulces</span>
          <h1 class="hero__title">Mesa de dulces en CDMX, <span class="highlight">lista antes que tus invitados</span></h1>
          <p class="hero__desc">
            Tú eliges el evento y los colores. El equipo llega antes, monta la mesa, la repone durante la fiesta y al final te
            empaca los dulces que sobraron. Precios publicados desde {fmt(minimo)} + IVA, y una sola cotización junto con tu inflable.
          </p>
          <div class="hero__ctas">
            <a href={wa} class="btn btn-wa btn-lg" target="_blank" rel="noopener">Cotizar mi mesa por WhatsApp</a>
            <a href="#cotizador" class="btn btn-outline btn-lg">Calcular mi precio</a>
          </div>
        </div>
        <div class="hero__img-col">
          <div class="hero__img-wrap">
            <img src={`${IMG}/hub-hero.avif`} alt="Mesa de dulces con flores durazno y bomboneras de cristal en un jardín de CDMX" class="hero__img" width="1600" height="900" loading="eager" fetchpriority="high" />
            <div class="hero__img-pill hero__img-pill--top">Desde {fmt(minimo)} + IVA</div>
            <div class="hero__img-pill hero__img-pill--bottom">{EVENTOS.length + TIPOS.length + ESTACIONES_PAG.length} servicios</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <DulcesConfianza />

  <QuickNav />

  <section class="section" id="precios">
    <div class="container">
      <SectionHeader
        badge="Precios"
        title="¿Cuánto cuesta una mesa de dulces en CDMX?"
        subtitle={`De ${fmt(minimo)} a ${fmt(maximo)} MXN más IVA, según el evento y el número de invitados.`}
        copy1="Cada evento tiene tres niveles. Esencial resuelve una celebración íntima; Premium agrega backdrop, más variedades y personal que repone la mesa; Luxury es una mesa de autor con estaciones incluidas."
        copy2="Los precios son «desde», más IVA, y salen del catálogo de nuestro aliado MEDEDUL. La cotización confirma variedades, horario y traslado según zona."
      />
      <div class="tabla-wrap">
        <table class="tabla">
          <caption class="tabla__nota">Precios «desde» en MXN, más IVA, por evento y número de invitados.</caption>
          <thead>
            <tr>
              <th scope="col">Evento</th>
              <th scope="col">Esencial</th>
              <th scope="col">Premium</th>
              <th scope="col">Luxury</th>
            </tr>
          </thead>
          <tbody>
            {EVENTOS.map((e) => (
              <tr>
                <th scope="row"><a href={`${BASE_URL}${e.slug}/`}>{e.nombre}</a></th>
                {e.niveles.map((n) => (
                  <td><strong>{fmt(n.precio)}</strong><span>{n.invitados} {e.unidad}</span></td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <DulcesCotizador />

  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Eventos"
        title="¿Para qué evento es tu mesa de dulces?"
        subtitle="Cada evento tiene su paleta, sus símbolos y sus propios niveles."
        copy1="Un cumpleaños infantil pide temática y bolos; un bautizo o una comunión, blanco con dorado y símbolos religiosos; una boda o unos XV, cristalería, backdrop floral y repostería fina."
        copy2="Entra a tu evento para ver qué incluye cada nivel, los estilos más pedidos y las preguntas frecuentes."
      />
      <div class="ev-grid">
        {EVENTOS.map((e) => (
          <a href={`${BASE_URL}${e.slug}/`} class="ev">
            <img src={`${IMG}/${e.img.hero}.avif`} alt={e.img.alt} width="1600" height="900" loading="lazy" decoding="async" class="ev__img" />
            <div class="ev__body">
              <h3 class="ev__title">Mesa de dulces para {enFrase(e)}</h3>
              <p class="ev__price">Desde <strong>{fmt(e.niveles[0].precio)}</strong> + IVA · {e.niveles[0].invitados} {e.unidad}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="inc">
        <img src={`${IMG}/hub-detalle.avif`} alt="Bomboneras de cristal tallado con malvaviscos, almendras confitadas y chocolates" width="1600" height="900" loading="lazy" decoding="async" class="inc__img" />
        <div>
          <span class="section-badge">Qué incluye</span>
          <h2 class="section-title">¿Qué incluye una mesa de dulces?</h2>
          <ul class="inc__list">
            {incluye.map((i) => <li><strong>{i.t}.</strong> {i.d}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {grupos.map((g, gi) => (
    <section class={gi === 0 ? "section" : "section section--alt"} id={g.id}>
      <div class="container">
        <div class="grp-head">
          <span class="section-badge">{g.badge}</span>
          <h2 class="section-title">{g.titulo}</h2>
          <p class="section-subtitle">{g.sub}</p>
        </div>
        <div class="ev-grid">
          {g.items.map((e) => (
            <a href={`${BASE_URL}${e.slug}/`} class="ev">
              <img src={`${IMG}/${e.img.hero}.avif`} alt={e.img.alt} width="1600" height="900" loading="lazy" decoding="async" class="ev__img" />
              <div class="ev__body">
                <h3 class="ev__title">{e.nombre}</h3>
                <p class="ev__price">Desde <strong>{fmt(e.niveles[0].precio)}</strong> + IVA · {e.niveles[0].invitados} {e.unidad}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Por qué con nosotros"
        title="¿Por qué contratar la mesa de dulces con BRINCOLINS?"
        subtitle="Porque organizar una fiesta ya es suficiente trabajo."
        copy1="Una fiesta suele juntar a tres o cuatro proveedores que no se conocen: cada uno con su horario, su anticipo y su número de WhatsApp. El día del evento, alguien tiene que coordinarlos."
        copy2="Aquí la mesa de dulces la monta un equipo especializado y el inflable el nuestro, pero tú hablas con un solo contacto y recibes una sola propuesta."
      />
      <div class="pq">
        {porque.map((p) => (
          <div class="pq__item">
            <h3 class="pq__t">{p.t}</h3>
            <p class="pq__d">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <DulcesComplementos sinEstaciones aliadoAlt />

  <DulcesCombo alt={false} />

  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Proceso"
        title="¿Cómo se contrata la mesa de dulces?"
        subtitle="Todo por WhatsApp, en una sola conversación."
        copy1="Escríbenos con la fecha y el tipo de evento. Si también rentas un inflable, va en la misma cotización y los dos equipos se coordinan para el mismo día."
        copy2="Para bodas en temporada alta conviene reservar con 3 a 6 meses de anticipación; para otras fechas, pregunta disponibilidad."
      />
      <ol class="pasos">
        {pasos.map((p, i) => (
          <li class="paso">
            <span class="paso__n">{i + 1}</span>
            <h3 class="paso__t">{p.t}</h3>
            <p class="paso__d">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBanner
    title="Cotiza tu mesa de dulces"
    subtitle="Mesa de dulces e inflable en una sola cotización."
    btnText="Cotizar mi evento"
    btnHref="/cotizar/"
    btnSecondaryText="Ver inflables"
    btnSecondaryHref="/inflables/"
    variant="warm"
  />
</PageLayout>

<style>
  .tabla-wrap { overflow-x: auto; border-radius: var(--r-card); box-shadow: var(--shadow-md); background: #fff; }
  .tabla { width: 100%; border-collapse: collapse; min-width: 560px; }
  .tabla th, .tabla td { padding: 1rem 1.25rem; text-align: left; border-bottom: 1px solid rgba(0, 0, 0, 0.07); }
  .tabla thead th { background: var(--c-durazno); color: var(--c-ink); font-size: 14px; }
  .tabla tbody th a { color: var(--c-ink); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .tabla td strong { display: block; color: var(--c-primary-text); font-size: 1.05rem; }
  .tabla td span { font-size: 13px; color: var(--c-ink); opacity: 0.75; }
  .tabla tbody tr:last-child > * { border-bottom: 0; }
  .tabla__nota { caption-side: bottom; padding: 0.85rem 1.25rem; font-size: 13px; text-align: left; color: var(--c-ink); }

  .grp-head { margin-bottom: 2rem; max-width: 46rem; }
  .ev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .ev {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: var(--r-card);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    color: var(--c-ink);
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .ev:hover { transform: translateY(-3px); }
  .ev__img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .ev__body { padding: 1.1rem 1.25rem 1.3rem; }
  .ev__title { margin: 0 0 0.35rem; font-size: 1.1rem; }
  .ev__price { margin: 0; font-size: 14px; }
  .ev__price strong { color: var(--c-primary-text); }

  .inc { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: center; }
  .inc__img { display: block; width: 100%; height: auto; border-radius: var(--r-card); }
  .inc__list { margin: 1.25rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.9rem; }
  .inc__list li { line-height: 1.6; color: var(--c-ink); padding-left: 1.1rem; border-left: 3px solid var(--c-menta); }

  .pq { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .pq__item { background: #fff; border-radius: var(--r-card); padding: 1.5rem; box-shadow: var(--shadow-md); border-top: 4px solid var(--c-primary-deep); }
  .pq__t { margin: 0 0 0.5rem; font-size: 1.1rem; color: var(--c-ink); }
  .pq__d { margin: 0; line-height: 1.6; color: var(--c-ink); }

  .pasos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .paso { background: #fff; border-radius: var(--r-card); padding: 1.5rem; box-shadow: var(--shadow-md); }
  .paso__n {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--c-primary-deep);
    color: #fff;
    font-weight: 800;
  }
  .paso__t { margin: 0.9rem 0 0.4rem; font-size: 1.05rem; color: var(--c-ink); }
  .paso__d { margin: 0; line-height: 1.6; color: var(--c-ink); }

  @media (max-width: 1024px) {
    .grp-head { margin-bottom: 2rem; max-width: 46rem; }
  .ev-grid { grid-template-columns: repeat(2, 1fr); }
    .pasos { grid-template-columns: repeat(2, 1fr); }
    .pq { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .ev-grid, .pasos, .inc { grid-template-columns: 1fr; gap: 1.25rem; }
  }
  @media (max-width: 860px) {
    .inc { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
