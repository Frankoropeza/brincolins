---
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import FaqItem from "@/components/FaqItem.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Gallery4x4 from "@/components/Gallery4x4.astro";
import PricingCards from "@/components/PricingCards.astro";

const title = "Paquetes de Fiesta Todo Incluido en CDMX";
const description = "Paquetes de fiesta en CDMX: inflable + mesa infantil + pintacaritas. Dos opciones con precio cerrado y un solo proveedor.";

const galleryImages = [
  { src: "/img/inflables/castillo-blanco-vista-frontal-evento.avif", alt: "Paquete de fiesta completo con inflable Castillo Blanco" },
  { src: "/img/inflables/extremo-evento-corporativo-exterior.avif", alt: "Paquete de fiesta con inflable y mobiliario" },
  { src: "/img/inflables/castillo-princesas-salon-cumpleanos.avif", alt: "Paquete de fiesta infantil con Castillo de Princesas" },
  { src: "/img/inflables/barco-pirata-vista-lateral-evento.avif", alt: "Paquete de fiesta con inflable y mobiliario" },
  { src: "/img/servicios/paquetes-fiesta-completo-cdmx.avif", alt: "Paquete todo incluido con inflable y mobiliario CDMX" },
  { src: "/img/inflables/mini-castillo-salon-bebe-renta.avif", alt: "Paquete con Castillo Baby para fiestas" },
  { src: "/img/inflables/gusanitos-cumpleanos-infantil-cdmx.avif", alt: "Paquete infantil con Gusanitos y mesas" },
  { src: "/img/inflables/mini-jungla-cumpleanos-aventura-cdmx.avif", alt: "Paquete completo con Jungla y decoración" },
];

const pricingPackages = [
  {
    name: "Paquete fiesta",
    price: "$2,800",
    priceNote: "precio cerrado",
    description: "Incluye un inflable Jungla o Dragones Rojos, una mesa con 10 sillitas y pintacaritas durante 1 hora.",
    features: [
      { text: "Jungla o Dragones Rojos", included: true },
      { text: "1 mesa con 10 sillitas", included: true },
      { text: "Pintacaritas durante 1 hora", included: true },
      { text: "Instalación incluida; entrega según zona", included: true },
      { text: "Recolección incluida", included: true },
      { text: "Precio cerrado", included: true },
    ],
    ctaHref: "/contacto/",
  },
  {
    name: "Paquete fiesta bebés",
    badge: "Para bebés",
    highlight: true,
    price: "$2,100",
    priceNote: "precio cerrado",
    description: "Incluye un Castillo Baby, una mesa con 4 sillitas y pintacaritas para 4 niños.",
    features: [
      { text: "Castillo Baby", included: true },
      { text: "1 mesa con 4 sillitas", included: true },
      { text: "Pintacaritas para 4 niños", included: true },
      { text: "Instalación incluida; entrega según zona", included: true },
      { text: "Recolección incluida", included: true },
      { text: "Precio cerrado", included: true },
    ],
    ctaHref: "/contacto/",
  },
];

const faqs = [
  { question: "¿Qué ventaja tiene un paquete frente a rentar todo por separado?", answer: "Con un paquete contratas a un solo proveedor que coordina inflable, mobiliario y pintacaritas: un solo contacto, un solo pago y un precio cerrado desde el inicio. Nosotros nos encargamos del transporte, la instalación, los horarios y la recolección, en lugar de que tú tengas que cuadrar varios proveedores el día de tu evento." },
  { question: "¿Puedo personalizar un paquete?", answer: "Puedes confirmar al cotizar si necesitas una configuración distinta. Los paquetes publicados incluyen los elementos indicados: inflable, mesa con sillitas y pintacaritas." },
  { question: "¿Qué diferencia hay entre el paquete fiesta y el paquete fiesta bebés?", answer: "El paquete fiesta incluye Jungla o Dragones Rojos, una mesa con 10 sillitas y pintacaritas durante 1 hora. El paquete fiesta bebés incluye Castillo Baby, una mesa con 4 sillitas y pintacaritas para 4 niños." },
  { question: "¿Los paquetes tienen algún límite de invitados?", answer: "El mobiliario incluido es una mesa con 10 sillitas en el paquete fiesta o una mesa con 4 sillitas en el paquete fiesta bebés. Si necesitas una configuración distinta, confírmala al cotizar." },
];
---

<PageLayout
  faqContext={{ tipo: "servicio", servicio: "paquetes" }}
  title={title}
  description={description}
  pageType="page"
  breadcrumbs={[
    { name: "Inicio", href: "/" },
    { name: "Servicios", href: "/servicios" },
    { name: "Paquetes de Fiesta" },
  ]}
  faqItems={faqs}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Servicios",href:"/servicios/"},{label:"Paquetes de Fiesta"}]} />
  </Fragment>

  <!-- HERO 2 columnas -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="hero__badge">Paquetes</span>
          <h1 class="hero__title">Paquetes de Inflables para Fiestas — <span class="highlight">Todo Incluido</span></h1>
          <p class="hero__desc">Inflable, mobiliario y pintacaritas en un solo paquete con precio cerrado. Elige entre paquete fiesta y paquete fiesta bebés.</p>
        </div>
        <div class="hero__copy">
          <p class="hero__copy-text">Organizar una fiesta infantil puede ser abrumador cuando tienes que coordinar múltiples proveedores. Con los paquetes de fiesta de BRINCOLINS, resuelves todo en un solo lugar: inflable, mesa infantil, sillitas y pintacaritas. Un solo contacto, un solo pago y la tranquilidad de saber que todo está coordinado.</p>
          <p class="hero__copy-text">Ofrecemos dos paquetes con necesidades distintas: el paquete fiesta con Jungla o Dragones Rojos, y el paquete fiesta bebés con Castillo Baby. Cada uno tiene un precio cerrado que conoces desde el primer mensaje.</p>
        </div>
      </div>
    </div>
  </section>

  <QuickNav />

  <!-- GALERÍA -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Galería"
        title="Nuestros Paquetes de Inflables en Acción"
        subtitle="Así lucen los eventos de nuestros clientes con paquetes completos."
        copy1="Cada paquete incluye lo necesario para una fiesta infantil: inflable, mobiliario y pintacaritas. Nuestro equipo se encarga de la logística completa para que tú solo disfrutes."
        copy2="Mira cómo hemos transformado jardines, patios y terrazas en espacios de fiesta completos. Desde reuniones íntimas hasta grandes celebraciones, tenemos el paquete ideal para tu evento."
      />
      <Gallery4x4 images={galleryImages} />
    </div>
  </section>

  <!-- PAQUETES / PRECIOS -->
  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Nuestros paquetes"
        title="Paquetes de Inflables para Fiestas — Fiesta y Fiesta Bebés"
        subtitle="2 opciones con precio cerrado."
        copy1="Cada paquete ha sido diseñado pensando en las necesidades reales de nuestros clientes. Sabemos que no todas las fiestas son iguales: algunas son reuniones íntimas en casa y otras son grandes celebraciones en jardines. Por eso ofrecemos opciones que se adaptan a tu evento."
        copy2="Todos los paquetes incluyen instalación y recolección. La entrega sin costo adicional aplica solo en zonas seleccionadas; en el resto de CDMX y Estado de México el traslado se cotiza según zona. Además, puedes confirmar cualquier necesidad adicional al cotizar."
      />
      <PricingCards packages={pricingPackages} />
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Beneficios"
        title="Inflables en Paquete — Todo tu Evento con un Solo Proveedor"
        subtitle="Más fácil, más ordenado, más profesional."
        copy1="Contratar un paquete completo te da ventajas que la renta individual no puede ofrecer: la comodidad de un solo proveedor que coordina todo — transporte, instalación, horarios y recolección de cada elemento — y un precio cerrado que conoces antes de apartar tu fecha."
        copy2="Elegir un paquete elimina el trabajo de coordinar con múltiples proveedores. Un solo contacto de WhatsApp, un solo pago y la certeza de que todo llega junto, a tiempo y en perfectas condiciones."
      />
      <div class="grid-4">
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #FF3D00, #FF6D00);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Precio Cerrado desde el Primer Mensaje</h3>
            <p class="why-card__desc">Cada paquete tiene un precio fijo que incluye todo lo listado. Sin cobros sorpresa el día del evento y sin extras de última hora.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #2962FF, #448AFF);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Un Solo Proveedor para Todo tu Evento</h3>
            <p class="why-card__desc">Olvídate de coordinar con varios proveedores. Nosotros nos encargamos del inflable, el mobiliario y el pintacaritas.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #00C853, #69F0AE);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Todo Llega y se Retira el Mismo Día</h3>
            <p class="why-card__desc">Inflable y mobiliario se entregan, instalan y recogen en una sola visita coordinada. Tú no mueves ni cargas nada.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #AA00FF, #D500F9);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Personalizable a tu Medida</h3>
            <p class="why-card__desc">Cada paquete se puede ajustar a tus necesidades. Cambia el inflable, agrega mesas o elige el color de manteles que prefieras.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Proceso"
        title="Cómo Contratar tu Paquete de Inflables para Fiesta"
        subtitle="Resuelve todo en 4 pasos sencillos."
        copy1="Contratar un paquete de fiesta con BRINCOLINS es rápido y sin complicaciones. Nuestro equipo te guía en cada paso para que elijas exactamente lo que necesitas, sin gastar de más y sin quedarte corto."
        copy2="Desde el primer mensaje por WhatsApp hasta la recolección del último equipo, nos aseguramos de que tu experiencia sea impecable. Queremos que repitas con nosotros en tu próxima celebración y que nos recomiendes con tu familia y amigos."
      />
      <div class="grid-4">
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #FF3D00, #FF6D00);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Cuéntanos tu fiesta</h3>
            <p class="why-card__desc">Dinos fecha, número de invitados, tipo de espacio y qué servicios te interesan. Te recomendamos el paquete ideal.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #2962FF, #448AFF);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Personaliza tu paquete</h3>
            <p class="why-card__desc">Elige el inflable que más te guste, los colores de manteles y si quieres agregar o quitar elementos. Te cotizamos al momento.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #00C853, #69F0AE);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Aparta con anticipo</h3>
            <p class="why-card__desc">Reserva tu fecha con el 50% de anticipo. Aceptamos transferencia, depósito en OXXO y efectivo. Confirmación inmediata.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #AA00FF, #D500F9);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Nosotros hacemos todo</h3>
            <p class="why-card__desc">Llegamos puntualmente con todo el equipo, instalamos cada elemento y al finalizar recogemos. Tú solo disfruta tu fiesta.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <SectionHeader
        badge="FAQ"
        title="Preguntas sobre Paquetes de Inflables para Fiestas en CDMX"
        subtitle="Todo sobre nuestros paquetes de fiesta."
        copy1="Entendemos que elegir el paquete correcto puede generar dudas. Aquí recopilamos las preguntas más comunes de nuestros clientes para ayudarte a tomar la mejor decisión para tu celebración."
        copy2="Si después de leer estas respuestas aún tienes preguntas, nuestro equipo está disponible por WhatsApp para darte una asesoría personalizada sin compromiso. Queremos que tengas toda la información que necesitas antes de decidir."
      />
      <div style="max-width:800px; margin:0 auto;">
        {faqs.map(f => <FaqItem question={f.question} answer={f.answer} />)}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Arma tu paquete de fiesta ideal"
    subtitle="Inflable + mobiliario + pintacaritas con precio cerrado y un solo proveedor. Cotiza hoy y aparta tu fecha."
    btnText="Cotizar Paquete de Inflables para mi Fiesta"
    btnHref="/cotizar/"
    btnSecondaryText="Ver Catálogo de Inflables"
    btnSecondaryHref="/inflables/"
    variant="festa"
  />

</PageLayout>
