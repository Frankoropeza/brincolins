---
import PageLayout from "@/layouts/PageLayout.astro";
import QuickNav from "@/components/QuickNav.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import FaqItem from "@/components/FaqItem.astro";
import CtaBanner from "@/components/CtaBanner.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Gallery4x4 from "@/components/Gallery4x4.astro";
import PricingCards from "@/components/PricingCards.astro";

const title = "Renta de Mobiliario para Fiestas en CDMX";
const description = "Renta de mesa infantil con 10 sillas y paquetes para fiestas en CDMX. Combina con un inflable y confirma el traslado según zona.";

const galleryImages = [
  { src: "/img/inflables/castillo-blanco-bautizo-evento-formal.avif", alt: "Evento con inflable y mobiliario para fiestas en CDMX" },
  { src: "/img/inflables/castillo-princesas-vista-frontal-cdmx.avif", alt: "Fiesta infantil con mobiliario y decoración completa" },
  { src: "/img/inflables/extremo-tobogan-vista-lateral-cdmx.avif", alt: "Evento al aire libre con mesas, sillas e inflable" },
  { src: "/img/inflables/barco-pirata-tobogan-altura-fiesta-cdmx.avif", alt: "Montaje completo de fiesta con mobiliario y brincolin" },
  { src: "/img/inflables/mini-castillo-fiesta-interior-pequeno.avif", alt: "Fiesta infantil con mesas y sillas en jardín" },
  { src: "/img/inflables/gusanitos-vista-frontal-evento-cdmx.avif", alt: "Evento con mobiliario completo para niños" },
  { src: "/img/inflables/mini-jungla-vista-frontal-cdmx.avif", alt: "Fiesta con sillas, mesas y zona de juegos" },
  { src: "/img/inflables/castillo-blanco-decoracion-elegante-cdmx.avif", alt: "Montaje profesional de mobiliario para evento" },
];

const pricingPackages = [
  {
    name: "Mesa infantil con 10 sillas",
    price: "$550",
    priceNote: "solo junto con un inflable / evento",
    description: "Mesa infantil de 1.8 × 0.5 m con 10 sillas para niñas y niños de 1 a 6 años.",
    features: [
      { text: "Mesa infantil de 1.8 × 0.5 m", included: true },
      { text: "10 sillas infantiles", included: true },
      { text: "Edades de 1 a 6 años", included: true },
      { text: "Disponible junto con un inflable", included: true },
    ],
    ctaHref: "/contacto/",
  },
  {
    name: "Mesa infantil con 10 sillas",
    badge: "Sin inflable",
    highlight: true,
    price: "$1,600",
    priceNote: "sin inflable / evento",
    description: "Mesa infantil de 1.8 × 0.5 m con 10 sillas para niñas y niños de 1 a 6 años.",
    features: [
      { text: "Mesa infantil de 1.8 × 0.5 m", included: true },
      { text: "10 sillas infantiles", included: true },
      { text: "Edades de 1 a 6 años", included: true },
      { text: "Disponible sin inflable", included: true },
    ],
    ctaHref: "/contacto/",
  },
  {
    name: "Paquete fiesta",
    price: "$2,800",
    priceNote: "por evento",
    description: "1 inflable Jungla o Dragones Rojos, 1 mesa con 10 sillitas y 1 pintacaritas durante 1 hora.",
    features: [
      { text: "1 inflable Jungla o Dragones Rojos", included: true },
      { text: "1 mesa con 10 sillitas", included: true },
      { text: "1 pintacaritas durante 1 hora", included: true },
    ],
    ctaHref: "/contacto/",
  },
  {
    name: "Paquete fiesta bebés",
    price: "$2,100",
    priceNote: "por evento",
    description: "1 Castillo Baby, 1 mesa con 4 sillitas y 1 pintacaritas para 4 niños.",
    features: [
      { text: "1 Castillo Baby", included: true },
      { text: "1 mesa con 4 sillitas", included: true },
      { text: "1 pintacaritas para 4 niños", included: true },
    ],
    ctaHref: "/contacto/",
  },
];

const faqs = [
  { question: "¿Qué incluye la mesa infantil?", answer: "La mesa infantil mide 1.8 × 0.5 m e incluye 10 sillas para niñas y niños de 1 a 6 años. Cuesta $550 solo junto con un inflable y $1,600 sin inflable." },
  { question: "¿Qué incluye el Paquete fiesta?", answer: "Incluye 1 inflable Jungla o Dragones Rojos, 1 mesa con 10 sillitas y 1 pintacaritas durante 1 hora. El precio es $2,800 por evento." },
  { question: "¿Qué incluye el Paquete fiesta bebés?", answer: "Incluye 1 Castillo Baby, 1 mesa con 4 sillitas y 1 pintacaritas para 4 niños. El precio es $2,100 por evento." },
  { question: "¿Cómo se confirma el traslado?", answer: "La entrega se atiende en las zonas de cobertura. El traslado no tiene costo adicional en Polanco; en el resto de CDMX y Estado de México se confirma según zona antes de apartar la fecha." },
];
---

<PageLayout
  faqContext={{ tipo: "servicio", servicio: "mobiliario" }}
  servicio="mobiliario"
  title={title}
  description={description}
  pageType="page"
  breadcrumbs={[
    { name: "Inicio", href: "/" },
    { name: "Servicios", href: "/servicios" },
    { name: "Mobiliario para Fiestas" },
  ]}
  faqItems={faqs}
>
  <Fragment slot="breadcrumbs">
    <Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Servicios",href:"/servicios/"},{label:"Mobiliario para Fiestas"}]} />
  </Fragment>

  <!-- HERO 2 columnas -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="hero__badge">Mobiliario</span>
          <h1 class="hero__title">Renta de <span class="highlight">mobiliario</span> para fiestas</h1>
          <p class="hero__desc">Mesa infantil con 10 sillas y paquetes para que tu fiesta quede resuelta. Entrega a domicilio en toda la CDMX; traslado según zona e instalación incluida.</p>
        </div>
        <div class="hero__copy">
          <p class="hero__copy-text">Complementa tu fiesta con una mesa infantil y 10 sillas. La mesa mide 1.8 × 0.5 m y está pensada para niñas y niños de 1 a 6 años.</p>
          <p class="hero__copy-text">También puedes elegir el Paquete fiesta o el Paquete fiesta bebés, con inflable, mesa y pintacaritas incluidos según la opción. Te confirmamos disponibilidad y traslado antes de apartar.</p>
        </div>
      </div>
    </div>
  </section>

  <QuickNav />

  <!-- GALERÍA -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Galería"
        title="Nuestro mobiliario para fiestas en acción"
        subtitle="Mesa infantil y paquetes listos para tu celebración."
        copy1="Todo nuestro mobiliario se entrega limpio, en excelentes condiciones y listo para usar. Nos aseguramos de que cada pieza luzca impecable para que tu evento se vea profesional y tus invitados estén cómodos."
        copy2="Ya sea una fiesta infantil en el jardín o una celebración más formal, nuestro mobiliario se adapta a cualquier tipo de evento. Consulta disponibilidad para la fecha de tu fiesta."
      />
      <Gallery4x4 images={galleryImages} />
    </div>
  </section>

  <!-- PRECIOS -->
  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Precios"
        title="Precios de renta de mobiliario"
        subtitle="Opciones flexibles para cada tipo de evento."
        copy1="Ofrecemos una mesa infantil con 10 sillas: $550 solo junto con un inflable y $1,600 sin inflable. También puedes elegir uno de los dos paquetes de fiesta publicados."
        copy2="El Paquete fiesta cuesta $2,800 y el Paquete fiesta bebés cuesta $2,100. Escríbenos para confirmar disponibilidad, horario y traslado según tu zona."
      />
      <PricingCards packages={pricingPackages} />
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="Beneficios"
        title="Renta de mobiliario para fiestas — por qué elegirnos"
        subtitle="Calidad, variedad y precios justos para tu evento."
        copy1="Nuestro mobiliario para fiestas se mantiene en condiciones impecables. La mesa y las sillas pasan por un proceso de revisión y limpieza antes de ser entregadas a tu evento. Trabajamos con materiales resistentes para el uso de niñas y niños en cualquier celebración."
        copy2="La mesa infantil y los paquetes publicados están pensados para simplificar la organización de tu fiesta. Además, al ser parte del servicio BRINCOLINS, disfrutas de la misma puntualidad y profesionalismo que nos caracteriza en la renta de inflables."
      />
      <div class="grid-4">
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #FF3D00, #FF6D00);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Mesa infantil</h3>
            <p class="why-card__desc">Mesa de 1.8 × 0.5 m con 10 sillas para niñas y niños de 1 a 6 años.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #2962FF, #448AFF);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Mobiliario impecable</h3>
            <p class="why-card__desc">Todas las piezas se limpian y revisan antes de cada evento. Recibes una mesa firme y sillas sin daños.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #00C853, #69F0AE);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Paquete fiesta</h3>
            <p class="why-card__desc">Jungla o Dragones Rojos, mesa con 10 sillitas y pintacaritas durante 1 hora por $2,800.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #AA00FF, #D500F9);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Paquete fiesta bebés</h3>
            <p class="why-card__desc">Castillo Baby, mesa con 4 sillitas y pintacaritas para 4 niños por $2,100.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="section">
    <div class="container">
      <SectionHeader
        badge="Proceso"
        title="Cómo rentar mobiliario para tu fiesta en CDMX"
        subtitle="Un proceso rápido y sin complicaciones."
        copy1="Sabemos que organizar un evento requiere coordinar muchos detalles. Por eso, simplificamos al máximo el proceso de renta de mobiliario para que resuelvas esta parte en minutos y puedas concentrarte en lo demás."
        copy2="Nuestro equipo te asesora sobre las cantidades ideales según el número de invitados, el espacio disponible y el tipo de evento. Así te aseguras de tener el mobiliario justo sin gastar de más ni quedarte corto."
      />
      <div class="grid-4">
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #FF3D00, #FF6D00);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Cuéntanos tu evento</h3>
            <p class="why-card__desc">Dinos cuántos invitados esperas, el tipo de evento y si es en interior o exterior. Te recomendamos la cantidad exacta de mobiliario.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #2962FF, #448AFF);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Recibe tu cotización</h3>
            <p class="why-card__desc">En minutos te enviamos el desglose completo por WhatsApp con precios unitarios y descuentos por volumen o combo con inflable.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #00C853, #69F0AE);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Confirma tu pedido</h3>
            <p class="why-card__desc">Aparta tu fecha con un anticipo. Aceptamos transferencia, depósito en OXXO y efectivo. Te enviamos confirmación al instante.</p>
          </div>
        </div>
        <div class="why-card">
          <div class="why-card__img" style="background: linear-gradient(135deg, #AA00FF, #D500F9);">
            <span class="why-card__img-label"></span>
          </div>
          <div class="why-card__body">
            <h3 class="why-card__title">Entrega e instalación</h3>
            <p class="why-card__desc">Llegamos a la hora acordada, acomodamos la mesa y las sillas. Al terminar el evento, recogemos todo según lo acordado.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        badge="FAQ"
        title="Preguntas sobre renta de mobiliario para fiestas en CDMX"
        subtitle="Todo lo que necesitas saber sobre la renta de mobiliario."
        copy1="Rentar mobiliario para tu fiesta no tiene por qué ser complicado. Aquí respondemos las dudas más frecuentes de nuestros clientes para que tomes la mejor decisión para tu evento."
        copy2="Recuerda que puedes elegir la mesa infantil o uno de los dos paquetes publicados. Escríbenos por WhatsApp para confirmar disponibilidad y traslado."
      />
      <div style="max-width:800px; margin:0 auto;">
        {faqs.map(f => <FaqItem question={f.question} answer={f.answer} />)}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Completa tu fiesta con el mobiliario perfecto"
    subtitle="Mesa infantil y paquetes con inflable, mesa y pintacaritas."
    btnText="Cotizar Mobiliario para tu Fiesta"
    btnHref="/cotizar/"
    btnSecondaryText="Ver Catálogo de Inflables"
    btnSecondaryHref="/inflables/"
    variant="warm"
  />

</PageLayout>
