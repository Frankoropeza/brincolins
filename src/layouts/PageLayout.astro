---
import { WHATSAPP } from '../data/site';
import BaseLayout  from "@/layouts/BaseLayout.astro";
import type { BreadcrumbItem, FaqSeoItem, ProductSeo } from "@/layouts/BaseLayout.astro";
import WaBubble    from "@/components/WaBubble.astro";
import FaqSection  from "@/components/FaqSection.astro";
import SectionHeader from "@/components/SectionHeader.astro";

/* Los tipos se REUTILIZAN de BaseLayout en vez de redeclararse.

   Antes `product` se declaraba aquí inline con `price: string`, duplicando
   ProductSeo de BaseLayout. Cuando ProductSeo se amplió a `string | number`
   (schema.ts ya normalizaba ambos con normalizePrice), esta copia se quedó
   atrás y las 9 páginas de producto —que montan PageLayout, no BaseLayout—
   siguieron fallando con ts(2322).

   Es el mismo patrón de fuente de verdad duplicada que tenía el catálogo de
   inflables: dos declaraciones de lo mismo que se desincronizan en silencio.
   Reexportar desde BaseLayout lo hace imposible por construcción. */
export interface Props {
  title:        string;
  description:  string;
  canonical?:   string;
  ogImage?:     string;
  pageType?:    "home" | "product" | "category" | "page";
  breadcrumbs?: BreadcrumbItem[];
  faqItems?:    FaqSeoItem[];
  product?:     ProductSeo;
  /* BUG (jul 2026): PageLayout no declaraba NI reenviaba schemaMarkup, pero
     directorio/cdmx/[slug].astro se lo pasaba. El resultado no era solo un
     error de tipos: el JSON-LD de cada salón se descartaba en silencio y
     nunca llegaba al HTML. Verificado en el build — el único LocalBusiness
     de esas páginas era el global de BRINCOLINS, no el del salón.
     TypeScript llevaba tiempo señalándolo; el error estaba entre los 55
     que nadie veía porque @astrojs/check no estaba instalado. */
  schemaMarkup?: string;
  whatsapp?:    string;
  phone?:       string;
  email?:       string;
  noindex?:     boolean;
  servicio?:    "inflable" | "mobiliario" | "iluminacion";
}

const {
  title,
  description,
  canonical,
  ogImage,
  pageType,
  breadcrumbs,
  faqItems,
  product,
  schemaMarkup,
  whatsapp = WHATSAPP,
  noindex,
  servicio,
} = Astro.props;

/* ── FAQs universales de respaldo ── */
const defaultFaqs = [
  {
    question: "¿Cuáles son los precios de renta de inflables?",
    answer:   "Nuestros precios van desde $800 MXN por evento (Mini Castillo para bebés). Los inflables medianos —Dragones Rojos, Castillo de Princesas, Mini Jungla y Gusanitos— van de $1,200 a $1,350 MXN. Los grandes —Castillo Blanco, Barco Pirata y Circuito Extremo— desde $1,700 MXN. Todos incluyen entrega, instalación, motor inflador, sanitización y recolección. Son precios netos: si necesitas factura se agrega el 16% de IVA.",
  },
  {
    question: "¿Qué incluye el servicio de renta?",
    answer:   "Incluye entrega a domicilio sin costo adicional, instalación profesional en menos de 30 minutos, motor inflador silencioso, sanitización certificada antes del evento y recolección al finalizar. Lo único que puede sumarse al precio publicado es el IVA, si necesitas factura, y el cargo de envío en zonas distantes — ambos te los decimos antes de que apartes la fecha.",
  },
  {
    question: "¿Los inflables son seguros para los niños?",
    answer:   "Sí. Todos nuestros inflables se revisan, limpian y desinfectan con protocolo certificado antes de cada evento. Están fabricados con materiales de grado comercial certificados en resistencia y seguridad.",
  },
  {
    question: "¿Cómo reservo mi fecha?",
    answer:   "Escríbenos por WhatsApp con el inflable que te interesa, la fecha y la zona de entrega. Confirmamos disponibilidad en minutos. Para apartar la fecha se requiere un anticipo del 50%. Aceptamos transferencia bancaria, efectivo y tarjeta. El saldo se liquida el día del evento antes de la instalación.",
  },
  {
    question: "¿Cuánto tiempo dura la renta?",
    answer:   "La renta estándar es de 4 a 6 horas por evento, en cualquiera de nuestros 8 modelos. Si necesitas un horario distinto, consúltanos directamente por WhatsApp para ajustar el paquete a tu evento.",
  },
  {
    question: "¿Qué pasa si llueve o necesito cancelar?",
    answer:   "En caso de lluvia, reprogramamos tu evento sin costo adicional en la fecha disponible que prefieras. Para cancelaciones con más de 48 horas de anticipación devolvemos el 100% del anticipo. Tu tranquilidad es nuestra prioridad.",
  },
  {
    question: "¿Cubren toda la CDMX y el Estado de México?",
    answer:   "Cubrimos las 16 alcaldías de la Ciudad de México y los principales municipios del Estado de México: Naucalpan, Tlalnepantla, Ecatepec, Huixquilucan, Atizapán, Cuautitlán Izcalli, Coacalco, Nezahualcóyotl y más. En la mayoría de las alcaldías la entrega va incluida; en municipios distantes aplica un cargo de envío que publicamos en la página de cada zona.",
  },
  {
    question: "¿Cuánto espacio necesito para instalar un inflable?",
    answer:   "El Mini Castillo necesita 3×3 metros y es uno de los dos modelos que caben bajo techo, junto con Gusanitos. Los medianos piden unos 6×6 metros. El Barco Pirata necesita 9×7 metros, el Castillo Blanco 8×7 y el Circuito Extremo 9×6. Si tienes dudas, compártenos una foto del espacio y te orientamos al instante.",
  },
];

/* El pre-footer repetía literalmente las FAQ que la página ya mostraba en su
   cuerpo: en /precios/ eran 6 preguntas idénticas seguidas, en /cotizar/ 5.
   Ahora el pre-footer complementa en vez de repetir: muestra las universales
   que la página NO cubre. Si las cubre todas, el bloque no se renderiza. */
const ownQuestions = new Set((faqItems ?? []).map(f => f.question.trim().toLowerCase()));
const resolvedFaqs = (faqItems && faqItems.length > 0)
  ? defaultFaqs.filter(d => !ownQuestions.has(d.question.trim().toLowerCase())).slice(0, 5)
  : defaultFaqs;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  pageType={pageType}
  breadcrumbs={breadcrumbs}
  faqItems={faqItems}
  product={product}
  schemaMarkup={schemaMarkup}
  noindex={noindex}
>
  <slot name="breadcrumbs" slot="breadcrumbs" />
  <slot />

  <!-- ═══════════════════════════════════════════════════════════
       MÓDULO PRE-FOOTER — FAQ + Formulario de cotización
       Aparece en todas las páginas del sitio automáticamente.
  ═══════════════════════════════════════════════════════════ -->
  {resolvedFaqs.length > 0 && (
  <section class="section pre-footer-faq">
    <div class="container">
      <SectionHeader
        badge="Preguntas frecuentes"
        title="Resolvemos tus Dudas sobre Renta de Inflables"
        subtitle="Las preguntas más comunes sobre precios, servicio, seguridad y cobertura."
        copy1="Reunimos aquí las dudas que más nos llegan antes de una reserva: precios, qué incluye el servicio, cómo apartar la fecha y qué pasa si llueve. Si no encuentras lo que buscas, escríbenos por WhatsApp y una persona real te responde en minutos."
        copy2="Con más de 20 años atendiendo fiestas infantiles y eventos en CDMX y Estado de México, sabemos exactamente qué necesitas saber para reservar con confianza. Sin bots, sin esperas largas."
      />
    </div>
    <FaqSection items={resolvedFaqs} whatsapp={whatsapp} servicio={servicio} />
    <div class="container" style="text-align:center; margin-top:2rem;">
      <a href="/preguntas-frecuentes/" class="btn btn-secondary">Ver todas las preguntas frecuentes</a>
    </div>
  </section>
  )}

  <WaBubble whatsapp={whatsapp} />
</BaseLayout>
