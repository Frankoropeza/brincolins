---
/**
 * FaqItem — una pregunta frecuente como acordeón nativo.
 *
 * <details> en lugar de botón + JS: se abre sin JavaScript, el lector de
 * pantalla anuncia el estado solo y la respuesta no se recorta (el
 * acordeón anterior animaba max-height hasta 500px y cortaba las
 * respuestas largas). Con `name` compartido el navegador mantiene una
 * sola pregunta abierta por grupo, igual que antes.
 * Estilos: .faq__* en global.css.
 */
export interface Props {
  question: string;
  answer:   string;
  /** Grupo de exclusión: abrir una pregunta cierra las demás del grupo. */
  group?:   string;
}

const { question, answer, group = "faq" } = Astro.props;
---

<details class="faq__item" name={group}>
  <summary class="faq__question">
    <span>{question}</span>
    <span class="faq__icon" aria-hidden="true"></span>
  </summary>
  <div class="faq__answer">
    <p>{answer}</p>
  </div>
</details>
