---
interface Props {
  slug:      string;
  category:  string;
  title:     string;
  excerpt:   string;
  readTime:  string;
  image?:    string;
  featured?: boolean;
}

const { slug, category, title, excerpt, readTime, image, featured } = Astro.props;

/* Sistema «Patio de aire»: el badge de categoría pasó de color saturado con
   texto calculado por textOn() a pill pastel con texto tinta (contraste
   ≥ 12:1 en todos los tonos). Sin imagen, el respaldo usa el mismo pastel
   plano. */
const CAT_TONE: Record<string, string> = {
  'Guías':      'durazno',
  'Ideas':      'lila',
  'Consejos':   'cielo',
  'Precios':    'mango',
  'Seguridad':  'menta',
  'Acuáticos':  'cielo',
  'Eventos':    'durazno',
  'Decoración': 'chicle',
  'Paquetes':   'menta',
  'Mesas de dulces': 'chicle',
};
const tone = `tone-${CAT_TONE[category] ?? 'durazno'}`;
---

<article class={`blog-card${featured ? ' blog-card--featured' : ''}`}>
  <div class="blog-card__thumb-link">
    {image
      ? <img src={image} alt={title} width="800" height="450" loading="lazy" class="blog-card__img" />
      : <div class={`blog-card__fallback ${tone}`} />
    }
    <span class={`blog-card__cat ${tone}`}>{category}</span>
  </div>
  <div class="blog-card__body">
    <span class="blog-card__readtime">{readTime} lectura</span>
    <h3 class="blog-card__title">
      <a href={`/blog/${slug}/`}>{title}</a>
    </h3>
    <p class="blog-card__excerpt">{excerpt}</p>
    {/* Antes había un 2.º enlace "Leer artículo" al mismo destino que el título.
        Dos anclas a la misma URL = solo cuenta la primera, y la genérica
        estorbaba. Ahora el ancla es el título (ya lleva la palabra clave) y
        toda la tarjeta es clicable con un enlace extendido (::after). La
        flecha es decorativa. */}
    <span class="blog-card__link" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </span>
  </div>
</article>

<style>
  .tone-cielo   { background: var(--c-cielo); }
  .tone-menta   { background: var(--c-menta); }
  .tone-mango   { background: var(--c-mango); }
  .tone-chicle  { background: var(--c-chicle); }
  .tone-lila    { background: var(--c-lila); }
  .tone-durazno { background: var(--c-durazno); }

  .blog-card {
    position: relative;
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    padding: 10px;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  :global(.section--alt) .blog-card { background: var(--c-canvas); }

  /* Thumbnail */
  .blog-card__thumb-link {
    position: relative;
    display: block;
    aspect-ratio: 16/9;
    overflow: hidden;
    flex-shrink: 0;
    border-radius: calc(var(--r-card) - 10px);
  }
  .blog-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .blog-card__fallback {
    width: 100%;
    height: 100%;
  }
  .blog-card__cat {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-ink);
    padding: 0.28rem 0.75rem;
    border-radius: var(--r-btn);
  }

  /* Cuerpo */
  .blog-card__body {
    padding: 1rem 0.9rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }
  .blog-card__readtime {
    font-size: 0.78rem;
    color: var(--c-ink-60);
    font-weight: 600;
  }
  .blog-card__title {
    font-family: var(--font-head);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--c-ink);
    line-height: 1.3;
    margin: 0;
  }
  .blog-card__title a {
    color: inherit;
    text-decoration: none;
  }
  .blog-card__title a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .blog-card__title a:hover { color: var(--c-primary-text); }
  .blog-card__title a:focus-visible { outline: none; }
  .blog-card:has(.blog-card__title a:focus-visible) {
    outline: 3px solid var(--c-ink);
    outline-offset: 3px;
  }
  .blog-card__excerpt {
    font-size: 0.9rem;
    color: var(--c-ink-60);
    line-height: 1.65;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card__link {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    color: var(--c-ink);
    margin-top: auto;
    transition: transform .2s ease;
  }
  .blog-card:hover .blog-card__link { transform: translateX(4px); }

  /* Featured */
  .blog-card--featured .blog-card__title {
    font-size: clamp(1.15rem, 2.5vw, 1.4rem);
  }
  .blog-card--featured .blog-card__excerpt {
    -webkit-line-clamp: 4;
  }
</style>
