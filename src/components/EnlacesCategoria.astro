---
/**
 * EnlacesCategoria — BRINCOLINS
 * ──────────────────────────────────────────────────────────────
 * Bloque de enlaces contextuales hacia las categorías del catálogo.
 *
 * Existe porque publicar 11 categorías no sirve de nada si nada las
 * enlaza: sin este bloque son hojas que reciben tráfico cero y no
 * transmiten autoridad. Se usa en las 35 páginas de cobertura, en los
 * 59 posts del blog y en la home.
 *
 * Regla de anchors: el texto del enlace es la keyword objetivo de la
 * categoría destino. Nunca "ver más", "clic aquí" ni "conoce más".
 */
interface Item {
  href:   string;
  anchor: string;
  nota?:  string;
}

interface Props {
  titulo:    string;
  intro?:    string;
  items:     Item[];
  /** `inline` = párrafo compacto dentro del contenido (blog).
      `cards`  = rejilla de tarjetas (cobertura, home). */
  variante?: "inline" | "cards";
}

const { titulo, intro, items, variante = "cards" } = Astro.props;
---

{variante === "inline" ? (
  <aside class="enl-inline" aria-label={titulo}>
    <p class="enl-inline__title">{titulo}</p>
    {intro && <p class="enl-inline__intro">{intro}</p>}
    <ul class="enl-inline__list">
      {items.map((i) => (
        <li>
          <a href={i.href}>{i.anchor}</a>
          {i.nota && <span class="enl-inline__nota"> — {i.nota}</span>}
        </li>
      ))}
    </ul>
  </aside>
) : (
  <nav class="enl-cards" aria-label={titulo}>
    <div class="enl-cards__head">
      <h2 class="enl-cards__title">{titulo}</h2>
      {intro && <p class="enl-cards__intro">{intro}</p>}
    </div>
    <ul class="enl-cards__grid">
      {items.map((i) => (
        <li class="enl-cards__item">
          <a class="enl-cards__link" href={i.href}>
            <span class="enl-cards__anchor">{i.anchor}</span>
            {i.nota && <span class="enl-cards__nota">{i.nota}</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  /* ── Variante inline (blog): ficha informativa pastel cielo ── */
  .enl-inline {
    background: var(--c-cielo);
    color: var(--c-ink);
    border-radius: var(--r-tile);
    padding: 1.25rem 1.4rem;
    margin: 1.75rem 0;
  }
  .enl-inline__title {
    margin: 0 0 .35rem;
    font-family: var(--font-head);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1.05rem;
  }
  .enl-inline__intro {
    margin: 0 0 .6rem;
    font-size: .93rem;
    color: var(--c-ink);
    line-height: 1.6;
  }
  .enl-inline__list {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: .3rem;
    font-size: .95rem;
  }
  /* Sobre pastel el enlace va en tinta (naranja sobre pastel no da AA) */
  .enl-inline__list a {
    color: var(--c-ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--c-primary);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .enl-inline__nota { color: var(--c-ink); }

  /* ── Variante cards (cobertura, home) ── */
  .enl-cards__head { margin-bottom: 1.25rem; }
  .enl-cards__title {
    margin: 0 0 .35rem;
    font-family: var(--font-head);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--c-ink);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 1.25;
  }
  .enl-cards__intro {
    margin: 0;
    color: var(--c-ink-60);
    font-size: .95rem;
    max-width: 70ch;
  }
  .enl-cards__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .enl-cards__link {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    min-height: 44px;
    height: 100%;
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-tile);
    background: #fff;
    text-decoration: none;
    color: var(--c-ink);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .enl-cards__link:hover,
  .enl-cards__link:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .enl-cards__link:focus-visible { outline: 3px solid var(--c-ink); outline-offset: 3px; }
  .enl-cards__anchor { font-weight: 700; line-height: 1.35; }
  .enl-cards__nota {
    font-size: .88rem;
    color: var(--c-ink-60);
    line-height: 1.5;
  }
</style>
