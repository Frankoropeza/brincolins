---
/**
 * TablaComparativa — BRINCOLINS
 * ──────────────────────────────────────────────────────────────
 * Compara lado a lado sólo los modelos de UNA categoría.
 *
 * Es el elemento que ni cocoy.com ni pelotinas.com tienen en sus
 * páginas de categoría (512 palabras, sin precios y sin fichas).
 * Todos los datos salen de inflables.ts — cero cifras a mano.
 */
import { PRICE_NOTE } from "@/data/inflables";
import type { Inflable } from "@/data/inflables";

interface Props {
  inflables: Inflable[];
  caption:   string;
}

const { inflables, caption } = Astro.props;
---

<div class="tabla-wrap">
  <table class="tabla-comp">
    <caption class="tabla-comp__caption">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Modelo</th>
        <th scope="col">Desde</th>
        <th scope="col">Medidas</th>
        <th scope="col">Espacio libre</th>
        <th scope="col">Altura libre</th>
        <th scope="col">Edades</th>
        <th scope="col">Capacidad</th>
        <th scope="col">Interiores</th>
      </tr>
    </thead>
    <tbody>
      {inflables.map((i) => (
        <tr>
          <th scope="row"><a href={`/inflables/${i.slug}/`}>{i.name}</a></th>
          <td>{i.price}</td>
          <td>{i.size}</td>
          <td>{i.spaceRequired}</td>
          <td>{i.heightClearance}</td>
          <td>{i.ages}</td>
          <td>{i.capacity}</td>
          <td>{i.indoor ? "Sí" : "No"}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="tabla-comp__nota">Precios netos por evento, con entrega, instalación y recolección incluidas. {PRICE_NOTE}.</p>

<style>
  .tabla-wrap {
    overflow-x: auto;
    border: 1px solid var(--c-line);
    border-radius: var(--r-tile);
    background: #fff;
  }
  .tabla-comp {
    width: 100%;
    border-collapse: collapse;
    font-size: .94rem;
    min-width: 720px;
    color: var(--c-ink);
  }
  .tabla-comp__caption {
    text-align: left;
    padding: 1rem 1.15rem .75rem;
    font-family: var(--font-head);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--c-ink);
  }
  .tabla-comp th,
  .tabla-comp td {
    padding: .8rem 1.15rem;
    text-align: left;
    border-bottom: 1px solid var(--c-line);
    vertical-align: middle;
  }
  .tabla-comp thead th {
    font-size: .78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--c-ink);
    background: var(--c-canvas);
    white-space: nowrap;
  }
  .tabla-comp tbody th {
    font-weight: 700;
    white-space: nowrap;
  }
  .tabla-comp tbody tr:last-child th,
  .tabla-comp tbody tr:last-child td { border-bottom: 0; }
  .tabla-comp a { color: var(--c-ink); text-decoration: underline; text-decoration-color: var(--c-line-strong); text-underline-offset: 3px; }
  .tabla-comp a:hover { text-decoration-color: currentColor; }
  .tabla-comp__nota {
    margin: .75rem 0 0;
    font-size: .88rem;
    color: var(--c-ink-60);
  }
</style>
