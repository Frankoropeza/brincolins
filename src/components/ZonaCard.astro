---
import { anchorZona } from '../data/anchors';
import { WHATSAPP } from '../data/site';
export interface Props {
  slug: string;
  name: string;
  description: string;
  colonias: string[];
  envio: string;
  image?: string;
  whatsapp?: string;
  tipo?: "cdmx" | "edomex";
}

const {
  slug,
  name,
  description,
  colonias,
  envio,
  image,
  whatsapp = WHATSAPP,
  tipo = "cdmx",
} = Astro.props;

const esGratis = envio === "Incluido";
/* `envio` llega como "Según zona" o "$100–$150"; tras "Envío" va en minúscula. */
const envioLabel = esGratis
  ? "Envío incluido"
  : `Envío ${envio.charAt(0).toLowerCase()}${envio.slice(1)}`;
const envioColor = esGratis ? "castillo" : "pirata";

const waMsg = encodeURIComponent(`Hola BRINCOLINS, quiero cotizar un inflable con entrega en ${name}.`);
const waHref = `https://wa.me/${whatsapp}?text=${waMsg}`;
---

<article class={`product-card product-card--${envioColor}`}>
  {image ? (
    <div class="product-card__image product-card__image--photo">
      <img src={image} alt={`Renta de inflables en ${name}`} loading="lazy" width="720" height="480" />
      <span class="product-card__category">{envioLabel}</span>
    </div>
  ) : (
    <div class="product-card__image zona-card__band">
      <span class="product-card__category">{envioLabel}</span>
    </div>
  )}

  <div class="product-card__body">
    <h3 class="product-card__name">{name}</h3>
    <p class="product-card__desc">{description}</p>

    <div class="product-card__info">
      {colonias.slice(0, 3).map(c => (
        <span class="product-card__tag">{c}</span>
      ))}
    </div>

    <div class="product-card__actions">
      <a href={`/cobertura/${slug}/`} class="btn btn-outline btn-sm">{anchorZona(name)}</a>
    </div>
  </div>
</article>

<style>
  /* Sin foto: franja pastel compacta por posición que sólo lleva el badge
     de envío. Antes era un bloque 16:9 vacío (~170px) en cada una de las
     33 tarjetas de zona. */
  .zona-card__band {
    justify-content: flex-start;
    aspect-ratio: auto;
    min-height: 3.25rem;
    padding: 0 0.75rem;
    background: var(--c-cielo);
  }
  .zona-card__band .product-card__category {
    position: static;
    box-shadow: none;
  }
  .product-card:nth-child(6n+2) .zona-card__band { background: var(--c-menta); }
  .product-card:nth-child(6n+3) .zona-card__band { background: var(--c-mango); }
  .product-card:nth-child(6n+4) .zona-card__band { background: var(--c-chicle); }
  .product-card:nth-child(6n+5) .zona-card__band { background: var(--c-lila); }
  .product-card:nth-child(6n) .zona-card__band { background: var(--c-durazno); }
</style>
