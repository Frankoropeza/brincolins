---
/**
 * Breadcrumbs Component — Origenlab Standard
 * ─────────────────────────────────────────
 * Migas de pan con Schema BreadcrumbList.
 * Se posiciona debajo del hdr-stack.
 */
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

// NOTA: el JSON-LD de BreadcrumbList lo emite BaseLayout.astro (auto-generado
// desde la URL canónica) para TODAS las páginas. Este componente es solo visual
// para evitar BreadcrumbList duplicado en el mismo documento.
---

<nav class="crumbs" aria-label="Breadcrumb">
  <div class="crumbs__inner">
    <ol class="crumbs__list">
      {items.map((item, index) => (
        <li class="crumbs__item">
          {item.href && index < items.length - 1 ? (
            <a href={item.href} class="crumbs__link">
              {index === 0 && (
                <svg class="crumbs__home-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
              )}
              {item.label}
            </a>
          ) : (
            <span class="crumbs__current" aria-current="page">{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>.crumbs {
    /* Nov 2026: migas sobre el lienzo, sin franja gris ni borde */
    background: transparent;
    border: 0;
    padding: 0.625rem 0;
  }.crumbs__inner {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 var(--container-px);
  }.crumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.825rem;
  }.crumbs__item {
    display: inline-flex;
    align-items: center;
    color: var(--c-ink-60);
  }.crumbs__item:not(:last-child)::after {
    content: '/';
    margin-left: 0.35rem;
    color: var(--c-line-strong);
    font-size: 0.825rem;
  }.crumbs__link {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: var(--c-ink-60);
    text-decoration: none;
  }.crumbs__link:hover {
    color: var(--c-primary-text);
  }.crumbs__current {
    /* Naranja de texto: 5.2:1 sobre crema (#FF3D00 daba 3.36:1) */
    color: var(--c-primary-text);
    font-weight: 600;
  }.crumbs__home-icon {
    display: inline-block;
    vertical-align: -2px;
    margin-right: 0.2rem;
  }
</style>
