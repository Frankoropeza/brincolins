---
interface Props {
  /** Headline principal */
  title: string;
  /** Texto descriptivo debajo del headline */
  subtitle?: string;
  /** Texto del boton principal */
  btnText?: string;
  /** URL del boton principal */
  btnHref?: string;
  /** Texto del boton secundario */
  btnSecondaryText?: string;
  /** URL del boton secundario */
  btnSecondaryHref?: string;
  /** Variante de color: 'vibrant' | 'warm' | 'cool' | 'festa' */
  variant?: "vibrant" | "warm" | "cool" | "festa";
  /** Mostrar icono de WhatsApp en el boton principal */
  whatsapp?: boolean;
  /** Abrir enlace principal en nueva pestaña */
  external?: boolean;
  /** Compacto (menos padding, ideal entre secciones) */
  compact?: boolean;
}

const {
  title,
  subtitle,
  btnText,
  btnHref,
  btnSecondaryText,
  btnSecondaryHref,
  variant = "vibrant",
  whatsapp = false,
  external = false,
  compact = false,
} = Astro.props;

const rel = external ? "nofollow noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<section class={`cta-banner cta-banner--${variant}${compact ? " cta-banner--compact" : ""}`}>
  <!-- Globos decorativos: solo en las esquinas, nunca bajo el texto -->
  <div class="cta-banner__shape cta-banner__shape--1" aria-hidden="true"></div>
  <div class="cta-banner__shape cta-banner__shape--2" aria-hidden="true"></div>

  <div class="container">
    <div class="cta-banner__content">
      <div class="cta-banner__text">
        <h2 class="cta-banner__title">{title}</h2>
        {subtitle && <p class="cta-banner__subtitle">{subtitle}</p>}
      </div>
      {(btnText || btnSecondaryText) && (
        <div class="cta-banner__actions">
          {btnText && btnHref && (
            <a href={btnHref} class="cta-banner__btn cta-banner__btn--primary" target={target} rel={rel}>
              {whatsapp && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <use href="#i-wa"/>
                </svg>
              )}
              {btnText}
            </a>
          )}
          {btnSecondaryText && btnSecondaryHref && (
            <a href={btnSecondaryHref} class="cta-banner__btn cta-banner__btn--secondary">
              {btnSecondaryText}
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: clamp(0.5rem, 1.6vw, 1.5rem) 0;
    padding: 3rem 0;
    border-radius: var(--r-sheet);
  }
  .cta-banner--compact { padding: 2rem 0; }

  /* ── Variantes de color ──
     Bloques planos («Patio de aire»); todas cargan texto blanco con
     contraste AA. */
  .cta-banner--vibrant,
  .cta-banner--festa { background: var(--c-ink); }
  .cta-banner--warm  { background: var(--c-primary-deep); }
  .cta-banner--cool  { background: #1F3A8A; } /* azul profundo: blanco 10.4:1 */

  /* ── Globos decorativos ── */
  .cta-banner__shape {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
  }
  /* Mango asomando por la esquina superior derecha */
  .cta-banner__shape--1 {
    top: -120px;
    right: -50px;
    width: 180px;
    height: 180px;
    background: var(--c-mango);
  }
  /* Cielo tenue en la esquina inferior izquierda, fuera del bloque de texto */
  .cta-banner__shape--2 {
    bottom: -70px;
    left: -60px;
    width: 120px;
    height: 120px;
    background: var(--c-cielo);
    opacity: 0.18;
  }

  /* ── Contenido ── */
  .cta-banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .cta-banner__text {
    flex: 1;
    min-width: 0;
  }
  .cta-banner__title {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .cta-banner__subtitle {
    margin: 0.5rem 0 0;
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    line-height: 1.5;
    color: #fff;
  }

  /* ── Botones ── */
  .cta-banner__actions {
    display: flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    gap: 0.75rem;
  }
  .cta-banner__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    border-radius: var(--r-btn);
    font-family: var(--font-head);
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .cta-banner__btn--primary {
    background: #fff;
    color: var(--c-ink);
    box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.14);
  }
  .cta-banner__btn--primary:hover { transform: translateY(-2px); }
  .cta-banner__btn--secondary {
    border: 2px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }
  .cta-banner__btn--secondary:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.25);
  }

  @media (max-width: 768px) {
    .cta-banner__content {
      flex-direction: column;
      text-align: center;
    }
    .cta-banner__subtitle { margin-inline: auto; }
    .cta-banner__actions {
      justify-content: center;
      width: 100%;
    }
    .cta-banner__btn {
      justify-content: center;
      width: 100%;
    }
  }
</style>
