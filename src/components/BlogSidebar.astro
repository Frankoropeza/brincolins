---
/**
 * BlogSidebar — BRINCOLINS
 * Sidebar del artículo del blog. Widgets, de arriba abajo:
 *  1. Cotización (botón, WhatsApp con el título del post, teléfono)
 *  2. Otros inflables: foto, edades, medidas y precio de los modelos que NO
 *     salen en la tarjeta «Inflables para esta fiesta» del final del post,
 *     para repartir el enlazado entre los ocho.
 *  3. Rango de precios del catálogo
 *  4. Más artículos con miniatura
 *  5. Categorías y zonas como etiquetas
 *  6. Servicios
 *  7. Índice del artículo (fijo al hacer scroll)
 * Todo sale de los datos del sitio: no hay cifras escritas a mano.
 */
import { INFLABLES_ACTIVOS } from "@/data/inflables";
import { CATEGORIAS } from "@/data/categorias";
import { COVERAGE_ZONES } from "@/data/coverage";
import { SERVICIO_ANCHORS, anchorInflable, anchorZona, A } from "@/data/anchors";
import { modelosRecomendados, hashPost } from "@/data/escenasInflables";
import { PHONE, PHONE_TEL, buildWhatsAppUrl } from "@/data/site";

interface Articulo { href: string; titulo: string; imagen?: string; alt?: string }
interface Ancla { href: string; label: string }

export interface Props {
  postId: string;
  body: string;
  titulo: string;
  categoria?: string;      // slug de la categoría del catálogo ligada al post
  articulos: Articulo[];
  indice: Ancla[];
}

const { postId, body, titulo, categoria, articulos, indice } = Astro.props;

const enTarjeta = new Set(modelosRecomendados(postId, body).map((i) => i.slug));
const otros = INFLABLES_ACTIVOS.filter((i) => !enTarjeta.has(i.slug));
const thumb = (src: string) => src.replace(/\.avif$/, "-480w.avif");

const precios = INFLABLES_ACTIVOS.map((i) => i.priceNumber);
const fmt = (n: number) => `$${n.toLocaleString("en-US")}`;
const desde = fmt(Math.min(...precios));
const hasta = fmt(Math.max(...precios));

const cats = [...CATEGORIAS.filter((c) => c.slug === categoria), ...CATEGORIAS.filter((c) => c.slug !== categoria)];

/* Zonas: los dos hubs + seis que rotan por post, para no repetir siempre
   el mismo enlace en los 119 artículos. */
const hubs = COVERAGE_ZONES.filter((z) => z.childZones);
const hojas = COVERAGE_ZONES.filter((z) => !z.childZones);
const semilla = hashPost(postId);
const zonas = [...hubs, ...new Set(Array.from({ length: 6 }, (_, k) => hojas[(semilla + k * 7) % hojas.length]))];
const zonaCorta = (z: (typeof COVERAGE_ZONES)[number]) => z.zone.replace(/^Renta de inflables en /i, "");

const wa = buildWhatsAppUrl(`Hola, leí «${titulo}» en brincolins.com y quiero cotizar un inflable.`);
---

<aside class="bsb" aria-label="Inflables, guías y enlaces relacionados">

  <!-- 1 · Cotización -->
  <section class="bsb__cta">
    <p class="bsb__eyebrow bsb__eyebrow--light">Cotización sin compromiso</p>
    <p class="bsb__cta-title">¿Listo para tu fiesta?</p>
    <p class="bsb__cta-text">Dinos la fecha, la colonia y la edad de los niños. Instalación y recolección incluidas; traslado según zona.</p>
    <a href="/cotizar/" class="btn btn-primary bsb__btn">Pedir cotización gratis</a>
    <a href={wa} class="bsb__wa" target="_blank" rel="nofollow noopener noreferrer">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4a.5.5 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
      Cotizar por WhatsApp
    </a>
    <a href={`tel:${PHONE_TEL}`} class="bsb__tel">o llámanos al <strong>{PHONE}</strong></a>
  </section>

  <!-- 2 · Otros inflables -->
  <section class="bsb__box">
    <p class="bsb__eyebrow">Más inflables del catálogo</p>
    <ul class="bsb__infl">
      {otros.map((i) => (
        <li>
          <a href={`/inflables/${i.slug}/`} class="bsb__infl-card">
            <img src={thumb(i.image)} alt={`Inflable ${i.name}`} width="480" height="270" loading="lazy" decoding="async" />
            <span class="bsb__infl-txt">
              <span class="bsb__infl-name">{anchorInflable(i.slug).short}</span>
              <span class="bsb__infl-meta">{i.ages} · {i.size}</span>
              <span class="bsb__infl-price">{i.price} <small>por evento</small></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <a href="/inflables/" class="bsb__more">{A.catalogo.short} →</a>
  </section>

  <!-- 3 · Precios -->
  <section class="bsb__box bsb__precio">
    <p class="bsb__eyebrow">Precios 2026</p>
    <p class="bsb__precio-rango"><span>{desde}</span> a <span>{hasta}</span></p>
    <p class="bsb__precio-nota">Precio neto por evento de 4 a 6 horas, según el modelo. Con factura se suma el 16 % de IVA.</p>
    <a href="/precios/" class="bsb__more">{A.precios.full} →</a>
  </section>

  <!-- 4 · Más artículos -->
  {articulos.length > 0 && (
    <section class="bsb__box">
      <p class="bsb__eyebrow">Sigue leyendo</p>
      <ul class="bsb__arts">
        {articulos.map((a) => (
          <li>
            <a href={a.href} class="bsb__art">
              {a.imagen && <img src={a.imagen} alt={a.alt ?? ""} width="160" height="90" loading="lazy" decoding="async" />}
              <span>{a.titulo}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/blog/" class="bsb__more">{A.blog.short} →</a>
    </section>
  )}

  <!-- 5 · Categorías y zonas -->
  <section class="bsb__box">
    <p class="bsb__eyebrow">Inflables por tipo</p>
    <ul class="bsb__chips">
      {cats.map((c) => (
        <li><a href={`/inflables/${c.slug}/`} class:list={["bsb__chip", { "bsb__chip--on": c.slug === categoria }]} title={c.anchor}>{c.nav}</a></li>
      ))}
    </ul>
    <p class="bsb__eyebrow bsb__eyebrow--gap">Entregamos en</p>
    <ul class="bsb__chips">
      {zonas.map((z) => (
        <li><a href={`/cobertura/${z.slug}/`} class="bsb__chip" title={anchorZona(z.zonePhrase ?? z.zone)}>{zonaCorta(z)}</a></li>
      ))}
    </ul>
    <a href="/cobertura/" class="bsb__more">{A.zonas.short} →</a>
  </section>

  <!-- 6 · Servicios -->
  <section class="bsb__box">
    <p class="bsb__eyebrow">Completa tu fiesta</p>
    <ul class="bsb__list">
      {Object.entries(SERVICIO_ANCHORS).map(([href, label]) => <li><a href={href}>{label}</a></li>)}
    </ul>
  </section>

  <!-- 7 · Índice fijo -->
  {indice.length >= 4 && (
    <nav class="bsb__box bsb__toc" aria-label="En este artículo">
      <p class="bsb__eyebrow">En este artículo</p>
      <ol>{indice.map((h) => <li><a href={h.href}>{h.label}</a></li>)}</ol>
      <a href="/cotizar/" class="btn btn-primary bsb__btn bsb__btn--sm">Pedir cotización gratis</a>
    </nav>
  )}
</aside>

<style>
  .bsb { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .bsb__box, .bsb__cta {
    padding: 1.25rem; border: 1px solid var(--c-line); border-radius: var(--r-tile);
    background: #fff; box-shadow: var(--shadow-sm);
  }
  .bsb__eyebrow {
    margin: 0 0 .75rem; font-size: .72rem; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--c-ink-60);
  }
  .bsb__eyebrow--light { color: rgba(255, 255, 255, .7); }
  .bsb__eyebrow--gap { margin-top: 1.1rem; }
  .bsb__more {
    display: inline-block; margin-top: .85rem; font-size: .875rem; font-weight: 700;
    color: var(--c-primary-text); text-decoration: none;
  }
  .bsb__more:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* 1 · Cotización */
  .bsb__cta { background: var(--c-ink); border-color: var(--c-ink); color: #fff; }
  .bsb__cta-title { margin: 0 0 .35rem; font-family: var(--font-head); font-weight: 800; font-size: 1.3rem; letter-spacing: -.02em; line-height: 1.2; }
  .bsb__cta-text { margin: 0 0 1rem; font-size: .9rem; line-height: 1.5; color: rgba(255, 255, 255, .78); }
  .bsb__btn { width: 100%; justify-content: center; }
  .bsb__btn--sm { margin-top: 1rem; }
  .bsb__wa {
    display: flex; align-items: center; justify-content: center; gap: .45rem; min-height: 44px; margin-top: .5rem;
    border-radius: var(--r-btn); background: var(--c-wa); color: #0b2e16; font-weight: 700; font-size: .9rem; text-decoration: none;
    transition: filter .2s;
  }
  .bsb__wa:hover { filter: brightness(1.05); }
  .bsb__tel { display: block; margin-top: .75rem; text-align: center; font-size: .85rem; color: rgba(255, 255, 255, .78); text-decoration: none; }
  .bsb__tel strong { color: #fff; }

  /* 2 · Otros inflables */
  .bsb__infl { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .bsb__infl-card {
    display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: .75rem; align-items: center;
    padding: .4rem; margin: -.4rem; border-radius: 14px; text-decoration: none; color: var(--c-ink);
    transition: background .2s;
  }
  .bsb__infl-card:hover { background: var(--c-canvas); }
  .bsb__infl-card img { width: 96px; height: 72px; object-fit: cover; border-radius: 10px; display: block; }
  .bsb__infl-txt { display: flex; flex-direction: column; gap: .1rem; min-width: 0; }
  .bsb__infl-name { font-weight: 700; font-size: .92rem; line-height: 1.25; }
  .bsb__infl-card:hover .bsb__infl-name { color: var(--c-primary-text); }
  .bsb__infl-meta { font-size: .78rem; color: var(--c-ink-60); }
  .bsb__infl-price { font-size: .88rem; font-weight: 800; color: var(--c-primary-text); }
  .bsb__infl-price small { font-weight: 500; color: var(--c-ink-60); font-size: .75rem; }

  /* 3 · Precios */
  .bsb__precio { background: var(--c-canvas); }
  .bsb__precio-rango { margin: 0; font-family: var(--font-head); font-size: 1.15rem; font-weight: 700; color: var(--c-ink-60); }
  .bsb__precio-rango span { font-size: 1.6rem; font-weight: 800; color: var(--c-ink); letter-spacing: -.02em; }
  .bsb__precio-nota { margin: .4rem 0 0; font-size: .82rem; line-height: 1.5; color: var(--c-ink-60); }

  /* 4 · Más artículos */
  .bsb__arts { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem; }
  .bsb__art { display: grid; grid-template-columns: 80px minmax(0, 1fr); gap: .7rem; align-items: center; text-decoration: none; color: var(--c-ink); }
  .bsb__art img { width: 80px; height: 56px; object-fit: cover; border-radius: 10px; display: block; }
  .bsb__art span { font-size: .875rem; font-weight: 600; line-height: 1.35; }
  .bsb__art:hover span { color: var(--c-primary-text); text-decoration: underline; text-underline-offset: 3px; }

  /* 5 · Etiquetas */
  .bsb__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .bsb__chip {
    display: inline-block; padding: .35rem .75rem; border: 1px solid var(--c-line-strong); border-radius: var(--r-btn);
    font-size: .8rem; font-weight: 600; color: var(--c-ink); text-decoration: none; transition: border-color .2s, background .2s;
  }
  .bsb__chip:hover { border-color: var(--c-ink); }
  .bsb__chip--on { background: var(--c-ink); border-color: var(--c-ink); color: #fff; }

  /* 6 · Servicios */
  .bsb__list { list-style: none; margin: 0; padding: 0; }
  .bsb__list li + li { border-top: 1px solid var(--c-line); }
  .bsb__list a { display: block; padding: .55rem 0; font-size: .9rem; font-weight: 600; line-height: 1.35; color: var(--c-ink); text-decoration: none; }
  .bsb__list a:hover { color: var(--c-primary-text); text-decoration: underline; text-underline-offset: 3px; }

  /* 7 · Índice */
  .bsb__toc { position: sticky; top: 96px; }
  .bsb__toc ol { margin: 0; padding-left: 1.1rem; display: grid; gap: .45rem; font-size: .85rem; line-height: 1.4; }
  .bsb__toc ol a { color: var(--c-ink-60); text-decoration: none; }
  .bsb__toc ol a:hover { color: var(--c-primary-text); text-decoration: underline; }

  @media (max-width: 960px) {
    .bsb__toc { position: static; }
  }
</style>
