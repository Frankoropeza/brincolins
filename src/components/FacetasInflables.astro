---
/**
 * FacetasInflables — BRINCOLINS
 * ──────────────────────────────────────────────────────────────
 * El bloque que convierte 11 páginas sueltas en un silo.
 *
 * Se renderiza IGUAL en las 11 categorías, en el hub y al pie de las
 * 8 fichas de producto. Cada categoría enlaza a sus hermanas por los
 * tres ejes (tamaño, tipo, público), de modo que la autoridad circula
 * en lugar de morir en la home.
 *
 * Regla de anchors: nunca "ver más" ni "clic aquí". El texto del enlace
 * es la keyword objetivo de la categoría destino (campo `anchor`).
 */
import { FACETAS, categoriasDeGrupo } from "@/data/categorias";

interface Props {
  /** Slug de la categoría actual: se marca como activa y no se enlaza a sí misma */
  activeSlug?: string;
  /** Título de la sección */
  titulo?: string;
  /** Texto introductorio opcional */
  subtitulo?: string;
}

const {
  activeSlug,
  titulo = "Explora el catálogo por categoría",
  subtitulo = "Filtra por tamaño, por tipo de inflable o por quién lo va a usar.",
} = Astro.props;
---

<nav class="facetas" aria-label="Categorías de inflables">
  <div class="facetas__head">
    <h2 class="facetas__title">{titulo}</h2>
    <p class="facetas__sub">{subtitulo}</p>
  </div>

  <div class="facetas__grid">
    {FACETAS.map((f) => (
      <div class="facetas__col">
        <h3 class="facetas__col-title">{f.titulo}</h3>
        <ul class="facetas__list">
          {categoriasDeGrupo(f.grupo).map((c) => (
            <li class="facetas__item">
              {c.slug === activeSlug ? (
                <span class="facetas__link facetas__link--active" aria-current="page">{c.nav}</span>
              ) : (
                <a class="facetas__link" href={`/inflables/${c.slug}/`} title={c.name}>{c.nav}</a>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <p class="facetas__foot">
    ¿Prefieres verlos todos? Consulta el <a href="/inflables/">catálogo completo de inflables</a> o
    los <a href="/precios/">precios de renta de inflables</a>.
  </p>
</nav>

<style>
  .facetas {
    border: 1px solid var(--border, #e2e2e6);
    border-radius: 16px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--surface, #fff);
  }

  .facetas__head { margin-bottom: 1.5rem; }

  .facetas__title {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    margin: 0 0 .35rem;
    line-height: 1.25;
  }

  .facetas__sub {
    margin: 0;
    color: var(--text-muted, #5a5a66);
    font-size: .95rem;
  }

  .facetas__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .facetas__col-title {
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--text-muted, #5a5a66);
    margin: 0 0 .75rem;
  }

  .facetas__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .facetas__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: .55rem .9rem;
    border-radius: 999px;
    border: 1px solid var(--border, #e2e2e6);
    font-size: .92rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text, #1c1c22);
    background: var(--surface-alt, #f7f7f9);
    transition: background .15s ease, border-color .15s ease;
  }

  .facetas__link:hover,
  .facetas__link:focus-visible {
    background: #fff;
    border-color: currentColor;
  }

  .facetas__link--active {
    background: var(--brand, #FF3D00);
    border-color: var(--brand, #FF3D00);
    color: #fff;
    cursor: default;
  }

  .facetas__foot {
    margin: 1.75rem 0 0;
    font-size: .95rem;
    color: var(--text-muted, #5a5a66);
  }

  @media (max-width: 860px) {
    .facetas__grid { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>
