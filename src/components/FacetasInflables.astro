---
/**
 * FacetasInflables — BRINCOLINS
 * ──────────────────────────────────────────────────────────────
 * El bloque que convierte 11 páginas sueltas en un silo.
 *
 * Se renderiza IGUAL en las 11 categorías, en el hub y al pie de las
 * 8 fichas de producto. Cada categoría enlaza a sus hermanas por los
 * tres ejes (tamaño, tipo, público), de modo que la autoridad circula
 * en lugar de morir en la home.
 *
 * Regla de anchors: nunca "ver más" ni "clic aquí". El texto del enlace
 * es la keyword objetivo de la categoría destino (campo `anchor`).
 */
import { FACETAS, categoriasDeGrupo } from "@/data/categorias";

interface Props {
  /** Slug de la categoría actual: se marca como activa y no se enlaza a sí misma */
  activeSlug?: string;
  /** Título de la sección */
  titulo?: string;
  /** Texto introductorio opcional */
  subtitulo?: string;
}

const {
  activeSlug,
  titulo = "Explora el catálogo por categoría",
  subtitulo = "Filtra por tamaño, por tipo de inflable o por quién lo va a usar.",
} = Astro.props;
---

<nav class="facetas" aria-label="Categorías de inflables">
  <div class="facetas__head">
    <h2 class="facetas__title">{titulo}</h2>
    <p class="facetas__sub">{subtitulo}</p>
  </div>

  <div class="facetas__grid">
    {FACETAS.map((f) => (
      <div class="facetas__col">
        <h3 class="facetas__col-title">{f.titulo}</h3>
        <ul class="facetas__list">
          {categoriasDeGrupo(f.grupo).map((c) => (
            <li class="facetas__item">
              {c.slug === activeSlug ? (
                <span class="facetas__link facetas__link--active" aria-current="page">{c.nav}</span>
              ) : (
                <a class="facetas__link" href={`/inflables/${c.slug}/`} title={c.name}>{c.nav}</a>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <p class="facetas__foot">
    ¿Prefieres verlos todos? Consulta el <a href="/inflables/">catálogo completo de inflables</a> o
    los <a href="/precios/">precios de renta de inflables</a>.
  </p>
</nav>

<style>
  .facetas {
    border: 1px solid var(--c-line);
    border-radius: var(--r-card);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: #fff;
    color: var(--c-ink);
  }
  .facetas__head { margin-bottom: 1.5rem; }
  .facetas__title {
    font-family: var(--font-head);
    font-weight: 800;
    letter-spacing: -0.03em;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    margin: 0 0 .35rem;
    line-height: 1.25;
  }
  .facetas__sub {
    margin: 0;
    max-width: 75ch;
    color: var(--c-ink-60);
    font-size: .95rem;
  }
  .facetas__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }
  /* Sobretítulo de columna: mismo lenguaje que .section-badge */
  .facetas__col-title {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-size: .75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .16em;
    color: var(--c-ink);
    margin: 0 0 .85rem;
  }
  .facetas__col-title::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c-primary);
    flex: none;
  }
  .facetas__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }
  .facetas__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: .55rem 1rem;
    border-radius: var(--r-btn);
    border: 1px solid var(--c-line-strong);
    font-size: .92rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--c-ink);
    background: #fff;
    transition: background-color .15s ease, border-color .15s ease, transform .15s ease;
  }
  .facetas__link:hover,
  .facetas__link:focus-visible {
    background: var(--c-canvas);
    border-color: var(--c-ink);
    transform: translateY(-2px);
  }
  .facetas__link:focus-visible { outline: 3px solid var(--c-ink); outline-offset: 2px; }
  /* Activa: tinta con texto blanco (antes blanco sobre #FF3D00 = 3.55:1) */
  .facetas__link--active,
  .facetas__link--active:hover {
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: #fff;
    cursor: default;
    transform: none;
  }
  .facetas__foot {
    margin: 1.75rem 0 0;
    font-size: .95rem;
    color: var(--c-ink-60);
  }
  .facetas__foot a { color: var(--c-primary-text); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 860px) { .facetas__grid { grid-template-columns: 1fr; gap: 1.25rem; } }
</style>
