---
import { anchorSalon } from '../data/anchors';
export interface Props {
  slug: string;
  name: string;
  zone: string;
  rating: string;
  capacity: string;
  phone: string;
  label: string;
  gradient: string;
  features: string[];
  highlight: string;
}

const {
  slug,
  name,
  zone,
  rating,
  capacity,
  phone,
  label,
  features,
  highlight,
} = Astro.props;

const telHref = `tel:+52${phone.replace(/\s/g, "")}`;
---

<article class="product-card">
  <div class="product-card__image">
    <span class="product-card__category">{rating}★</span>
  </div>

  <div class="product-card__body">
    <h3 class="product-card__name">{name}</h3>
    <p class="product-card__desc">{highlight}</p>

    <div class="product-card__info">
      <span class="product-card__tag">{zone}</span>
      <span class="product-card__tag">{capacity}</span>
      <span class="product-card__tag">{phone}</span>
    </div>

    <div class="venue-card__features">
      {features.map(f => (
        <span class="venue-card__tag">✓ {f}</span>
      ))}
    </div>

    <div class="product-card__actions product-card__actions--single">
      <a href={`/directorio/cdmx/${slug}/`} class="btn btn-outline btn-sm">{anchorSalon(name, zone)}</a>
    </div>
  </div>
</article>

<style>
  /* Fondo pastel por posición en la rejilla; la prop `gradient` de
     src/data/directorio.ts ya no se pinta. */
  .product-card__image { background: var(--c-cielo); }
  .product-card:nth-child(6n+1) .product-card__image { background: var(--c-mango); }
  .product-card:nth-child(6n+2) .product-card__image { background: var(--c-cielo); }
  .product-card:nth-child(6n+3) .product-card__image { background: var(--c-menta); }
  .product-card:nth-child(6n+4) .product-card__image { background: var(--c-chicle); }
  .product-card:nth-child(6n+5) .product-card__image { background: var(--c-lila); }
  .product-card:nth-child(6n+6) .product-card__image { background: var(--c-durazno); }
  .venue-card__features { margin-bottom: 1rem; }
  .venue-card__tag {
    background: #fff;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-btn);
    color: var(--c-ink);
    font-weight: 600;
  }
</style>
