---
import { anchorInflable } from '../data/anchors';
import ResponsiveInflatableImage from './ResponsiveInflatableImage.astro';
export interface Props {
  slug: string;
  emoji?: string;
  name: string;
  description: string;
  price: string;
  size: string;
  ages: string;
  category: string;
  categoryColor?: string;
  gradient?: string;
  image?: string;
}

const {
  slug,
  emoji = "",
  name,
  description,
  price,
  size,
  ages,
  category,
  categoryColor = "castillo",
  gradient = "#FF3D00, #FF6D00",
  image,
} = Astro.props;

const anchor = anchorInflable(slug);
---

<article class={`product-card product-card--${categoryColor}`}>
  <div class="product-card__image product-card__image--photo">
    {image ? (
      <ResponsiveInflatableImage
        src={image}
        sizes="(max-width: 600px) calc(100vw - 2rem), (max-width: 1024px) calc((100vw - 6rem) / 2), 300px"
        alt={name}
        loading="lazy"
        width={720}
        height={405}
      />
    ) : (
      <div class="product-card__image-fallback" style={`background: linear-gradient(135deg, ${gradient});`}>
        
      </div>
    )}
    <span class="product-card__category">{category}</span>
    <div class="product-card__overlay">
      {/* Se retiraron las ★★★★★ fijas (ago 2026): afirmaban 5/5 en 29 páginas
          sin ninguna reseña detrás, mientras el schema —correctamente— no
          declara aggregateRating. Volverán cuando haya reseñas reales. */}
      <span class="product-card__price">{price}</span>
    </div>
  </div>

  <div class="product-card__body">
    <h3 class="product-card__name">{name}</h3>
    <p class="product-card__desc">{description}</p>

    <div class="product-card__info">
      <span class="product-card__tag">{size}</span>
      <span class="product-card__tag">{ages}</span>
    </div>

    <div class="product-card__actions product-card__actions--single">
      <a href={`/inflables/${slug}/`} class="btn btn-outline btn-sm product-card__link">{anchor.full}</a>
    </div>
  </div>
</article>
