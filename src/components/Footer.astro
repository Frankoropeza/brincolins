---
import { WHATSAPP, PHONE_TEL, SOCIAL_PROFILES } from '../data/site';
export interface Props {
  phone?: string;
  whatsapp?: string;
  email?: string;
}

const {
  phone = "55 3128 1706",
  whatsapp = WHATSAPP,
  email = "info@brincolins.com",
} = Astro.props;

const waHref = `https://wa.me/${whatsapp}?text=${encodeURIComponent("Hola BRINCOLINS, quiero información sobre renta de inflables.")}`;

/* Redes: sólo se pintan las que tengan URL en src/data/site.ts.
   Mientras no exista ningún perfil, el bloque entero no se renderiza —
   mejor ausencia que un icono que lleva a ninguna parte. */
const socials = [
  { key: 'google',    label: 'Google',    url: SOCIAL_PROFILES.google,
    path: 'M12 11v2.8h4.6c-.2 1.2-1.4 3.5-4.6 3.5-2.8 0-5-2.3-5-5.1s2.2-5.1 5-5.1c1.6 0 2.6.7 3.2 1.2l2.2-2.1C15.9 4.9 14.1 4 12 4c-4.4 0-8 3.6-8 8s3.6 8 8 8c4.6 0 7.7-3.2 7.7-7.8 0-.5 0-.9-.1-1.2H12z' },
  { key: 'facebook',  label: 'Facebook',  url: SOCIAL_PROFILES.facebook,
    path: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z' },
  { key: 'instagram', label: 'Instagram', url: SOCIAL_PROFILES.instagram,
    path: 'M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.3-.1 1.7-.1 4.8-.1zm0 3.1a6.7 6.7 0 1 0 0 13.4 6.7 6.7 0 0 0 0-13.4zm0 11a4.3 4.3 0 1 1 0-8.6 4.3 4.3 0 0 1 0 8.6zm8.5-11.3a1.6 1.6 0 1 1-3.1 0 1.6 1.6 0 0 1 3.1 0z' },
  { key: 'tiktok',    label: 'TikTok',    url: SOCIAL_PROFILES.tiktok,
    path: 'M16.6 5.8a4.8 4.8 0 0 1-1.1-3.1h-3.2v12.6a2.8 2.8 0 1 1-2-2.7V9.3a6 6 0 1 0 5.2 5.9V9a8 8 0 0 0 4.6 1.5V7.3a4.8 4.8 0 0 1-3.5-1.5z' },
].filter(s => s.url);
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      <!-- Brand -->
      <div>
        <div class="footer__brand-logo">BRINCOLINS</div>
        <p class="footer__brand-desc">
          Empresa líder en renta de inflables y brincolines para fiestas infantiles en CDMX y Estado de México. Más de 20 años haciendo felices a las familias.
        </p>
        <div class="footer__contact-item">
          
          <a href={`tel:${PHONE_TEL}`}>{phone}</a>
        </div>
        <div class="footer__contact-item">
          
          <a href={waHref} target="_blank" rel="nofollow noopener noreferrer">WhatsApp: {phone}</a>
        </div>
        <div class="footer__contact-item">
          <span>Email:</span>
          <a href={`mailto:${email}`} data-noptimize="1"><Fragment set:html={`<!--email_off-->${email}<!--/email_off-->`} /></a>
        </div>
        <div class="footer__contact-item">
          <span>Horario:</span>
          <span>Lunes a domingo, 8:00 a 20:00</span>
        </div>

        {socials.length > 0 && (
          <div class="footer__social">
            {socials.map(s => (
              <a
                href={s.url}
                class="footer__social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`BRINCOLINS en ${s.label}`}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={s.path} />
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Empresa -->
      <div>
        <h4 class="footer__col-title">Empresa</h4>
        <a href="/inflables/" class="footer__link">Catálogo</a>
        <a href="/servicios/" class="footer__link">Servicios</a>
        <a href="/fiestas-infantiles/" class="footer__link">Fiestas Infantiles</a>
        <a href="/preguntas-frecuentes/" class="footer__link">Preguntas Frecuentes</a>
        <a href="/cotizar/" class="footer__link">Cotizar</a>
        <a href="/cobertura/" class="footer__link">Cobertura</a>
        <a href="/precios/" class="footer__link">Precios</a>
        <a href="/blog/" class="footer__link">Blog</a>
        <a href="/nosotros/" class="footer__link">Nosotros</a>
        <a href="/contacto/" class="footer__link">Contacto</a>
      </div>

      <!-- Inflables -->
      <div>
        <h4 class="footer__col-title">Inflables</h4>
        <a href="/inflables/brincolines/" class="footer__link">Renta de Brincolines</a>
        <a href="/inflables/dragones-rojos/" class="footer__link">Dragones Rojos</a>
        <a href="/inflables/castillo-princesas/" class="footer__link">Castillo de Princesas</a>
        <a href="/inflables/barco-pirata/" class="footer__link">Barco Pirata</a>
        <a href="/inflables/extremo/" class="footer__link">Extremo</a>
        <a href="/inflables/castillo-blanco/" class="footer__link">Castillo Blanco</a>
        <a href="/inflables/mini-castillo/" class="footer__link">Mini Castillo</a>
        <a href="/inflables/gusanitos/" class="footer__link">Gusanitos</a>
        <a href="/inflables/mini-jungla/" class="footer__link">Mini Jungla</a>
      </div>

      <!-- Cobertura -->
      <div>
        <h4 class="footer__col-title">Cobertura CDMX</h4>
        <a href="/renta-de-inflables-cerca-de-mi/" class="footer__link">Inflables cerca de mí</a>
        <a href="/cobertura/polanco/" class="footer__link">Polanco y Lomas</a>
        <a href="/cobertura/tlalpan/" class="footer__link">Tlalpan y Sur</a>
        <a href="/cobertura/cdmx/" class="footer__link">Todas las alcaldías CDMX</a>
        <a href="/cobertura/" class="footer__link">Ver todas las zonas</a>
        <h4 class="footer__col-title" style="margin-top:1.2rem;">Cobertura Edomex</h4>
        <a href="/cobertura/naucalpan/" class="footer__link">Naucalpan y Satélite</a>
        <a href="/cobertura/edomex/" class="footer__link">Todos los municipios Edomex</a>
        <a href="/cobertura/" class="footer__link">Ver todas las zonas</a>
      </div>

      <!-- Sucursales -->
      <div>
        <h4 class="footer__col-title">Nuestras Sucursales</h4>

        <div class="footer__branch">
          <span class="footer__branch-label">Polanco — CDMX</span>
          <p class="footer__branch-addr">Av. Presidente Masaryk 111, Piso 1<br>Col. Polanco Chapultepec<br>Miguel Hidalgo, 11560</p>
        </div>

        <div class="footer__branch">
          <span class="footer__branch-label">Santa Fe — CDMX</span>
          <p class="footer__branch-addr">Prolongación Paseo de la Reforma 600<br>Col. Lomas de Santa Fe<br>Álvaro Obregón, 01210</p>
        </div>

        <div class="footer__branch">
          <span class="footer__branch-label">Interlomas — Edomex</span>
          <p class="footer__branch-addr">Blvd. Magnocentro 8<br>Col. Interlomas<br>Huixquilucan, 52760</p>
        </div>
      </div>
    </div>

    <nav class="footer__legal" aria-label="Información legal">
      <a href="/aviso-de-privacidad/" class="footer__legal-link">Aviso de Privacidad</a>
      <span class="footer__legal-sep" aria-hidden="true">·</span>
      <a href="/terminos-y-condiciones/" class="footer__legal-link">Términos y Condiciones</a>
      <span class="footer__legal-sep" aria-hidden="true">·</span>
      <a href="/politica-de-cancelacion/" class="footer__legal-link">Política de Cancelación</a>
    </nav>

    <div class="footer__bottom">
      <span>&copy; {new Date().getFullYear()} BRINCOLINS. Todos los derechos reservados.</span>
      <span>Hecho para las fiestas de México</span>
    </div>

    {/* El deslinde iba anidado dentro del copyright, así que su bloque se
        estiraba por debajo de "Hecho para las fiestas de México" y lo tapaba.
        Ahora es su propia fila a ancho completo. */}
    <p class="footer__disclaimer">
      El uso de los inflables requiere supervisión adulta constante de los niños;
      no nos hacemos responsables por accidentes o lesiones derivados del mal uso
      o la falta de supervisión. Consulta los
      <a href="/terminos-y-condiciones/">términos completos</a>.
    </p>
  </div>
</footer>
