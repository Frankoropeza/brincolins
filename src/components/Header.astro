---
import { A } from "@/data/anchors";
import { WHATSAPP, PHONE_TEL } from '../data/site';
import { INFLABLES } from '../data/inflables';
/**
 * Header — BRINCOLINS
 * ─────────────────────────────
 * Escritorio: mega-menú Inflables (2 columnas agrupadas + enlace al
 *   catálogo) y desplegable Servicios (nombre + descripción). Se abre con
 *   hover con intención, con teclado (Enter/↓ en el enlace, Esc cierra) y
 *   se cierra al hacer clic fuera. Sin íconos ni emojis.
 * Móvil: panel lateral con acordeones (aria-expanded / aria-controls).
 * Config base desde /src/data/header.md
 * Estilos en /src/styles/header.css (extraídos del componente, jul 2026 —
 * eran 857 líneas de <style> dentro de un archivo de 1,399).
 */
import "@/styles/header.css";
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import matter from 'gray-matter';

interface NavItem {
  label: string;
  href: string;
  children?: { label: string; href: string }[];
}

let config: Record<string, any> = {};
let topbarConfig: Record<string, any> = {};
try {
  const raw = readFileSync(join(process.cwd(), 'src/data/header.md'), 'utf-8');
  config = matter(raw).data;
} catch { /* defaults */ }
try {
  const raw2 = readFileSync(join(process.cwd(), 'src/data/topbar.md'), 'utf-8');
  topbarConfig = matter(raw2).data;
} catch { /* defaults */ }

const brand      = config.brand ?? 'BRINCOLINS';
const logoHref   = config.logoHref ?? '/';
const navLinks   = (config.nav ?? []) as NavItem[];
const cta        = config.cta ?? { enabled: false, label: '', href: '' };

const waNum      = topbarConfig.whatsapp ?? WHATSAPP;
const waMsg      = topbarConfig.waMessage ?? 'Hola, quiero cotizar un inflable.';
const phone      = topbarConfig.phone ?? '';
const schedule   = topbarConfig.schedule ?? '';
const waHref     = `https://wa.me/${waNum}?text=${encodeURIComponent(waMsg)}`;
const waCotizar  = `https://wa.me/${waNum}?text=${encodeURIComponent('Hola BRINCOLINS, quiero cotizar un inflable para mi fiesta.')}`;

const currentPath = Astro.url.pathname;

function isActive(href: string, children?: { href: string }[]): boolean {
  if (href === '/') return currentPath === '/';
  if (currentPath.startsWith(href)) return true;
  if (children?.some(c => currentPath.startsWith(c.href))) return true;
  return false;
}

/* ── Datos del menú ─────────────────────────────────────────────────
   Precios y nombres salen del catálogo (src/data/inflables.ts): si cambia
   un precio allá, el menú se actualiza solo. Antes estaban escritos a mano
   en tres lugares (mega-menú, panel móvil y datos) y podían desfasarse. */
const bySlug = Object.fromEntries(INFLABLES.map(i => [i.slug, i]));
const modelo = (slug: string) => ({
  label: bySlug[slug]?.name ?? slug,
  href:  `/inflables/${slug}/`,
  meta:  bySlug[slug]?.price ?? '',
});

/* Mega-menú de escritorio: dos columnas agrupadas */
const megaCols = [
  [
    { title: 'Más populares', items: [modelo('dragones-rojos'), modelo('castillo-princesas')] },
    { title: 'Temáticos',     items: [modelo('mini-jungla'), modelo('gusanitos')] },
  ],
  [
    { title: 'Por tamaño', items: [modelo('mini-castillo'), modelo('barco-pirata'), modelo('extremo')] },
    { title: 'Por público', items: [
      { label: 'Brincolines para niños', href: '/inflables/brincolines/', meta: 'Por edad' },
      { label: 'Inflables para adultos', href: '/inflables/para-adultos/', meta: 'Eventos' },
    ] },
    { title: 'Eventos especiales', items: [modelo('castillo-blanco')] },
  ],
];

/* Panel móvil: solo modelos, agrupados */
const panelGroups = [
  { title: 'Más populares', items: [modelo('dragones-rojos'), modelo('castillo-princesas')] },
  { title: 'Temáticos',     items: [modelo('mini-jungla'), modelo('gusanitos')] },
  { title: 'Por tamaño',    items: [modelo('mini-castillo'), modelo('barco-pirata'), modelo('extremo')] },
  { title: 'Especiales',    items: [modelo('castillo-blanco')] },
];

const serviciosItems = [
  { label: 'Renta de Inflables',       desc: 'Instalación incluida · traslado según zona', href: '/servicios/renta-de-inflables/'      },
  { label: 'Paquetes de Fiesta',       desc: 'Todo incluido para tu evento',               href: '/servicios/paquetes-de-fiesta/'      },
  { label: 'Mesas de Dulces',          desc: 'Por evento · desde $3,500',                  href: '/servicios/mesas-de-dulces/'         },
  { label: 'Mobiliario para Fiestas',  desc: 'Mesas, sillas y decoración',                 href: '/servicios/mobiliario-para-fiestas/' },
  { label: 'Iluminación para Eventos', desc: 'Ambiente y efectos de color',                href: '/servicios/iluminacion-eventos/'     },
  { label: 'Inflables para Eventos',   desc: 'Corporativos y eventos sociales',            href: '/servicios/inflables-para-eventos/'  },
  { label: 'Directorio de Salones',    desc: 'Dónde hacer la fiesta en CDMX',              href: '/directorio/'                        },
];

const chev = 'M1 1l4.5 4.5L10 1';
---

<header class="hdr" id="hdr">
  <div class="hdr__inner">

    {/* ── Logo ── */}
    <a href={logoHref} class="hdr__logo" aria-label={`${brand} — Inicio`}>
      <img
        src="/img/branding/renta-de-inflables.avif"
        alt="Brincolins — Renta de inflables en CDMX"
        class="hdr__logo-img"
        width="430"
        height="212"
        loading="eager"
        decoding="async"
      />
    </a>

    {/* ── Desktop nav ── */}
    <nav class="hdr__nav" aria-label="Navegación principal">
      <ul class="hdr__list">
        {navLinks.map((link) => {
          const isMega = link.href === '/inflables/';
          const isSvc  = link.href === '/servicios/';
          const hasSub = isMega || isSvc || !!link.children;
          const subId  = `hdr-sub-${link.href.replace(/\W+/g, '') || 'home'}`;

          return (
            <li class:list={['hdr__item', { 'hdr__item--sub': hasSub, 'hdr__item--mega': isMega }]}>
              <a
                href={link.href}
                class:list={['hdr__link', { 'hdr__link--active': isActive(link.href, link.children) }]}
                aria-current={currentPath === link.href ? 'page' : undefined}
                aria-expanded={hasSub ? 'false' : undefined}
                aria-controls={hasSub ? subId : undefined}
              >
                {link.label}
                {hasSub && (
                  <svg class="hdr__chev" width="11" height="7" viewBox="0 0 11 7" fill="none" aria-hidden="true">
                    <path d={chev} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                )}
              </a>

              {isMega && (
                <div class="hdr__mega" id={subId}>
                  <div class="hdr__mega-inner">
                    {megaCols.map((col) => (
                      <div class="hdr__mega-col">
                        {col.map((g) => (
                          <div class="hdr__mega-group">
                            <span class="hdr__mega-cat">{g.title}</span>
                            <ul class="hdr__mega-list">
                              {g.items.map((it) => (
                                <li>
                                  <a
                                    href={it.href}
                                    class:list={['hdr__mega-link', { 'hdr__mega-link--active': currentPath.startsWith(it.href) }]}
                                    aria-current={currentPath === it.href ? 'page' : undefined}
                                  >
                                    <span class="hdr__mega-link-name">{it.label}</span>
                                    <span class="hdr__mega-price">{it.meta}</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    ))}
                  </div>
                  <div class="hdr__mega-foot">
                    <a href="/inflables/" class="hdr__mega-all">
                      {A.catalogo.full}
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  </div>
                </div>
              )}

              {isSvc && (
                <div class="hdr__dropdown hdr__dropdown--svc" id={subId}>
                  <ul class="hdr__drop-list">
                    {serviciosItems.map((svc) => (
                      <li>
                        <a
                          href={svc.href}
                          class:list={['hdr__drop-link hdr__drop-link--rich', { 'hdr__drop-link--active': currentPath.startsWith(svc.href) }]}
                          aria-current={currentPath === svc.href ? 'page' : undefined}
                        >
                          <span class="hdr__drop-name">{svc.label}</span>
                          <span class="hdr__drop-desc">{svc.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {!isMega && !isSvc && link.children && (
                <div class="hdr__dropdown" id={subId}>
                  <ul class="hdr__drop-list">
                    {link.children.map((sub) => (
                      <li>
                        <a
                          href={sub.href}
                          class:list={['hdr__drop-link', { 'hdr__drop-link--active': currentPath === sub.href }]}
                          aria-current={currentPath === sub.href ? 'page' : undefined}
                        >
                          <span class="hdr__drop-name">{sub.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    {/* ── Acciones desktop ── */}
    <div class="hdr__actions">
      {waHref && (
        <a href={waHref} target="_blank" rel="nofollow noopener noreferrer" class="hdr__wa-btn" aria-label="Contactar por WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <use href="#i-wa"/>
          </svg>
          <span>WhatsApp</span>
        </a>
      )}
      {cta.enabled && (
        <a href={cta.href} class="hdr__cta">
          {cta.label}
        </a>
      )}
      <button class="hdr__toggle" id="hdrToggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="hdrPanel">
        <span class="hdr__burger" aria-hidden="true"></span>
      </button>
    </div>

  </div>
</header>

{/* ── Overlay ── */}
<div class="hdr__overlay" id="hdrOverlay" aria-hidden="true"></div>

{/* ── Panel móvil ──
    `inert` es imprescindible, no decorativo: el panel cerrado solo está
    desplazado con transform:translateX(100%), y un elemento fuera de
    pantalla SIGUE siendo focusable. Sin inert, un usuario de teclado
    tabulaba por 24 enlaces invisibles y el foco desaparecía de la vista.
    Además, aria-hidden="true" con descendientes focusables es una
    violación WCAG: contradice al árbol de accesibilidad con el de foco.
    inert resuelve ambos — saca el subárbol del foco Y del árbol a11y.
    El JS lo alterna en openPanel/closePanel. */}
<nav class="hdr__panel" id="hdrPanel" aria-label="Menú móvil" aria-hidden="true" inert>

  {/* Cabecera panel */}
  <div class="hdr__panel-head">
    <a href={logoHref} class="hdr__panel-logo-link" onclick="document.getElementById('hdrPanel').classList.remove('hdr__panel--open')">
      <img
        src="/img/branding/renta-de-inflables.avif"
        alt={brand}
        class="hdr__panel-logo"
        width="430"
        height="212"
        loading="lazy"
        decoding="async"
      />
    </a>
    <button class="hdr__panel-close" id="hdrClose" type="button" aria-label="Cerrar menú">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M1.5 1.5l15 15M16.5 1.5l-15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  {/* Nav items */}
  <ul class="hdr__panel-list">
    {navLinks.map((link) => {
      const isMega = link.href === '/inflables/';
      const isSvc  = link.href === '/servicios/';
      const hasSub = isMega || isSvc || !!link.children;
      const subId  = `hdr-panel-${link.href.replace(/\W+/g, '') || 'home'}`;

      if (!hasSub) return (
        <li class="hdr__panel-item">
          <a
            href={link.href}
            class:list={['hdr__panel-link', { 'hdr__panel-link--active': isActive(link.href) }]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      );

      return (
        <li class="hdr__panel-item hdr__panel-item--sub">
          <button class="hdr__panel-link hdr__panel-subtoggle" type="button" data-sub aria-expanded="false" aria-controls={subId}>
            <span>{link.label}</span>
            <svg class="hdr__panel-chev" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
              <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class:list={['hdr__panel-sub', { 'hdr__panel-sub--tall': isMega }]} id={subId}>
            {isMega && panelGroups.map((g) => (
              <>
                <span class="hdr__panel-group-label">{g.title}</span>
                {g.items.map((it) => (
                  <a href={it.href} class:list={['hdr__panel-sublink', { 'hdr__panel-sublink--active': currentPath.startsWith(it.href) }]}>
                    <span class="hdr__panel-sub-name">{it.label}</span>
                    <span class="hdr__panel-sub-price">{it.meta}</span>
                  </a>
                ))}
              </>
            ))}
            {isSvc && serviciosItems.map((svc) => (
              <a href={svc.href} class:list={['hdr__panel-sublink', { 'hdr__panel-sublink--active': currentPath.startsWith(svc.href) }]}>
                <span class="hdr__panel-sub-name">{svc.label}</span>
              </a>
            ))}
            {!isMega && !isSvc && link.children?.map((sub) => (
              <a href={sub.href} class:list={['hdr__panel-sublink', { 'hdr__panel-sublink--active': currentPath === sub.href }]}>
                <span class="hdr__panel-sub-name">{sub.label}</span>
              </a>
            ))}
            {(isMega || isSvc) && (
              <a href={link.href} class="hdr__panel-sub-viewall">
                {isMega ? A.catalogo.full : A.servicios.full}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            )}
          </div>
        </li>
      );
    })}
  </ul>

  {/* Pie de panel */}
  <div class="hdr__panel-foot">
    {cta.enabled && (
      <a href={cta.href} class="hdr__panel-cta">{cta.label}</a>
    )}
    {waHref && (
      <a href={waHref} target="_blank" rel="nofollow noopener noreferrer" class="hdr__panel-wa">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <use href="#i-wa"/>
        </svg>
        Escríbenos por WhatsApp
      </a>
    )}
    {phone && (
      <a href={`tel:${PHONE_TEL}`} class="hdr__panel-phone">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
        </svg>
        {phone}
      </a>
    )}
    {schedule && <p class="hdr__panel-schedule">{schedule}</p>}
  </div>

</nav>


<script is:inline>
(function () {
  var hdr     = document.getElementById('hdr');
  var toggle  = document.getElementById('hdrToggle');
  var panel   = document.getElementById('hdrPanel');
  var overlay = document.getElementById('hdrOverlay');
  var close   = document.getElementById('hdrClose');

  /* ── Mobile panel ── */
  function openPanel() {
    toggle.classList.add('hdr__toggle--open');
    toggle.setAttribute('aria-expanded', 'true');
    panel.classList.add('hdr__panel--open');
    panel.setAttribute('aria-hidden', 'false');
    panel.inert = false;           // devuelve los enlaces al orden de foco
    overlay.classList.add('hdr__overlay--visible');
    document.body.style.overflow = 'hidden';
  }

  function closePanel() {
    toggle.classList.remove('hdr__toggle--open');
    toggle.setAttribute('aria-expanded', 'false');
    panel.classList.remove('hdr__panel--open');
    panel.setAttribute('aria-hidden', 'true');
    panel.inert = true;            // saca los 24 enlaces del foco y del árbol a11y
    overlay.classList.remove('hdr__overlay--visible');
    document.body.style.overflow = '';
  }

  /* Cerrar devolviendo el foco al burger. Sin esto, al cerrar el menú el
     foco se queda en un elemento que acaba de volverse inert y salta al
     inicio del documento: el usuario de teclado pierde su sitio. */
  function closeAndRefocus() {
    var wasOpen = panel.classList.contains('hdr__panel--open');
    closePanel();
    if (wasOpen && toggle) toggle.focus();
  }

  if (toggle) toggle.addEventListener('click', function () {
    panel.classList.contains('hdr__panel--open') ? closeAndRefocus() : openPanel();
  });
  if (close)   close.addEventListener('click', closeAndRefocus);
  if (overlay) overlay.addEventListener('click', closeAndRefocus);

  /* Escape cierra el panel — comportamiento esperado en cualquier overlay */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && panel.classList.contains('hdr__panel--open')) closeAndRefocus();
  });

  if (panel) {
    panel.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closePanel);
    });
  }

  /* ── Acordeón móvil ── */
  document.querySelectorAll('[data-sub]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      btn.classList.toggle('hdr__panel-subtoggle--open', open);
      var sub = document.getElementById(btn.getAttribute('aria-controls'));
      if (sub) sub.classList.toggle('hdr__panel-sub--open', open);
    });
  });

  /* ── Desplegables de escritorio ──
     · Hover con intención: abre a los 80 ms y cierra a los 220 ms, para
       que no se cierre al cruzar el cursor en diagonal hacia el panel.
     · Teclado: ↓ o Espacio en el enlace abre y enfoca el primer elemento;
       Esc cierra y regresa el foco; salir con Tab cierra.
     · Clic o toque fuera cierra. Solo uno abierto a la vez.
     · aria-expanded refleja el estado real para lectores de pantalla. */
  var items = Array.prototype.slice.call(document.querySelectorAll('.hdr__item--sub'));

  function setOpen(item, open) {
    item.classList.toggle('hdr__item--open', open);
    var trigger = item.querySelector('.hdr__link');
    if (trigger) trigger.setAttribute('aria-expanded', String(open));
    /* Panel cerrado = fuera del orden de Tab (sigue en el DOM para SEO) */
    var panel = item.querySelector('.hdr__mega, .hdr__dropdown');
    if (panel) panel.inert = !open;
  }
  function closeAll(except) {
    items.forEach(function (it) { if (it !== except) setOpen(it, false); });
  }
  closeAll(null);   // estado inicial: todos cerrados e inert

  items.forEach(function (item) {
    var openTimer, closeTimer;
    var trigger = item.querySelector('.hdr__link');

    item.addEventListener('mouseenter', function () {
      clearTimeout(closeTimer);
      openTimer = setTimeout(function () { closeAll(item); setOpen(item, true); }, 80);
    });
    item.addEventListener('mouseleave', function () {
      clearTimeout(openTimer);
      closeTimer = setTimeout(function () { setOpen(item, false); }, 220);
    });

    item.addEventListener('focusin', function () {
      if (item.classList.contains('hdr__item--dismissed')) return;   // tras Esc, el foco vuelve sin reabrir
      closeAll(item); setOpen(item, true);
    });
    item.addEventListener('focusout', function (e) {
      if (!item.contains(e.relatedTarget)) {
        setOpen(item, false);
        item.classList.remove('hdr__item--dismissed');
      }
    });

    item.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        item.classList.add('hdr__item--dismissed');   // antes del focus: evita que focusin lo reabra
        setOpen(item, false);
        if (trigger) trigger.focus();
      } else if (e.target === trigger && (e.key === 'ArrowDown' || e.key === ' ')) {
        e.preventDefault();
        item.classList.remove('hdr__item--dismissed');
        setOpen(item, true);
        var first = item.querySelector('.hdr__mega a, .hdr__dropdown a');
        if (first) first.focus();
      }
    });
    item.addEventListener('mouseleave', function () { item.classList.remove('hdr__item--dismissed'); });
  });

  document.addEventListener('click', function (e) {
    if (!e.target.closest('.hdr__item--sub')) closeAll(null);
  });

  /* El header ya NO es fijo: sin shrink ni auto-hide en scroll.
     Se eliminó el listener de scroll (antes alternaba hdr--scrolled /
     hdr--hidden). El header viaja con el documento. */

})();
</script>
