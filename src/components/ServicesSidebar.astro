---
import { WHATSAPP } from '../data/site';
/**
 * ServicesSidebar — BRINCOLINS
 * Sidebar compacto para la página /servicios/.
 * Tarjeta unificada con lista scrollable,
 * CTA fijo al fondo. Equilibra el alto con ServiceFeature.
 */

interface Props {
  /** slug del servicio activo para resaltarlo */
  current?: string;
  whatsapp?: string;
  waMessage?: string;
}

const {
  current,
  whatsapp = WHATSAPP,
  waMessage = "Hola BRINCOLINS, quiero cotizar para mi evento.",
} = Astro.props;

const waHref = `https://wa.me/${whatsapp}?text=${encodeURIComponent(waMessage)}`;

const servicios = [
  {
    slug: "renta-de-inflables",
    name: "Renta de Inflables",
    label: "Servicio principal",
    color: "#FF3D00",
    icon: "🎪",
    href: "/servicios/renta-de-inflables/",
    price: "desde $1,400",
  },
  {
    slug: "paquetes-de-fiesta",
    name: "Paquetes de Fiesta",
    label: "Todo incluido",
    color: "#7C3AED",
    icon: "🎁",
    href: "/servicios/paquetes-de-fiesta/",
    price: "desde $2,800",
  },
  {
    slug: "inflables-para-eventos",
    name: "Inflables para Eventos",
    label: "Empresas y escuelas",
    color: "#15803d",
    icon: "🏟️",
    href: "/servicios/inflables-para-eventos/",
    price: "Cotización",
  },
  {
    slug: "mobiliario-para-fiestas",
    name: "Mobiliario para Fiestas",
    label: "Complemento esencial",
    color: "#0369a1",
    icon: "🪑",
    href: "/servicios/mobiliario-para-fiestas/",
    price: "Cotización",
  },
  {
    slug: "iluminacion-eventos",
    name: "Iluminación para Eventos",
    label: "Ambientación premium",
    color: "#b45309",
    icon: "💡",
    href: "/servicios/iluminacion-eventos/",
    price: "Cotización",
  },
];

/* Color de datos → pastel plano (texto siempre tinta). */
const PASTEL: Record<string, string> = {
  "#FF3D00": "var(--c-durazno)",
  "#7C3AED": "var(--c-lila)",
  "#15803d": "var(--c-menta)",
  "#0369a1": "var(--c-cielo)",
  "#b45309": "var(--c-mango)",
};
---

<aside class="ssb">

  <!-- Header -->
  <div class="ssb__header">
    <h3 class="ssb__title">Nuestros servicios</h3>
    <span class="ssb__count">5 servicios</span>
  </div>

  <!-- Lista de servicios -->
  <nav class="ssb__list" aria-label="Catálogo de servicios">
    {servicios.map(s => {
      const isActive = current ? s.slug === current || s.href.includes(current) : false;
      return (
        <a
          href={s.href}
          class={`ssb__item ${isActive ? "ssb__item--active" : ""}`}
          style={`--item-tint: ${PASTEL[s.color] ?? "var(--c-durazno)"};`}
          aria-current={isActive ? "page" : undefined}
        >
          <div class="ssb__item-icon">
            {s.icon}
          </div>
          <div class="ssb__item-info">
            <span class="ssb__item-label">{s.label}</span>
            <span class="ssb__item-name">{s.name}</span>
            <span class="ssb__item-price">{s.price}</span>
          </div>
          <span class="ssb__item-arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      );
    })}
  </nav>

  <!-- Divider -->
  <div class="ssb__divider"></div>

  <!-- CTA -->
  <div class="ssb__cta">
    <p class="ssb__cta-title">💬 ¿Cuál necesitas?</p>
    <p class="ssb__cta-sub">Cotizamos en minutos — sin compromiso</p>
    <a
      href={waHref}
      target="_blank"
      rel="nofollow noopener noreferrer"
      class="ssb__btn ssb__btn--wa"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <use href="#i-wa"/>
      </svg>
      Cotizar por WhatsApp
    </a>
    <a href="/cotizar/" class="ssb__btn ssb__btn--cotizar">
      Cotizar renta de inflables
    </a>
  </div>

  <!-- Trust -->
  <div class="ssb__trust">
    <div class="ssb__trust-item"><span>⭐</span><span>Instalación y recolección incluidas</span></div>
    <div class="ssb__trust-item"><span>🚚</span><span>Traslado según zona</span></div>
    <div class="ssb__trust-item"><span>📅</span><span>Atención 7 días a la semana</span></div>
  </div>

</aside>

<style>
  .ssb {
    position: sticky;
    top: 1.5rem;
    background: #fff;
    border-radius: var(--r-card);
    border: 1px solid var(--c-line);
    overflow: hidden;
    height: 100%;
    max-height: calc(100vh - 3rem);
    display: flex;
    flex-direction: column;
  }
  :global(.section--alt) .ssb { background: var(--c-canvas); }

  /* ── Header ── */
  .ssb__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.25rem 1rem;
    border-bottom: 1px solid var(--c-line);
    flex-shrink: 0;
  }
  .ssb__title {
    font-family: var(--font-head);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--c-ink);
    letter-spacing: -0.03em;
  }
  .ssb__count {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--c-ink);
    background: var(--c-mango);
    padding: 0.2rem 0.65rem;
    border-radius: var(--r-btn);
    letter-spacing: 0.02em;
  }

  /* ── List ── */
  .ssb__list {
    overflow-y: auto;
    flex: 1;
    padding: 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--c-line-strong) transparent;
    min-height: 0;
  }
  .ssb__list::-webkit-scrollbar { width: 4px; }
  .ssb__list::-webkit-scrollbar-track { background: transparent; }
  .ssb__list::-webkit-scrollbar-thumb { background: var(--c-line-strong); border-radius: 2px; }

  /* ── Item ── */
  .ssb__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--r-tile);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .ssb__item:hover { background: var(--c-line); }
  .ssb__item--active,
  .ssb__item--active:hover { background: var(--item-tint, var(--c-durazno)); }

  /* Icon */
  .ssb__item-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
    background: var(--item-tint, var(--c-durazno));
  }
  .ssb__item--active .ssb__item-icon { background: #fff; }

  /* Info */
  .ssb__item-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .ssb__item-label {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.1;
    color: var(--c-ink-60);
  }
  .ssb__item-name {
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--c-ink);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ssb__item-price {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--c-ink-60);
  }
  .ssb__item--active .ssb__item-label,
  .ssb__item--active .ssb__item-price { color: var(--c-ink); }

  /* Arrow */
  .ssb__item-arrow {
    color: var(--c-ink-60);
    flex-shrink: 0;
    transition: color 0.15s, transform 0.15s;
  }
  .ssb__item:hover .ssb__item-arrow {
    color: var(--c-ink);
    transform: translateX(2px);
  }

  /* ── Divider ── */
  .ssb__divider {
    height: 1px;
    background: var(--c-line);
    flex-shrink: 0;
  }

  /* ── CTA ── */
  .ssb__cta {
    padding: 1.1rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }
  .ssb__cta-title {
    font-family: var(--font-head);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--c-ink);
    text-align: center;
    margin: 0;
  }
  .ssb__cta-sub {
    font-size: 0.78rem;
    color: var(--c-ink-60);
    text-align: center;
    margin: 0 0 0.15rem;
  }
  .ssb__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: var(--r-btn);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.84rem;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
    line-height: 1.2;
    text-align: center;
  }
  .ssb__btn:hover { transform: translateY(-2px); }
  .ssb__btn--wa {
    background: var(--c-wa);
    color: var(--c-on-light-vivid);
    box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.16);
  }
  .ssb__btn--cotizar {
    background: transparent;
    color: var(--c-ink);
    border: 2px solid var(--c-ink);
  }
  .ssb__btn--cotizar:hover {
    background: var(--c-ink);
    color: #fff;
  }

  /* ── Trust ── */
  .ssb__trust {
    padding: 0.75rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-top: 1px solid var(--c-line);
    flex-shrink: 0;
  }
  .ssb__trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--c-ink-60);
    font-weight: 500;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .ssb {
      max-height: none;
      position: static;
    }
  }
</style>
