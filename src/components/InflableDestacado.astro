---
/**
 * Tarjetas «Inflables para esta fiesta» al final de cada artículo del blog.
 * Elige los dos modelos que más enlaza el artículo; si enlaza menos de dos,
 * completa con un modelo fijo por artículo (rotación por id) para que los
 * ocho modelos reciban enlaces desde el blog. Foto: una escena del modelo,
 * también fija por artículo, para no repetir siempre la misma.
 */
import { PRICE_NOTE } from "@/data/inflables";
import { anchorInflable } from "@/data/anchors";
import { ESCENAS_INFLABLES, modelosRecomendados, hashPost } from "@/data/escenasInflables";

export interface Props {
  postId: string;
  body: string;
}

const { postId, body } = Astro.props;

const elegidos = modelosRecomendados(postId, body);

const tarjetas = elegidos.map((i) => {
  const escenas = ESCENAS_INFLABLES[i.slug] ?? [];
  const foto = escenas.length
    ? escenas[hashPost(postId + i.slug) % escenas.length]
    : { src: i.image, alt: `Inflable ${i.name}` };
  return { i, foto, anchor: anchorInflable(i.slug) };
});
---

<section class="infd" aria-labelledby="infd-titulo">
  <h2 id="infd-titulo" class="infd__titulo">Inflables para esta fiesta</h2>
  <div class="infd__grid">
    {tarjetas.map(({ i, foto, anchor }) => (
      <article class="infd__card">
        <a href={`/inflables/${i.slug}/`} class="infd__foto" tabindex="-1" aria-hidden="true">
          <img src={foto.src} alt={foto.alt} width="1200" height="675" loading="lazy" />
        </a>
        <div class="infd__info">
          <h3 class="infd__nombre">{i.name}</h3>
          <p class="infd__datos">{i.size} · {i.ages} · {i.indoor ? "cabe en interiores" : "para exterior"}</p>
          <p class="infd__precio"><strong>{i.price}</strong> por evento <span>{PRICE_NOTE}</span></p>
          <a href={`/inflables/${i.slug}/`} class="btn btn-outline btn-sm infd__link">{anchor.full}</a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .infd { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--c-border); }
  .infd__titulo { font-family: var(--font-head); font-size: 1.35rem; font-weight: 800; letter-spacing: -0.03em; margin: 0 0 1rem; }
  .infd__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .infd__card {
    display: flex; flex-direction: column; background: var(--c-bg-alt);
    border: 1px solid var(--c-border); border-radius: var(--r-card); overflow: hidden;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .infd__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  /* Foto enmarcada dentro de la tarjeta, como en el resto del sitio */
  .infd__foto { display: block; margin: 10px 10px 0; border-radius: calc(var(--r-card) - 10px); overflow: hidden; }
  .infd__foto img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; margin: 0; border-radius: 0; box-shadow: none; }
  .infd__info { display: flex; flex-direction: column; gap: .4rem; padding: 1rem 1.1rem 1.2rem; flex: 1; }
  .infd .infd__nombre { font-family: var(--font-head); font-size: 1.1rem; font-weight: 700; letter-spacing: -0.02em; margin: 0; }
  .infd .infd__datos { margin: 0; font-size: .9rem; color: var(--c-text-muted); }
  .infd .infd__precio { margin: 0; font-size: .95rem; font-weight: 700; color: var(--c-ink); }
  .infd__precio span { font-size: .8rem; color: var(--c-text-muted); }
  .infd__link { margin-top: auto; align-self: flex-start; }
  @media (max-width: 640px) { .infd__grid { grid-template-columns: 1fr; } }
</style>
