---
/**
 * QuickNav — BRINCOLINS
 * ────────────────────────────────────────────────
 * Barra de navegación rápida bajo el hero. Auto-contextual:
 * muestra enlaces distintos según la sección del sitio.
 * Se puede sobreescribir pasando `links`.
 */
import { textOn } from '@/lib/contrast';

interface Link { label: string; href: string; color: string; }
interface Props { links?: Link[]; }

const current = Astro.url.pathname;

const MAIN: Link[] = [
  { label: "Inflables",          href: "/inflables/",            color: "#FF1F8E" },
  { label: "Fiestas Infantiles", href: "/fiestas-infantiles/",   color: "#1565C0" },
  { label: "Servicios",          href: "/servicios/",            color: "#FF8C00" },
  { label: "Precios",            href: "/precios/",              color: "#5C35B1" },
  { label: "Cobertura",          href: "/cobertura/",            color: "#D32F2F" },
  { label: "Cerca de mí",        href: "/renta-de-inflables-cerca-de-mi/", color: "#00796B" },
  { label: "Blog",               href: "/blog/",                 color: "#00ACC1" },
  { label: "FAQ",                href: "/preguntas-frecuentes/", color: "#2E7D32" },
];

const SERVICIOS: Link[] = [
  { label: "Inflables",   href: "/servicios/renta-de-inflables/",    color: "#FF3D00" },
  { label: "Paquetes",    href: "/servicios/paquetes-de-fiesta/",    color: "#2E7D32" },
  { label: "Eventos",     href: "/servicios/inflables-para-eventos/", color: "#1565C0" },
  { label: "Mobiliario",  href: "/servicios/mobiliario-para-fiestas/", color: "#5C35B1" },
  { label: "Iluminación", href: "/servicios/iluminacion-eventos/",   color: "#FF8C00" },
  { label: "Cotizar",     href: "/cotizar/",                         color: "#25D366" },
];

const INFLABLES: Link[] = [
  { label: "Dragones",  href: "/inflables/dragones-rojos/",     color: "#D32F2F" },
  { label: "Princesas", href: "/inflables/castillo-princesas/", color: "#DF1C86" },
  { label: "Pirata",    href: "/inflables/barco-pirata/",       color: "#1565C0" },
  { label: "Extremo",   href: "/inflables/extremo/",            color: "#E65100" },
  { label: "Blanco",    href: "/inflables/castillo-blanco/",    color: "#7E57C2" },
  { label: "Catálogo",  href: "/inflables/",                    color: "#FF3D00" },
];

const COBERTURA: Link[] = [
  { label: "Coyoacán",      href: "/cobertura/coyoacan/",      color: "#FF1F8E" },
  { label: "Benito Juárez", href: "/cobertura/benito-juarez/", color: "#FF8C00" },
  { label: "Iztapalapa",    href: "/cobertura/iztapalapa/",    color: "#5C35B1" },
  { label: "Naucalpan",     href: "/cobertura/naucalpan/",     color: "#D32F2F" },
  { label: "Tlalpan",       href: "/cobertura/tlalpan/",       color: "#00ACC1" },
  { label: "Todas las zonas",     href: "/cobertura/",               color: "#2E7D32" },
];

let links = Astro.props.links;
if (!links) {
  if (current.startsWith("/servicios")) links = SERVICIOS;
  else if (current.startsWith("/inflables")) links = INFLABLES;
  else if (current.startsWith("/cobertura")) links = COBERTURA;
  else links = MAIN;
}

/* Contraste automático del texto (WCAG 2.1 AA): textOn() elige blanco u
   oscuro según la luminancia del fondo, así cada color conserva su
   saturación y el texto siempre cumple 4.5:1. Ver src/lib/contrast.ts. */
const cols = links.length % 4 === 0 ? 4 : 3; // columnas en tablet (filas parejas)
---

<nav class="qnav" aria-label="Navegación rápida" style={`--cols:${cols}`}>
  {links.map(l => {
    const active = current === l.href;
    return (
      <a
        href={l.href}
        class="qnav__item"
        style={`--bg:${l.color};--fg:${textOn(l.color)}`}
        aria-current={active ? "page" : undefined}
      >
        {l.label}
      </a>
    );
  })}
</nav>

<style is:global>
/* QuickNav — barra de ancho completo (oct 2026).
   Bloques de color sólido, uno por categoría, que reparten todo el ancho
   del navegador sin huecos. Texto en Outfit 800 con contraste calculado
   por textOn(). Hover: el bloque se intensifica y aparece la barra
   inferior; página actual: barra inferior fija y texto en 900.
   Sin animaciones de entrada (regla del proyecto). El color y el texto
   llegan por --bg y --fg (inline desde el componente). */
.qnav {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  background: #fff;
  box-shadow: 0 6px 16px -8px rgba(16, 24, 40, 0.25);
  position: relative;
  z-index: 1;
}
.qnav__item {
  position: relative;
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 64px;
  padding: 0.85rem 0.75rem;
  background: var(--bg, var(--c-primary, #FF3D00));
  color: var(--fg, #fff);
  font-family: var(--font-head, sans-serif);
  font-weight: 800;
  font-size: 0.98rem;
  line-height: 1.2;
  letter-spacing: 0.01em;
  text-decoration: none !important;
  text-wrap: balance;
  box-shadow: inset -1px -1px 0 rgba(255, 255, 255, 0.35);
  transition: filter .15s ease;
}
.qnav__item::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 0;
  background: var(--fg, #fff);
  opacity: 0.9;
  transition: height .15s ease;
}
.qnav__item:hover { filter: brightness(1.1) saturate(1.1); }
.qnav__item:hover::after { height: 5px; }
.qnav__item:focus-visible {
  outline: 3px solid var(--c-secondary, #1A1A2E);
  outline-offset: -3px;
}
.qnav__item[aria-current="page"] { font-weight: 900; }
.qnav__item[aria-current="page"]::after { height: 5px; }

@media (max-width: 1100px) {
  .qnav__item { flex: 1 1 calc(100% / var(--cols, 4)); min-height: 58px; font-size: 0.95rem; }
}
@media (max-width: 560px) {
  .qnav__item { flex: 1 1 50%; min-height: 52px; font-size: 0.9rem; padding: 0.7rem 0.6rem; }
}
</style>
