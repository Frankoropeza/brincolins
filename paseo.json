{
  "worktree": {
    "setup": "npm ci",
    "servicePorts": { "range": "4300-4999" }
  },
  "scripts": {
    "dev": { "type": "service", "command": "npm run dev -- --host 127.0.0.1 --port $PASEO_PORT" },
    "preview": { "type": "service", "command": "npm run build && npm run preview -- --host 127.0.0.1 --port $PASEO_PORT" },
    "check": { "command": "npm run check" },
    "qa": { "command": "npm run qa" }
  }
}
